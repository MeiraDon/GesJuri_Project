@page "/Account/Login"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using GesCPSI_Project.Models
@inject SignInManager<UserModel> SignInManager
@inject UserManager<UserModel> UserManager
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@attribute [AllowAnonymous]

<div class="auth-transition-page">
    <div class="auth-transition-bg"></div>
    <div class="auth-transition-card">
        <div class="auth-transition-logo">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <div class="auth-transition-spinner">
            <div class="spinner-ring"></div>
            <div class="spinner-ring spinner-ring-delay"></div>
        </div>
        <h2 class="auth-transition-title">Connexion en cours</h2>
        <p class="auth-transition-sub">Vérification de vos identifiants...</p>
        <div class="auth-transition-bank">
            <span class="bank-dot"></span>
            <span>GesCPSI · BOA-TOGO</span>
        </div>
    </div>
</div>

<style>
    .auth-transition-page {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #0A2922 0%, #0E7C5C 60%, #14A574 100%);
        position: relative;
        overflow: hidden;
        font-family: 'Inter', sans-serif;
    }

    .auth-transition-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(700px 350px at 90% 20%, rgba(252, 211, 77, 0.15), transparent 60%), radial-gradient(500px 280px at 10% 90%, rgba(20, 165, 116, 0.3), transparent 65%);
        pointer-events: none;
    }

    .auth-transition-card {
        background: white;
        padding: 48px 56px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 25px 60px rgba(10, 41, 34, 0.4);
        position: relative;
        z-index: 1;
        min-width: 360px;
        animation: card-appear 0.5s ease-out;
    }

    @@keyframes card-appear {
        from {
            opacity: 0;
            transform: translateY(10px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .auth-transition-logo {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        border-radius: 16px;
        background: linear-gradient(135deg, #0E7C5C, #14A574);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #FCD34D;
        font-size: 1.8rem;
        box-shadow: 0 8px 20px rgba(14, 124, 92, 0.35);
    }

    .auth-transition-spinner {
        position: relative;
        width: 56px;
        height: 56px;
        margin: 0 auto 22px;
    }

    .spinner-ring {
        position: absolute;
        inset: 0;
        border: 3px solid transparent;
        border-top-color: #14A574;
        border-right-color: #14A574;
        border-radius: 50%;
        animation: ring-spin 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    }

    .spinner-ring-delay {
        border-top-color: #FCD34D;
        border-right-color: #FCD34D;
        opacity: 0.5;
        animation-delay: -0.6s;
        animation-duration: 1.8s;
    }

    @@keyframes ring-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .auth-transition-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: #0A2540;
        margin: 0 0 6px;
        letter-spacing: -0.3px;
    }

    .auth-transition-sub {
        color: #5E6B7D;
        font-size: 0.9rem;
        font-weight: 500;
        margin: 0 0 22px;
    }

    .auth-transition-bank {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #F8FAFC;
        border: 1px solid #E5E7EB;
        padding: 7px 14px;
        border-radius: 20px;
        color: #475569;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.6px;
    }

    .bank-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #14A574;
        box-shadow: 0 0 8px rgba(20, 165, 116, 0.6);
        animation: bank-pulse 1.6s ease-in-out infinite;
    }

    @@keyframes bank-pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.5;
            transform: scale(1.3);
        }
    }
</style>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Password { get; set; }
    [SupplyParameterFromQuery] public bool RememberMe { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is null)
        {
            Navigation.NavigateTo("/login?error=httpContext", forceLoad: true);
            return;
        }
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        {
            Navigation.NavigateTo("/login?error=missing", forceLoad: true);
            return;
        }
        var user = await UserManager.FindByEmailAsync(Email);
        if (user is null || !user.IsActive)
        {
            Navigation.NavigateTo("/login?error=invalid", forceLoad: true);
            return;
        }
        var result = await SignInManager.PasswordSignInAsync(
            user.UserName!, Password, RememberMe, lockoutOnFailure: true);
        if (result.IsLockedOut)
        {
            Navigation.NavigateTo("/login?error=lockout", forceLoad: true);
            return;
        }
        if (!result.Succeeded)
        {
            Navigation.NavigateTo("/login?error=invalid", forceLoad: true);
            return;
        }

        user.DerniereConnexion = DateTime.UtcNow;
        await UserManager.UpdateAsync(user);

        if (user.MustChangePassword)
        {
            Navigation.NavigateTo("/change-password", forceLoad: true);
        }
        else
        {
            string target = "/";
            if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                if (ReturnUrl.StartsWith("/"))
                {
                    target = ReturnUrl;
                }
                else if (ReturnUrl.StartsWith("http"))
                {
                    try
                    {
                        var uri = new Uri(ReturnUrl);
                        target = uri.PathAndQuery;
                    }
                    catch
                    {
                        target = "/";
                    }
                }
                else
                {
                    target = "/" + ReturnUrl;
                }
            }
            Navigation.NavigateTo(target, forceLoad: true);
        }
    }
}