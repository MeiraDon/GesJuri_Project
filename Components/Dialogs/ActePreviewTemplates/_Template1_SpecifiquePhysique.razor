@using GesCPSI_Project.Reports
@using static GesCPSI_Project.Components.Dialogs.ActePreviewTemplates.ActePreviewHelpers

<div class="acte-document">

    <div id="acte-print-area" class="acte-document">

        @* ============= EN-TÊTE OFFICIEL ============= *@
        <header class="acte-header">
            <div class="acte-bank-block">
                <div class="acte-bank-name">@Data.BanqueReportNomRaisonSocialBnq</div>
                @if (!string.IsNullOrWhiteSpace(Data.BanqueReportSigleBnq))
                {
                    <div class="acte-bank-sigle">@Data.BanqueReportSigleBnq</div>
                }
                <div class="acte-bank-meta">
                    @Data.BanqueReportFormeJuridique
                    @if (!string.IsNullOrWhiteSpace(Data.BanqueReportCapitalSocial))
                    {
                        <span> au capital de @Data.BanqueReportCapitalSocial FCFA</span>
                    }
                </div>
                <div class="acte-bank-meta">
                    Siège social : @Data.BanqueReportSiegeSocial
                </div>
                <div class="acte-bank-meta">
                    RCCM : @Data.BanqueReportRegistreCommerce — SWIFT : @Data.BanqueReportSwift
                </div>
            </div>
        </header>

        @* ============= TITRE PRINCIPAL ============= *@
        <h1 class="acte-title">
            ACTE DE CAUTIONNEMENT PERSONNEL,<br />
            SOLIDAIRE ET INDIVISIBLE
        </h1>
        <div class="acte-subtitle">
            – ENGAGEMENT SPÉCIFIQUE – PERSONNE PHYSIQUE –
        </div>
        <div class="acte-ref">
            N° @Data.CautionnementReportNumeroCautionmt
        </div>

        @* ============= ENTRE LES SOUSSIGNÉS ============= *@
        <h2 class="acte-section-title">ENTRE LES SOUSSIGNÉS :</h2>

        @* --- La Caution (avec détails mariage complets + Annexe 1) --- *@
        <p class="acte-para">
            <strong>1. M @Data.CautionReportNomComplet</strong>,
            né(e) le @FormatDate(Data.CautionReportDateNaiss)
            à @Data.CautionReportLieuNaiss (@Data.CautionReportPaysNaiss),
            de nationalité @Data.CautionReportNationalite,
            @Data.CautionReportProfessionClt,
            demeurant à @Data.CautionReportAdressecomplet
            (@Data.CautionReportVilleCommune, @Data.CautionReportPaysResidn),
            BP @Data.CautionReportBPClt,
            Tél. Bur : @Data.CautionReportTelBur,
            Cell. : @Data.CautionReportTelCel,
            Dom. : @Data.CautionReportTelDom,
            @FormatSituationDetaillee(
                     Data.CautionReportSituationMatrim,
                     Data.CautionReportNomConjoint,
                     Data.CautionReportDateMariage,
                     Data.CautionReportLieuMariage,
                     Data.CautionReportRegimeMatrim),
            titulaire de la pièce d'identité <strong>@Data.CautionReportTypePieceID</strong>
            n° <strong>@Data.CautionReportNumPieceID</strong>
            délivrée le @FormatDate(Data.CautionReportDateDelivPiece)
            à @Data.CautionReportLieuDelivPiece
            par @Data.CautionReportPersonDelivPiece,
            <em>et dont copie constitue l'Annexe 1 ci-jointe</em>,
            ci-après dénommé(e) « <strong>la Caution</strong> »,
        </p>

        <p class="acte-para acte-para-spaced">D'UNE PART,</p>

        <p class="acte-para">ET</p>

        @* --- La Banque --- *@
        <p class="acte-para">
            <strong>2. @Data.BanqueReportNomRaisonSocialBnq</strong>
            (@Data.BanqueReportSigleBnq),
            @Data.BanqueReportFormeJuridique au capital de @Data.BanqueReportCapitalSocial FCFA,
            dont le siège social est sis à @Data.BanqueReportSiegeSocial,
            immatriculée au RCCM sous le numéro @Data.BanqueReportRegistreCommerce,
            code SWIFT @Data.BanqueReportSwift,
            représentée par <strong>@Data.BanqueReportRepresentantBnq</strong>,
            en sa qualité de @Data.BanqueReportFonctionRepresentant,
            dûment habilité(e) à l'effet des présentes,
            ci-après dénommée « <strong>la Banque</strong> » ou « <strong>BOA-TOGO</strong> »
            ou « <strong>le Bénéficiaire</strong> »,
        </p>

        <p class="acte-para acte-para-spaced">D'AUTRE PART,</p>

        @* --- Mention conjointe --- *@
        <p class="acte-para acte-para-italic">
            La Caution et la BOA-TOGO étant ci-après dénommées, (i) ensemble, les « Parties », ou,
            (ii) séparément, chaque « Partie », ou, individuellement, comme susmentionné ;
        </p>

        <p class="acte-para acte-para-italic">
            Il convient de noter que si cette transaction nécessite la présence de tiers
            pour assister la caution, en vue d'une meilleure compréhension du contrat,
            l'identité de ces tiers sera présentée en Annexe 2.
        </p>

        @* ============= PRÉAMBULE ============= *@
        <h2 class="acte-section-title">Préambule</h2>

        <p class="acte-para">
            <strong>M @Data.DebiteurReportNomComplet</strong>,
            né(e) le @FormatDate(Data.DebiteurReportDateNaiss)
            à @Data.DebiteurReportLieuNaiss (@Data.DebiteurReportPaysNaiss),
            de nationalité @Data.DebiteurReportNationalite,
            @Data.DebiteurReportProfessionClt,
            demeurant à @Data.DebiteurReportAdressecomplet
            (@Data.DebiteurReportVilleCommune, @Data.DebiteurReportPaysResidn),
            BP @Data.DebiteurReportBPClt,
            Tél. Bur : @Data.DebiteurReportTelBur,
            Cell. : @Data.DebiteurReportTelCel,
            Dom. : @Data.DebiteurReportTelDom,
            @FormatSituationDetaillee(
                     Data.DebiteurReportSituationMatrim,
                     Data.DebiteurReportNomConjoint,
                     Data.DebiteurReportDateMariage,
                     Data.DebiteurReportLieuMariage,
                     Data.DebiteurReportRegimeMatrim),
            titulaire de la pièce d'identité <strong>@Data.DebiteurReportTypePieceID</strong>
            n° <strong>@Data.DebiteurReportNumPieceID</strong>
            délivrée le @FormatDate(Data.DebiteurReportDateDelivPiece)
            à @Data.DebiteurReportLieuDelivPiece
            par @Data.DebiteurReportPersonDelivPiece,
            <em>dont la copie constitue l'Annexe 3 ci-jointe</em>,
            ci-après indifféremment dénommé(e) « <strong>le Débiteur Cautionné</strong> »
            ou « <strong>le Débiteur Principal</strong> »,
            a sollicité et obtenu de la Banque un concours (ci-dessous dénommé le « <strong>Prêt</strong> »
            ou le « <strong>Concours</strong> »)
            @if (!string.IsNullOrWhiteSpace(Data.PretReportReferenceConvention))
            {
                <span>
                    suivant convention de prêt référencée <strong>@Data.PretReportReferenceConvention</strong>
                    en date du @FormatDate(Data.PretReportDateSignaturePret)
                    (<em>cf. Convention jointe en Annexe 4</em>),
                </span>
            }
            présentant les caractéristiques suivantes :
        </p>

        @* === Tableau des caractéristiques du Prêt === *@
        <div class="acte-pret-table">
            <div class="acte-pret-row">
                <span class="acte-pret-label">Montant du concours :</span>
                <span class="acte-pret-value">
                    <strong>@FormatMontant(Data.PretReportMontantConcours) FCFA</strong>
                    (@Data.PretReportMontantLettrePret)
                </span>
            </div>
            <div class="acte-pret-row">
                <span class="acte-pret-label">Taux :</span>
                <span class="acte-pret-value">@Data.PretReportTaux %</span>
            </div>
            <div class="acte-pret-row">
                <span class="acte-pret-label">Durée :</span>
                <span class="acte-pret-value">@Data.PretReportDureMoisPret mois</span>
            </div>
            <div class="acte-pret-row">
                <span class="acte-pret-label">Objet :</span>
                <span class="acte-pret-value">@Data.PretReportObjetPret</span>
            </div>
            <div class="acte-pret-row">
                <span class="acte-pret-label">Date 1ère échéance :</span>
                <span class="acte-pret-value">
                    @FormatDate(Data.PretReportDatePremiereEcheance)
                </span>
                <span class="acte-pret-label">Montant 1ère échéance :</span>
                <span class="acte-pret-value">
                    @FormatMontant(Data.PretReportMontantPremiereEcheance) FCFA
                </span>
            </div>
            <div class="acte-pret-row">
                <span class="acte-pret-label">Date dernière échéance :</span>
                <span class="acte-pret-value">
                    @FormatDate(Data.PretReportDateDerniereEcheance)
                </span>
                <span class="acte-pret-label">Montant dernière échéance :</span>
                <span class="acte-pret-value">
                    @FormatMontant(Data.PretReportMontantDerniereEcheance) FCFA
                </span>
            </div>
        </div>

        <p class="acte-para">
            En garantie du remboursement intégral des sommes susceptibles d'être dues à la Banque,
            en principal, intérêts, frais, commissions, taxes et autres accessoires au titre du Concours,
            la Banque a souhaité bénéficier d'un cautionnement personnel et solidaire de
            <strong>M @Data.CautionReportNomComplet</strong>,
            @Data.CautionReportProfessionClt,
            à hauteur de la somme maximale de
            <strong>@FormatMontant(Data.CautionnementReportMontantCautionne) FCFA</strong>
            (@Data.CautionnementReportMontantLettreCautionmt)
            y compris le principal, les intérêts, commissions, frais, taxes et autres accessoires
            (le « <strong>Montant Cautionné</strong> »).
        </p>

        @* ============= CECI EXPOSÉ ============= *@
        <h2 class="acte-section-title">CECI EXPOSÉ, IL EST ARRÊTÉ ET CONVENU CE QUI SUIT :</h2>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 1 :</strong> L'exposé préalable ci-dessus et les Annexes ci-jointes
                ont la même valeur juridique que le présent cautionnement personnel, solidaire et indivisible
                (le « <strong>Cautionnement</strong> ») dont ils font partie intégrante et avec lequel ils font corps.
            </p>
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 2 :</strong> La Caution déclare qu'elle a parfaite connaissance des termes
                et conditions du Concours consenti par la Banque au Débiteur Cautionné et qu'elle connaît
                également la situation financière et juridique du Débiteur Cautionné à la date de signature
                des présentes. En conséquence, elle se déclare et se constitue caution personnelle, solidaire
                et indivisible du Débiteur Cautionné, en garantie du remboursement ou du paiement de toutes
                les sommes qui pourraient être dues par le Débiteur Cautionné à la Banque au titre du Concours.
            </p>
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 3 :</strong> Les engagements et obligations de la Caution au titre du Cautionnement
                sont expressément limités au Montant Cautionné, à savoir la somme maximale en principal, intérêts,
                commissions, frais, taxes et autres accessoires, y compris les frais de recouvrement de créance, de
                <strong>@FormatMontant(Data.CautionnementReportMontantCautionne) FCFA</strong>
                (@Data.CautionnementReportMontantLettreCautionmt) de Francs CFA,
                en garantie de toutes les sommes que le Débiteur Cautionné pourrait devoir à la Banque
                au titre du Concours.
            </p>
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 4 :</strong> Le présent contrat de cautionnement prend effet à compter du
                <strong>@FormatDate(Data.CautionnementReportDateEffetCautionmt)</strong>
                et reste valable jusqu'au remboursement intégral à la Banque de l'ensemble des sommes
                qui lui sont dues par le Débiteur Cautionné au titre du Concours, soit au plus tard le
                <strong>@FormatDate(Data.CautionnementReportDateExpirationCautionmt)</strong>.
                Il peut être révoqué à tout moment par la caution avant que la somme maximale garantie ait été
                atteinte. Dans cette hypothèse, il est expressément stipulé que tous les engagements du Débiteur
                Cautionné, nés avant la révocation, resteront cependant garantis par la Caution.
                La révocation n'emporte décharge de la Caution que par le paiement, dans la limite du
                Montant Cautionné, de toutes les sommes que le Débiteur Cautionné pourrait devoir à la Banque
                au titre du Concours, à la date d'effet de la révocation du Cautionnement et de la Caution
                Solidaire qu'il institue.
            </p>
            <p class="acte-para">
                Si, en raison de cette révocation, la Banque décidait de réduire ou d'interrompre le Concours
                consenti au Débiteur Cautionné et d'en demander le remboursement, elle devrait respecter un délai
                de préavis conforme à celui prévu dans la convention de Prêt, à charge pour elle de notifier
                sa décision au Débiteur Cautionné et à la Caution.
            </p>
            @if (!string.IsNullOrWhiteSpace(Data.CautionnementReportConditionsRevocationCautionmt))
            {
                <p class="acte-para"><em>@Data.CautionnementReportConditionsRevocationCautionmt</em></p>
            }
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 5 :</strong> La Banque est tenue dans le mois qui suit le terme de chaque
                semestre civil à compter de la signature du contrat de cautionnement, de communiquer à la caution,
                un état de la dette du Débiteur Principal, précisant sa cause, ses échéances et son montant
                en principal, intérêts et autres accessoires restant dus à la fin du semestre écoulé,
                en lui rappelant la faculté de révocation par reproduction littérale des dispositions de l'article 19
                du présent Acte Uniforme. À défaut d'accomplissement des formalités prévues, la Banque est déchue
                vis-à-vis de la Caution des intérêts contractuels échus depuis la date de la précédente information
                jusqu'à la date de communication de la nouvelle information.
            </p>
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 6 :</strong> La Banque est tenue de notifier à la Caution toute prorogation
                conventionnelle du terme du Concours, de même que l'octroi de facilités de paiement au
                Débiteur Cautionné, qui profiteront à la Caution si celle-ci y acquiesce formellement.
                Par contre, la Caution ne pourra pas se prévaloir des délais de paiement accordés judiciairement
                au Débiteur Cautionné.
            </p>
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 7 :</strong> La Banque est tenue d'informer la Caution de toute défaillance
                du Débiteur Cautionné au titre du Concours, ainsi que de la déchéance ou de la prorogation
                du terme du Concours, et, en ce cas, du montant restant dû au Bénéficiaire par le
                Débiteur Cautionné, au jour de la défaillance, de la déchéance du terme ou de la prorogation
                du terme, en principal, intérêts, commissions, frais, taxes et autres accessoires.
            </p>
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 8 :</strong> En cas de défaillance du Débiteur Cautionné, pour quelque cause
                que ce soit, la Caution sera tenue de payer à la Banque ce que le Débiteur Cautionné lui doit
                au titre du Concours, en principal, intérêts, commissions, frais, taxes et autres accessoires,
                le tout dans la limite du Montant Cautionné et sous réserve, toutefois, que la Banque ait
                adressée préalablement une mise en demeure de payer au Débiteur Cautionné, et que celle-ci
                soit restée sans effet. Dans ce cas, la Caution s'engage à payer les sommes dues dans un délai
                maximum de trente (30) jours à compter de la première demande écrite de la Banque par lettre
                recommandée avec accusé de réception ou par acte extrajudiciaire. Le Débiteur Cautionné sera
                appelé à la cause entre la Banque et la Caution.
            </p>
            @if (!string.IsNullOrWhiteSpace(Data.CautionnementReportObligationsCaution))
            {
                <p class="acte-para"><em>@Data.CautionnementReportObligationsCaution</em></p>
            }
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 9 :</strong> Conformément aux dispositions des articles 27 et 28 de l'Acte
                Uniforme de l'OHADA portant organisation des Sûretés, la Caution Solidaire ne dispose pas
                du bénéfice de discussion et de division. En conséquence, la Banque pourra, en cas de défaillance
                du Débiteur Cautionné, et après une mise en demeure restée sans effet depuis au moins un mois,
                demander à la Caution de payer les sommes dues par le Débiteur Cautionné, dans la limite du
                Montant Cautionné, sans avoir à poursuivre préalablement ce dernier, ni à exercer préalablement
                et/ou simultanément une quelconque poursuite à l'encontre de qui que ce soit, en ce compris
                les tiers qui se seraient portés garants du Débiteur Cautionné sous quelque forme que ce soit.
            </p>
            <p class="acte-para">
                Conformément à l'article 31 de l'Acte Uniforme de l'OHADA portant organisation des Sûretés,
                la Caution sera immédiatement subrogée dans les droits de la Banque à concurrence des sommes
                qu'elle aura payées en exécution du Cautionnement. Le Débiteur Cautionné sera appelé à la cause
                entre la Banque et la Caution.
            </p>
            @if (!string.IsNullOrWhiteSpace(Data.CautionnementReportClauseSubrogation))
            {
                <p class="acte-para">@Data.CautionnementReportClauseSubrogation</p>
            }
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 10 :</strong> La preuve de l'existence des créances résultera suffisamment
                des relevés de compte établis par la Banque.
            </p>
            <p class="acte-para">
                Si la créance de la Banque sur le Débiteur Cautionné au titre du Concours qui est accordé
                par la Banque au Bénéficiaire, est supérieure au Montant Cautionné, tous paiements partiels
                effectués par le Débiteur Cautionné s'imputeront d'abord sur la partie non garantie quelle
                que soit l'origine des fonds, à moins que ceux-ci proviennent d'un paiement fait par la Caution
                en exécution des présentes.
            </p>
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 11 :</strong> Le Cautionnement et la Caution Solidaire qu'il institue
                ne font pas novation mais s'ajoutent et s'ajouteront à toutes les garanties réelles
                et/ou personnelles qui ont pu ou pourront être contractées ou fournies en faveur de la Banque,
                soit par le Débiteur Cautionné, soit par la Caution, soit par tout tiers en garantie des sommes
                restant dues.
            </p>
            @if (!string.IsNullOrWhiteSpace(Data.CautionnementReportClauseNonNovation))
            {
                <p class="acte-para">@Data.CautionnementReportClauseNonNovation</p>
            }
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 12 :</strong> Les obligations de la Caution au titre du Cautionnement,
                sont stipulées indivisibles, de telle sorte que leur exécution pourra être exigée en entier,
                à concurrence du Montant Cautionné, de n'importe lequel des héritiers, successeurs
                ou ayant droit de la Caution, sans qu'une division de ses recours puisse lui être imposée.
            </p>
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 13 :</strong> Tous droits, frais de timbres, impôts et autres frais relatifs
                au Cautionnement et à ses suites, ou pouvant résulter de leur exécution, sont à la charge
                du Débiteur Cautionné et de la Caution qui s'y obligent. En conséquence, le Débiteur Cautionné
                autorise la Banque à débiter son compte n° <strong>@Data.DebiteurReportNumCompte</strong>
                du montant des frais y afférents.
            </p>
            <p class="acte-para">
                Si la Banque consent à en faire l'avance, ils deviendront exigibles à sa première demande
                tant au Débiteur Cautionné qu'à la Caution.
            </p>
            @if (!string.IsNullOrWhiteSpace(Data.ChargeReportTypeCharge))
            {
                <p class="acte-para">
                    <em>
                        Charge appliquée : @Data.ChargeReportTypeCharge —
                        Montant : @FormatMontant(Data.ChargeReportMontantCharge) FCFA —
                        Payé par : @Data.ChargeReportPayePar.
                    </em>
                </p>
            }
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 14 :</strong> Pour l'exécution du Cautionnement et de ses suites,
                la Caution et la Banque font élection de domicile, chacune pour ce qui la concerne,
                aux adresses mentionnées en tête des présentes, où toute notification ou exécution du
                Cautionnement pourra leur être valablement faite par tout moyen laissant trace écrite
                de sa réception par le destinataire.
            </p>
            @if (!string.IsNullOrWhiteSpace(Data.CautionnementReportElectionDomicile))
            {
                <p class="acte-para">@Data.CautionnementReportElectionDomicile</p>
            }
        </article>

        <article class="acte-article">
            <p class="acte-para">
                <strong>Article 15 :</strong> Tout différend résultant de la validité, l'interprétation
                ou de l'exécution du présent acte devra au préalable faire l'objet d'un règlement à l'amiable.
            </p>
            <p class="acte-para">
                À défaut de règlement à l'amiable dans un délai de trente (30) jours, suivant la réception,
                par l'une des Parties de la demande d'un règlement amiable, émanant de l'autre Partie,
                le différend sera soumis au Tribunal de Lomé.
            </p>
            @if (!string.IsNullOrWhiteSpace(Data.CautionnementReportReglementDifferend))
            {
                <p class="acte-para">@Data.CautionnementReportReglementDifferend</p>
            }
        </article>

        @* ============= FAIT À LOMÉ ============= *@
        <p class="acte-closing">
            Fait à <strong>@Data.CautionnementReportLieuSignatureCautionmt</strong>,
            le <strong>@FormatDateLong(Data.CautionnementReportDateSignatureCautionmt)</strong>
        </p>
        <p class="acte-closing-mention">
            En trois exemplaires originaux, dont un pour l'enregistrement.
        </p>

        @* ============= MENTIONS MANUSCRITES (corrigées) ============= *@
        <div class="acte-mention-box">
            <p>
                <strong>(1)</strong> Faire précéder la signature de la Caution de la mention manuscrite :
                « <strong>Bon pour caution personnelle, solidaire et indivisible</strong> dans les termes
                ci-dessus indiqués, à concurrence du Montant Cautionné, soit la somme maximale de
                <strong>@FormatMontant(Data.CautionnementReportMontantCautionne) FCFA</strong>
                (@Data.CautionnementReportMontantLettreCautionmt) de Francs CFA
                en principal, intérêts, commissions, frais, taxes, autres accessoires et frais de recouvrement
                de créance y compris ceux postérieurs à la dénonciation ».
            </p>
            <p>
                <strong>(2)</strong> Faire précéder la signature de la Banque de la mention manuscrite :
                « <strong>Bon pour acceptation de la caution personnelle, solidaire et indivisible</strong> ».
            </p>
        </div>

        @* ============= SIGNATURES ============= *@
        <div class="acte-signatures">
            <div class="acte-signature-block">
                <div class="acte-signature-label">LA CAUTION (1)</div>
                <div class="acte-signature-name">M @Data.CautionReportNomComplet</div>
                <div class="acte-signature-line"></div>
            </div>

            <div class="acte-signature-block">
                <div class="acte-signature-label">LE BÉNÉFICIAIRE (2)</div>
                <div class="acte-signature-name">Pour @Data.BanqueReportNomRaisonSocialBnq</div>
                <div class="acte-signature-role">
                    @Data.BanqueReportRepresentantBnq<br />
                    <em>@Data.BanqueReportFonctionRepresentant</em>
                </div>
                <div class="acte-signature-line"></div>
            </div>
        </div>

        <div class="acte-collaborator">
            Signatures recueillies en présence du collaborateur BOA-TOGO,
            M. <strong>@Data.BanqueReportNomCollaborateur</strong><br />
            Visa du collaborateur BOA-TOGO : @Data.BanqueReportVisaCollaborateur
        </div>

        @* ============= TÉMOINS (page principale) ============= *@
        @if (!string.IsNullOrWhiteSpace(Data.Temoin1ReportNomComplet) || !string.IsNullOrWhiteSpace(Data.Temoin2ReportNomComplet))
        {
            <div class="acte-witnesses-mention">
                <em>
                    Faire précéder la signature des témoins de la mention :
                    « Je certifie de l'identité et de la présence de M @Data.CautionReportNomComplet
                    et atteste que la nature et les effets du présent acte lui ont été précisés ».
                </em>
            </div>

            <div class="acte-signatures acte-witnesses">
                @if (!string.IsNullOrWhiteSpace(Data.Temoin1ReportNomComplet))
                {
                    <div class="acte-signature-block">
                        <div class="acte-signature-label">LE TÉMOIN N°1</div>
                        <div class="acte-signature-name">M @Data.Temoin1ReportNomComplet</div>
                        <div class="acte-signature-line"></div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Data.Temoin2ReportNomComplet))
                {
                    <div class="acte-signature-block">
                        <div class="acte-signature-label">LE TÉMOIN N°2</div>
                        <div class="acte-signature-name">M @Data.Temoin2ReportNomComplet</div>
                        <div class="acte-signature-line"></div>
                    </div>
                }
            </div>
        }

        @* ============= ANNEXE 1 - AUTORISATION DÉBIT ============= *@
        <div class="acte-page-break"></div>
        <h2 class="acte-annexe-title">ANNEXE 1 — AUTORISATION DE DÉBIT AUTOMATIQUE</h2>

        <p class="acte-para">
            <strong>NOM :</strong> @Data.CautionReportNom<br />
            <strong>PRÉNOMS :</strong> @Data.CautionReportPrenoms<br />
            <strong>ADRESSE :</strong> @Data.CautionReportAdressecomplet
        </p>

        <p class="acte-para">
            À la garantie du concours que vous avez consenti à M <strong>@Data.DebiteurReportNomComplet</strong>,
            d'un montant de <strong>@FormatMontant(Data.PretReportMontantConcours) FCFA</strong>
            (@Data.PretReportMontantLettrePret),
            remboursable en @Data.PretReportDureMoisPret mois,
            du @FormatDate(Data.PretReportDatePremiereEcheance)
            au @FormatDate(Data.PretReportDateDerniereEcheance),
            j'ai contracté à l'égard de la BANK OF AFRICA - TOGO un engagement de caution solidaire
            et indivisible suivant acte du
            <strong>@FormatDate(Data.CautionnementReportDateSignatureCautionmt)</strong>.
        </p>

        <p class="acte-para">
            En vertu de cet engagement, je vous autorise dès à présent, en cas d'impayé de remboursement
            dudit prêt, à débiter mon compte n° <strong>@Data.CautionReportNumCompte</strong>
            du montant des impayés constatés.
        </p>

        <p class="acte-para">
            J'ai eu parfaitement connaissance des conditions générales du prêt accordé à
            M <strong>@Data.DebiteurReportNomComplet</strong>,
            et notamment de la convention de déchéance de terme qui peut être mise à exécution
            en cas de non règlement ponctuel d'une échéance du crédit que je cautionne.
        </p>

        <p class="acte-para">
            Veuillez agréer, Monsieur le Directeur Général, l'expression de mes salutations distinguées.
        </p>

        <p class="acte-closing">
            Fait à <strong>@Data.CautionnementReportLieuSignatureCautionmt</strong>,
            le <strong>@FormatDateLong(Data.CautionnementReportDateSignatureCautionmt)</strong>
        </p>

        <div class="acte-signatures">
            <div class="acte-signature-block">
                <div class="acte-signature-label">LA CAUTION</div>
                <div class="acte-signature-name">M @Data.CautionReportNomComplet</div>
                <div class="acte-signature-line"></div>
            </div>
        </div>

        @* ============= ANNEXE 2 - IDENTIFICATION DES TIERS ============= *@
        @if (!string.IsNullOrWhiteSpace(Data.Temoin1ReportNomComplet))
        {
            <div class="acte-page-break"></div>
            <h2 class="acte-annexe-title">ANNEXE 2 — IDENTIFICATION DES TIERS</h2>

            <p class="acte-para">
                <strong>M @Data.Temoin1ReportNomComplet</strong>,
                né(e) le @FormatDate(Data.Temoin1ReportDateNaiss)
                à @Data.Temoin1ReportLieuNaiss (@Data.Temoin1ReportPaysNaiss),
                de nationalité @Data.Temoin1ReportNationalite,
                @Data.Temoin1ReportProfessionClt,
                demeurant à @Data.Temoin1ReportAdressecomplet
                (@Data.Temoin1ReportVilleCommune, @Data.Temoin1ReportPaysResidn),
                BP @Data.Temoin1ReportBPClt,
                Tél. Bur : @Data.Temoin1ReportTelBur,
                Cell. : @Data.Temoin1ReportTelCel,
                Dom. : @Data.Temoin1ReportTelDom,
                @FormatSituationDetaillee(
                         Data.Temoin1ReportSituationMatrim,
                         Data.Temoin1ReportNomConjoint,
                         Data.Temoin1ReportDateMariage,
                         Data.Temoin1ReportLieuMariage,
                         Data.Temoin1ReportRegimeMatrim),
                titulaire de la pièce <strong>@Data.Temoin1ReportTypePieceID</strong>
                n° <strong>@Data.Temoin1ReportNumPieceID</strong>
                délivrée le @FormatDate(Data.Temoin1ReportDateDelivPiece)
                par @Data.Temoin1ReportPersonDelivPiece.
            </p>

            <p class="acte-para acte-para-italic">
                <strong>Agissant ou intervenant en qualité de témoin N°1.</strong>
            </p>

            @if (!string.IsNullOrWhiteSpace(Data.Temoin2ReportNomComplet))
            {
                <p class="acte-para">
                    <strong>M @Data.Temoin2ReportNomComplet</strong>,
                    né(e) le @FormatDate(Data.Temoin2ReportDateNaiss)
                    à @Data.Temoin2ReportLieuNaiss (@Data.Temoin2ReportPaysNaiss),
                    de nationalité @Data.Temoin2ReportNationalite,
                    @Data.Temoin2ReportProfessionClt,
                    demeurant à @Data.Temoin2ReportAdressecomplet
                    (@Data.Temoin2ReportVilleCommune, @Data.Temoin2ReportPaysResidn),
                    BP @Data.Temoin2ReportBPClt,
                    Tél. Bur : @Data.Temoin2ReportTelBur,
                    Cell. : @Data.Temoin2ReportTelCel,
                    Dom. : @Data.Temoin2ReportTelDom,
                    @FormatSituationDetaillee(
                             Data.Temoin2ReportSituationMatrim,
                             Data.Temoin2ReportNomConjoint,
                             Data.Temoin2ReportDateMariage,
                             Data.Temoin2ReportLieuMariage,
                             Data.Temoin2ReportRegimeMatrim),
                    titulaire de la pièce <strong>@Data.Temoin2ReportTypePieceID</strong>
                    n° <strong>@Data.Temoin2ReportNumPieceID</strong>
                    délivrée le @FormatDate(Data.Temoin2ReportDateDelivPiece)
                    par @Data.Temoin2ReportPersonDelivPiece.
                </p>

                <p class="acte-para acte-para-italic">
                    <strong>Agissant ou intervenant en qualité de témoin N°2.</strong>
                </p>
            }

            @* === Signatures des témoins en bas de l'annexe === *@
            <div class="acte-signatures acte-witnesses">
                @if (!string.IsNullOrWhiteSpace(Data.Temoin1ReportNomComplet))
                {
                    <div class="acte-signature-block">
                        <div class="acte-signature-label">LE TÉMOIN N°1</div>
                        <div class="acte-signature-name">M @Data.Temoin1ReportNomComplet</div>
                        <div class="acte-signature-line"></div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Data.Temoin2ReportNomComplet))
                {
                    <div class="acte-signature-block">
                        <div class="acte-signature-label">LE TÉMOIN N°2</div>
                        <div class="acte-signature-name">M @Data.Temoin2ReportNomComplet</div>
                        <div class="acte-signature-line"></div>
                    </div>
                }
            </div>

            <div class="acte-collaborator">
                Signatures recueillies en présence du collaborateur BOA-TOGO,
                M. <strong>@Data.BanqueReportNomCollaborateur</strong><br />
                Visa du collaborateur BOA-TOGO : @Data.BanqueReportVisaCollaborateur
            </div>
        }

        @* ============= LETTRE HUISSIER ============= *@
        @if (!string.IsNullOrWhiteSpace(Data.EntiteJuridiqueReportNomHuissier))
        {
            <div class="acte-page-break"></div>
            <div class="acte-letter">
                <div class="acte-letter-header">
                    <div>Lomé, le @FormatDateLong(Data.EntiteJuridiqueReportDateActeJuridique)</div>
                    <div>Direction Juridique</div>
                    <div>N/Réf. : @Data.EntiteJuridiqueReportReference</div>
                </div>

                <div class="acte-letter-recipient">
                    <strong>Maître @Data.EntiteJuridiqueReportNomHuissier</strong><br />
                    Huissier de Justice<br />
                    @Data.EntiteJuridiqueReportVilleHuissier
                </div>

                <p class="acte-para">
                    <strong>Objet :</strong> Cautionnement personnel, solidaire et indivisible<br />
                    <strong>Dossier :</strong> @Data.EntiteJuridiqueReportNumeroDossier —
                    @Data.EntiteJuridiqueReportNomDossier
                </p>

                <p class="acte-para">Cher Maître,</p>

                <p class="acte-para">Nous vous remettons ci-joint :</p>

                <ul class="acte-list">
                    <li>
                        Copie du contrat de prêt signé entre M @Data.DebiteurReportNomComplet
                        et nous-mêmes le @FormatDate(Data.PretReportDateSignaturePret)
                        pour un montant de @FormatMontant(Data.PretReportMontantConcours) FCFA
                        (« <strong>Montant</strong> ») ;
                    </li>
                    <li>
                        Un exemplaire de l'acte de cautionnement à notre profit à hauteur de
                        @FormatMontant(Data.CautionnementReportMontantCautionne) FCFA
                        (« <strong>Montant cautionné</strong> ») par notre relation.
                    </li>
                </ul>

                <p class="acte-para">
                    Nous vous prions de bien vouloir, procéder conformément aux articles 51 et suivants
                    de l'acte uniforme portant organisation des sûretés de l'OHADA à l'enregistrement
                    de l'acte de cautionnement auprès de l'Office Togolais des Recettes.
                </p>

                <p class="acte-para">
                    Votre intervention accomplie, vous voudrez bien nous faire parvenir un exemplaire
                    de votre exploit accompagné des documents requis.
                </p>

                <p class="acte-para">
                    Nous vous remercions pour votre collaboration et vous prions d'agréer, Cher Maître,
                    l'expression de nos sentiments distingués.
                </p>

                <p class="acte-letter-signature">
                    <strong>@Data.EntiteJuridiqueReportResponsable</strong><br />
                    <em>@Data.EntiteJuridiqueReportFonctionResponsable</em>
                </p>
            </div>
        }

        @* ============= FOOTER ============= *@
        <footer class="acte-footer">
            <div>Document généré le @DateTime.Now.ToString("dd/MM/yyyy à HH:mm")</div>
            <div class="acte-watermark">APERÇU — Document non officiel</div>
        </footer>
    </div>

</div>

@code {
    [Parameter, EditorRequired]
    public ActCautionnementReportModel Data { get; set; } = default!;
}

<style>
    /* Tableau caractéristiques du Prêt */
    .acte-pret-table {
        margin: 12px 0 18px 0;
        padding: 12px 16px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 6px;
        border-left: 3px solid #0E7C5C;
    }

    .acte-pret-row {
        display: grid;
        grid-template-columns: 200px 1fr 200px 1fr;
        gap: 8px 16px;
        margin: 6px 0;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .acte-pret-label {
        font-weight: 600;
        color: #475569;
    }

    .acte-pret-value {
        color: #0A2540;
    }

    /* Première ligne avec seulement 2 colonnes */
    .acte-pret-row:nth-child(-n+4) {
        grid-template-columns: 200px 1fr;
    }
</style>