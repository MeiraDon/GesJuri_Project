@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using GesCPSI_Project.ViewModels

<div class="client-form-sections">

    <!-- ════════════ SECTION 1 : TYPE DE CLIENT (toujours visible) ════════════ -->
    <div class="form-section form-section-type">
        <div class="section-header">
            <div class="section-icon section-icon-blue">
                <i class="bi bi-diagram-3-fill"></i>
            </div>
            <div class="section-title-wrap">
                <h3 class="section-title">Type de client</h3>
                <p class="section-subtitle">Sélectionnez d'abord le type pour adapter le formulaire</p>
            </div>
        </div>

        <div class="section-body">
            <div class="type-client-radios">
                <label class="type-radio @(Model.TypeClient == "Personne Physique" ? "active" : "")">
                    <input type="radio" name="typeClient" value="Personne Physique"
                           checked="@(Model.TypeClient == "Personne Physique")"
                           @onchange="@(() => SelectTypeClient("Personne Physique"))" />
                    <div class="type-radio-content">
                        <i class="bi bi-person-fill"></i>
                        <div>
                            <div class="type-radio-title">Personne Physique</div>
                            <div class="type-radio-desc">Particulier individuel</div>
                        </div>
                    </div>
                </label>

                <label class="type-radio @(Model.TypeClient == "Personne Morale" ? "active" : "")">
                    <input type="radio" name="typeClient" value="Personne Morale"
                           checked="@(Model.TypeClient == "Personne Morale")"
                           @onchange="@(() => SelectTypeClient("Personne Morale"))" />
                    <div class="type-radio-content">
                        <i class="bi bi-building-fill"></i>
                        <div>
                            <div class="type-radio-title">Personne Morale</div>
                            <div class="type-radio-desc">Société / Entreprise</div>
                        </div>
                    </div>
                </label>
            </div>
            <ValidationMessage For="@(() => Model.TypeClient)" />
        </div>
    </div>

    @if (Model.TypeClient == "Personne Morale")
    {
        <!-- ════════════ SECTION : IDENTIFICATION SOCIÉTÉ ════════════ -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon section-icon-marine">
                    <i class="bi bi-building"></i>
                </div>
                <div class="section-title-wrap">
                    <h3 class="section-title">Identification de la société</h3>
                    <p class="section-subtitle">Coordonnées juridiques et fiscales</p>
                </div>
            </div>

            <div class="section-body">
                <div class="form-grid">
                    <div class="form-field form-col-2">
                        <MudTextField @bind-Value="Model.NomRaisonsociale"
                                      Label="Raison sociale *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Nom complet de la société"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.NomRaisonsociale)" />
                    </div>

                    <div class="form-field">
                        <MudSelect T="string" @bind-Value="Model.FormeJuridique"
                                   Label="Forme juridique"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            <MudSelectItem Value="@("")">Sélectionner...</MudSelectItem>
                            <MudSelectItem Value="@("Société Anonyme (SA)")">Société Anonyme (SA)</MudSelectItem>
                            <MudSelectItem Value="@("Société à Responsabilité Limitée (SARL)")">SARL</MudSelectItem>
                            <MudSelectItem Value="@("Société par Actions Simplifiée (SAS)")">SAS</MudSelectItem>
                            <MudSelectItem Value="@("Société en Nom Collectif (SNC)")">SNC</MudSelectItem>
                            <MudSelectItem Value="@("Société en Commandite Simple (SCS)")">SCS</MudSelectItem>
                            <MudSelectItem Value="@("Groupement d'Intérêt Économique (GIE)")">GIE</MudSelectItem>
                            <MudSelectItem Value="@("Entreprise Individuelle (EI)")">Entreprise Individuelle</MudSelectItem>
                            <MudSelectItem Value="@("Autre")">Autre</MudSelectItem>
                        </MudSelect>
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.CapitalSocial"
                                      Label="Capital social (FCFA)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Ex: 10 000 000"
                                      FullWidth="true" />
                    </div>

                    <div class="form-field form-col-2">
                        <MudTextField @bind-Value="Model.SiegeSocial"
                                      Label="Siège social"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Adresse complète du siège"
                                      FullWidth="true" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.RegistreCommerce"
                                      Label="RCCM (Registre Commerce)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Ex: RCCM TG-LOM 2024 B 12345"
                                      FullWidth="true" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.NumIdentifFiscal"
                                      Label="NIF (Numéro Identifiant Fiscal)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Numéro NIF"
                                      FullWidth="true" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.NumRCCM"
                                      Label="Numéro RCCM rapide *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Référence rapide"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.NumRCCM)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.NumCompte"
                                      Label="Numéro de compte *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Numéro de compte bancaire"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.NumCompte)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ════════════ SECTION : REPRÉSENTANT LÉGAL ════════════ -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon section-icon-gold">
                    <i class="bi bi-person-badge"></i>
                </div>
                <div class="section-title-wrap">
                    <h3 class="section-title">Représentant légal</h3>
                    <p class="section-subtitle">Personne habilitée à engager la société</p>
                </div>
            </div>

            <div class="section-body">
                <div class="form-grid">
                    <div class="form-field">
                        <MudTextField @bind-Value="Model.NomRepresentant"
                                      Label="Nom du représentant légal *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="M. / Mme [Nom complet]"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.NomRepresentant)" />
                    </div>

                    <div class="form-field">
                        <MudSelect T="string" @bind-Value="Model.FonctionRepresentant"
                                   Label="Fonction"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            <MudSelectItem Value="@("")">Sélectionner...</MudSelectItem>
                            <MudSelectItem Value="@("Directeur Général")">Directeur Général (DG)</MudSelectItem>
                            <MudSelectItem Value="@("Président-Directeur Général")">PDG</MudSelectItem>
                            <MudSelectItem Value="@("Président du Conseil d'Administration")">PCA</MudSelectItem>
                            <MudSelectItem Value="@("Gérant")">Gérant</MudSelectItem>
                            <MudSelectItem Value="@("Co-Gérant")">Co-Gérant</MudSelectItem>
                            <MudSelectItem Value="@("Administrateur")">Administrateur</MudSelectItem>
                            <MudSelectItem Value="@("Mandataire")">Mandataire</MudSelectItem>
                            <MudSelectItem Value="@("Autre")">Autre</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════════════ SECTION : DÉLIBÉRATION ════════════ -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon section-icon-purple">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <div class="section-title-wrap">
                    <h3 class="section-title">Délibération autorisant l'engagement</h3>
                    <p class="section-subtitle">Référence du PV autorisant le représentant à engager la société</p>
                </div>
            </div>

            <div class="section-body">
                <div class="form-grid">
                    <div class="form-field form-col-2">
                        <MudTextField @bind-Value="Model.RefPVDelib"
                                      Label="Référence du PV"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Ex: PV du Conseil d'Administration n° 12/2025"
                                      FullWidth="true" />
                    </div>

                    <div class="form-field">
                        <MudDatePicker @bind-Date="_datePVDelib"
                                       Label="Date du PV"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.TypeClient == "Personne Physique")
    {
        <!-- ════════════ SECTION : IDENTITÉ ════════════ -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon section-icon-marine">
                    <i class="bi bi-person-vcard"></i>
                </div>
                <div class="section-title-wrap">
                    <h3 class="section-title">Identité</h3>
                    <p class="section-subtitle">Informations d'état civil</p>
                </div>
            </div>

            <div class="section-body">
                <div class="form-grid">
                    <div class="form-field">
                        <MudTextField @bind-Value="Model.Nom"
                                      Label="Nom *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.Nom)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.Prenoms"
                                      Label="Prénoms *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.Prenoms)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.NumCompte"
                                      Label="Numéro de compte *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Numéro de compte"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.NumCompte)" />
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.TypeClient))
    {
        <!-- ════════════ SECTION : NAISSANCE & NATIONALITÉ ════════════ -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon section-icon-green">
                    <i class="bi bi-globe-americas"></i>
                </div>
                <div class="section-title-wrap">
                    <h3 class="section-title">Naissance & Nationalité</h3>
                    <p class="section-subtitle">Origines et identité géographique</p>
                </div>
            </div>

            <div class="section-body">
                <div class="form-grid">
                    <div class="form-field">
                        <MudSelect T="string" @bind-Value="Model.Sexe"
                                   Label="Sexe"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            <MudSelectItem Value="@("")">Sélectionner...</MudSelectItem>
                            <MudSelectItem Value="@("Masculin")">Masculin</MudSelectItem>
                            <MudSelectItem Value="@("Féminin")">Féminin</MudSelectItem>
                        </MudSelect>
                    </div>

                    <div class="form-field">
                        <MudDatePicker @bind-Date="_dateNaiss"
                                       Label="Date de naissance *"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                        <ValidationMessage For="@(() => Model.DateNaiss)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.Nationalite"
                                      Label="Nationalité *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.Nationalite)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.PaysNaiss"
                                      Label="Pays de naissance"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.LieuNaiss"
                                      Label="Lieu de naissance *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.LieuNaiss)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.PaysResidn"
                                      Label="Pays de résidence *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.PaysResidn)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ════════════ SECTION : ADRESSE & CONTACT ════════════ -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon section-icon-orange">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div class="section-title-wrap">
                    <h3 class="section-title">Adresse & Contact</h3>
                    <p class="section-subtitle">Coordonnées de résidence et numéros de téléphone</p>
                </div>
            </div>

            <div class="section-body">
                <div class="form-grid">
                    <div class="form-field form-col-3">
                        <MudTextField @bind-Value="Model.Adressecomplet"
                                      Label="Adresse complète *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="2"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.Adressecomplet)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.VilleCommune"
                                      Label="Ville / Commune"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.VilleCommune)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.BPClt"
                                      Label="Boîte postale"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.TelCel"
                                      Label="Tél. Cellulaire *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="InputType.Telephone"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.PhoneAndroid"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.TelCel)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.TelBur"
                                      Label="Tél. Bureau"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="InputType.Telephone"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Business"
                                      FullWidth="true" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.TelDom"
                                      Label="Tél. Domicile"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="InputType.Telephone"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Home"
                                      FullWidth="true" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ════════════ SECTION : PROFESSION & FAMILLE ════════════ -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon section-icon-indigo">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
                <div class="section-title-wrap">
                    <h3 class="section-title">Profession & Situation familiale</h3>
                    <p class="section-subtitle">Activité professionnelle et statut matrimonial</p>
                </div>
            </div>

            <div class="section-body">
                <div class="form-grid">
                    <div class="form-field">
                        <MudTextField @bind-Value="Model.ProfessionClt"
                                      Label="Profession *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.ProfessionClt)" />
                    </div>

                    <div class="form-field">
                        <MudSelect T="string" @bind-Value="Model.SituationMatrim"
                                   Label="Situation matrimoniale *"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            <MudSelectItem Value="@("")">Sélectionner...</MudSelectItem>
                            <MudSelectItem Value="@("Célibataire")">Célibataire</MudSelectItem>
                            <MudSelectItem Value="@("Marié(e)")">Marié(e)</MudSelectItem>
                            <MudSelectItem Value="@("Divorcé(e)")">Divorcé(e)</MudSelectItem>
                            <MudSelectItem Value="@("Veuf(ve)")">Veuf(ve)</MudSelectItem>
                            <MudSelectItem Value="@("Séparé(e)")">Séparé(e)</MudSelectItem>
                            <MudSelectItem Value="@("Concubinage")">Concubinage</MudSelectItem>
                        </MudSelect>
                        <ValidationMessage For="@(() => Model.SituationMatrim)" />
                    </div>

                    @if (Model.SituationMatrim == "Marié(e)")
                    {
                        <div class="form-field form-col-3">
                            <div class="sub-section">
                                <div class="sub-section-title">
                                    <i class="bi bi-heart-fill"></i>
                                    Informations sur le mariage
                                </div>
                                <div class="form-grid">
                                    <div class="form-field">
                                        <MudTextField @bind-Value="Model.NomConjoint"
                                                      Label="Nom du conjoint"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      FullWidth="true" />
                                    </div>

                                    <div class="form-field">
                                        <MudDatePicker @bind-Date="_dateMariage"
                                                       Label="Date du mariage"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Clearable="true" />
                                    </div>

                                    <div class="form-field">
                                        <MudTextField @bind-Value="Model.LieuMariage"
                                                      Label="Lieu du mariage"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      FullWidth="true" />
                                    </div>

                                    <div class="form-field">
                                        <MudSelect T="string" @bind-Value="Model.RegimeMatrim"
                                                   Label="Régime matrimonial"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   FullWidth="true">
                                            <MudSelectItem Value="@("")">Sélectionner...</MudSelectItem>
                                            <MudSelectItem Value="@("Communauté réduite")">Communauté réduite</MudSelectItem>
                                            <MudSelectItem Value="@("Séparation de biens")">Séparation de biens</MudSelectItem>
                                            <MudSelectItem Value="@("Communauté universelle")">Communauté universelle</MudSelectItem>
                                            <MudSelectItem Value="@("Participation aux acquêts")">Participation aux acquêts</MudSelectItem>
                                        </MudSelect>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ════════════ SECTION : PIÈCE D'IDENTITÉ ════════════ -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon section-icon-red">
                    <i class="bi bi-card-text"></i>
                </div>
                <div class="section-title-wrap">
                    <h3 class="section-title">Pièce d'identité</h3>
                    <p class="section-subtitle">Document officiel d'identification</p>
                </div>
            </div>

            <div class="section-body">
                <div class="form-grid">
                    <div class="form-field">
                        <MudSelect T="string" @bind-Value="Model.TypePieceID"
                                   Label="Type de pièce *"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            <MudSelectItem Value="@("")">Sélectionner...</MudSelectItem>
                            <MudSelectItem Value="@("CNI")">Carte Nationale d'Identité (CNI)</MudSelectItem>
                            <MudSelectItem Value="@("Passeport")">Passeport</MudSelectItem>
                            <MudSelectItem Value="@("Permis")">Permis de Conduire</MudSelectItem>
                            <MudSelectItem Value="@("Carte Séjour")">Carte de Séjour</MudSelectItem>
                            <MudSelectItem Value="@("CarteRefugie")">Carte de Réfugié</MudSelectItem>
                            <MudSelectItem Value="@("TitreSecours")">Titre de Séjour</MudSelectItem>
                            <MudSelectItem Value="@("Autre")">Autre</MudSelectItem>
                        </MudSelect>
                        <ValidationMessage For="@(() => Model.TypePieceID)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.NumPieceID"
                                      Label="N° de pièce *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                        <ValidationMessage For="@(() => Model.NumPieceID)" />
                    </div>

                    <div class="form-field">
                        <MudDatePicker @bind-Date="_dateDelivPiece"
                                       Label="Date de délivrance *"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                        <ValidationMessage For="@(() => Model.DateDelivPiece)" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.LieuDelivPiece"
                                      Label="Lieu de délivrance"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </div>

                    <div class="form-field">
                        <MudTextField @bind-Value="Model.PersonDelivPiece"
                                      Label="Délivrée par"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </div>

                    <div class="form-field form-col-3">
                        <label class="checkbox-pretty">
                            <InputCheckbox @bind-Value="Model.CopiePieceJointe" />
                            <span class="checkbox-mark"></span>
                            <span class="checkbox-text">
                                <i class="bi bi-paperclip"></i>
                                Copie de la pièce jointe fournie
                            </span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public ClientModelViewModel Model { get; set; } = null!;

    // === Variables DateTime? simples (PATTERN VALIDÉ pour MudDatePicker) ===
    private DateTime? _dateNaiss;
    private DateTime? _dateMariage;
    private DateTime? _dateDelivPiece;
    private DateTime? _datePVDelib;

    protected override void OnInitialized()
    {
        // Sync ViewModel → variables locales au démarrage
        _dateNaiss = Model.DateNaiss;
        _dateMariage = Model.DateMariage;
        _dateDelivPiece = Model.DateDelivPiece;
        _datePVDelib = Model.DatePVDelib;
    }

    protected override void OnParametersSet()
    {
        // Sync variables locales → ViewModel quand l'utilisateur modifie les dates
        Model.DateNaiss = _dateNaiss;
        Model.DateMariage = _dateMariage;
        Model.DateDelivPiece = _dateDelivPiece;
        Model.DatePVDelib = _datePVDelib;
    }

    private void SelectTypeClient(string typeClient)
    {
        Model.TypeClient = typeClient;

        if (typeClient == "Personne Morale")
        {
            // Nettoyer les champs Personne Physique
            Model.Nom = "";
            Model.Prenoms = "";
            Model.Sexe = "";
            Model.DateNaiss = null;
            _dateNaiss = null;
            Model.PaysNaiss = "";
            Model.LieuNaiss = "";
        }
        else if (typeClient == "Personne Physique")
        {
