        border: 1px solid;
    }

    .menu-item-text {
        font-size: 0.9rem;
        font-weight: 600;
        color: #0A2540;
        transition: color 0.2s ease;
    }

    /* === Mon profil : Vert BOA principal === */
    .menu-profile .menu-item-icon {
        background: linear-gradient(135deg, #ECFDF5, #DCFCE7);
        color: #0E7C5C;
        border-color: #BBF7D0;
