        color: #C9A86A !important;
        transition: all 0.2s ease !important;
        border-radius: 10px !important;
    }

        .boa-menu-btn:hover {
            background: rgba(201, 168, 106, 0.15) !important;
            color: #E0BD7E !important;
            transform: scale(1.05);
