            }


    /* ════════════════════════════════════════════════════════════════
           MENU ITEMS — Cohérence vert BOA + doré
           ════════════════════════════════════════════════════════════════ */
    .menu-item-content {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 4px 0;
        width: 100%;
        transition: all 0.2s ease;
    }

    .menu-item-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        display: flex;
