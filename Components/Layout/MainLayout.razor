    /* ════════════════════════════════════════════════════════════════
       USER CHIP — Vert sobre compact (ancien style)
       ════════════════════════════════════════════════════════════════ */
    .appbar-user-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 12px 6px 6px;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .appbar-user-chip:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(201, 168, 106, 0.4);
        }

    /* === Avatar vert dégradé compact === */
    .appbar-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #14A574, #0E7C5C 60%, #0A2922);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.5px;
        box-shadow: 0 2px 8px rgba(20, 165, 116, 0.4);
        position: relative;
        flex-shrink: 0;
    }

        .appbar-avatar::after {
            content: '';
            position: absolute;
            bottom: -1px;
            right: -1px;
            width: 8px;
            height: 8px;
            background: #C9A86A;
