        background: radial-gradient(900px 400px at 10% 0%, rgba(20, 165, 116, 0.22), transparent 60%), radial-gradient(700px 350px at 85% 50%, rgba(201, 168, 106, 0.12), transparent 65%), linear-gradient(135deg, #0A2922 0%, #0E3D2E 60%, #052218 100%) !important;
        border-bottom: 1px solid rgba(201, 168, 106, 0.2) !important;
