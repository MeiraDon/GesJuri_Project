@inherits LayoutComponentBase
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using GesCPSI_Project.Models

@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<UserModel> UserManager

<MudLayout>
    <MudAppBar Elevation="0" Class="boa-appbar">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle"
                       Class="boa-menu-btn" />

        <MudElement HtmlTag="a"
                    Class="boa-logo-wrap"
                    href="/"
                    rel="noopener noreferrer">
            <MudImage Src="/Logo_boatg.jpg" Width="200" Height="50" Alt="Logo_boatg" Elevation="0" />
        </MudElement>

        <MudSpacer />

        @* ============= USER MENU À DROITE ============= *@
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <div class="appbar-user-chip" title="@_userEmail">
                    <div class="appbar-avatar">
                        <span>@_initials</span>
                    </div>
                    <div class="appbar-user-info">
                        <div class="appbar-user-name">@_fullName</div>
                        <div class="appbar-user-role">@_roleLabel</div>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="appbar-user-chevron" />
                </div>
            </ActivatorContent>
            <ChildContent>
                <div class="user-menu-header">
                    <div class="user-menu-avatar">@_initials</div>
                    <div class="user-menu-details">
                        <div class="user-menu-name">@_fullName</div>
                        @if (!string.IsNullOrWhiteSpace(_fonction))
                        {
                            <div class="user-menu-fonction">
                                <i class="bi bi-briefcase-fill"></i>
                                <span>@_fonction</span>
                            </div>
                        }
                        <div class="user-menu-role">@_roleLabel</div>
                        <div class="user-menu-email">
                            <i class="bi bi-envelope-fill"></i>
                            <span>@_userEmail</span>
                        </div>
                    </div>
                </div>

                <MudDivider />

                <MudMenuItem Href="/profile">
                    <div class="menu-item-content menu-profile">
                        <div class="menu-item-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <span class="menu-item-text">Mon profil</span>
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/change-password">
                    <div class="menu-item-content menu-password">
                        <div class="menu-item-icon">
                            <i class="bi bi-key-fill"></i>
                        </div>
                        <span class="menu-item-text">Changer mon mot de passe</span>
                    </div>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Href="/Account/Logout">
                    <div class="menu-item-content menu-logout">
                        <div class="menu-item-icon">
                            <i class="bi bi-box-arrow-right"></i>
                        </div>
                        <span class="menu-item-text">Se déconnecter</span>
                    </div>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="2"
               Variant="@DrawerVariant.Mini"
               OpenMiniOnHover="true"
               Style="background: transparent; border-right: none;">
        <NavMenu IsMiniMode="!_drawerOpen" />
    </MudDrawer>

    <MudMainContent Class="boa-main-content">
        <div class="main-content-wrapper">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    private string _userEmail = "";
    private string _fullName = "Utilisateur";
    private string _initials = "U";
    private string _roleLabel = "—";
    private string _fonction = "";

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userEmail = user.Identity.Name ?? "";

            // ===== Récupérer le user complet depuis la BDD =====
            var userModel = await UserManager.FindByNameAsync(_userEmail);

            if (userModel != null)
            {
                // Construire le nom complet depuis NomComplet
                var nomComplet = userModel.NomComplet?.Trim() ?? "";

                if (!string.IsNullOrWhiteSpace(nomComplet))
                {
                    _fullName = nomComplet;
                }
                else
                {
                    // Fallback : extraire de l'email
                    _fullName = _userEmail.Contains('@') ? _userEmail.Split('@')[0] : _userEmail;
                }

                // Récupérer la fonction métier (Caissier, Juriste, etc.)
                _fonction = userModel.Fonction?.Trim() ?? "";

                // Initiales depuis NomComplet
                _initials = GetInitials(_fullName);
            }
            else
            {
                // Fallback complet si user non trouvé
                _fullName = _userEmail.Contains('@') ? _userEmail.Split('@')[0] : _userEmail;
                _initials = GetInitials(_fullName);
            }

            // ===== Label du rôle (gardé pour le menu dropdown) =====
            if (user.IsInRole(RoleNames.Admin))
                _roleLabel = "Administrateur";
            else if (user.IsInRole(RoleNames.Responsable))
                _roleLabel = "Resp. Juridique";
            else if (user.IsInRole(RoleNames.Agent))
                _roleLabel = "Agent Juridique";
        }
    }

    private string GetInitials(string nomComplet)
    {
        if (string.IsNullOrWhiteSpace(nomComplet))
        {
            return _userEmail.Length >= 2 ? _userEmail[..2].ToUpper() : "U";
        }

        // Découper en mots et prendre la 1ère lettre des 2 premiers mots
        var mots = nomComplet
            .Split(new[] { ' ', '-', '_' }, StringSplitOptions.RemoveEmptyEntries)
            .Where(m => !string.IsNullOrWhiteSpace(m))
            .Take(2)
            .ToList();

        if (mots.Count >= 2)
        {
            return $"{mots[0][..1].ToUpper()}{mots[1][..1].ToUpper()}";
        }
        else if (mots.Count == 1 && mots[0].Length >= 2)
        {
            return mots[0][..2].ToUpper();
        }
        else if (mots.Count == 1)
        {
            return mots[0][..1].ToUpper();
        }

        return "U";
    }
}

<style>

    /* ════════════════════════════════════════════════════════════════
           WRAPPER CONTENU PRINCIPAL — Pas de padding inutile
           ════════════════════════════════════════════════════════════════ */
    .main-content-wrapper {
        width: 100%;
        min-height: calc(100vh - 64px); /* 100vh moins la hauteur de la AppBar */
        padding: 0; /* Pas de padding ici */
        margin: 0;
    }

    /* ════════════════════════════════════════════════════════════════
           APP BAR — Vert profond BOA avec glow ambiant
           ════════════════════════════════════════════════════════════════ */
