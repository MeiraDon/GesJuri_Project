@using Microsoft.AspNetCore.Components.Authorization
@using GesCPSI_Project.Models
@using GesCPSI_Project.Interfaces
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

@inject AuthenticationStateProvider AuthStateProvider
@inject IActeWorkflow WorkflowService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<div class="sidebar @(IsMiniMode ? "mini-mode" : "")">

    <!-- ============= HEADER ============= -->
    <div class="sidebar-header">
        <div class="brand-container">
            <div class="brand-info">
                <div class="brand-title">GESCPSI</div>
                <div class="brand-subtitle">Gestion des Actes juridiques (CPSI)</div>
            </div>
        </div>
    </div>

    <!-- ============= NAVIGATION ============= -->
    <div class="sidebar-nav">

        <!-- COMMUN À TOUS LES RÔLES -->
        <div class="nav-section">
            <div class="section-label">NAVIGATION</div>

            <NavLink class="nav-item" href="" Match="NavLinkMatch.All" title="Tableau de bord">
                <div class="nav-icon"><i class="bi bi-speedometer2"></i></div>
                <div class="nav-text">Tableau de bord</div>
            </NavLink>

            <NavLink class="nav-item" href="listAct" Match="NavLinkMatch.All" title="Consulter les actes">
                <div class="nav-icon"><i class="bi bi-folder2"></i></div>
                <div class="nav-text">Gestion des Actes</div>
            </NavLink>

            <!-- AGENT JURIDIQUE & ADMIN : saisie d'actes -->
            <AuthorizeView Roles="@($"{RoleNames.Admin},{RoleNames.Agent}")">
                <NavLink class="nav-item" href="choisirAct" Match="NavLinkMatch.Prefix" title="Saisir un nouvel acte">
                    <div class="nav-icon"><i class="bi bi-pencil-square"></i></div>
                    <div class="nav-text">Nouvel Acte</div>
                </NavLink>
            </AuthorizeView>

            <!-- RESPONSABLE JURIDIQUE & ADMIN : validation avec badge -->
            <AuthorizeView Roles="@($"{RoleNames.Admin},{RoleNames.Responsable}")">
                <NavLink class="nav-item" href="validationAct" Match="NavLinkMatch.All" title="Valider les actes">
                    <div class="nav-icon">
                        <i class="bi bi-check2-circle"></i>
                        @if (IsMiniMode && _pendingCount > 0)
                        {
                            <span class="nav-icon-dot"></span>
                        }
                    </div>
                    <div class="nav-text">Validation</div>
                    @if (!IsMiniMode && _pendingCount > 0)
                    {
                        <div class="nav-badge-pending @(_badgeBump ? "badge-bump" : "")">@_pendingCount</div>
                    }
                </NavLink>
            </AuthorizeView>

            <NavLink class="nav-item" href="archives" Match="NavLinkMatch.All" title="Archiver des actes">
                <div class="nav-icon"><i class="bi bi-archive"></i></div>
                <div class="nav-text">Archives</div>
            </NavLink>

            <NavLink class="nav-item" href="historique" Match="NavLinkMatch.All" title="Journal d'audit">
                <div class="nav-icon"><i class="bi bi-clock-history"></i></div>
                <div class="nav-text">Historique</div>
            </NavLink>
        </div>

        <!-- ADMINISTRATION : ADMIN UNIQUEMENT -->
        <AuthorizeView Roles="@RoleNames.Admin">
            <div class="nav-section">
                <div class="section-label">ADMINISTRATION</div>

                <NavLink class="nav-item" href="clientPage" Match="NavLinkMatch.Prefix" title="Gestion des clients">
                    <div class="nav-icon"><i class="bi bi-person-plus-fill"></i></div>
                    <div class="nav-text">Clients</div>
                </NavLink>

                <NavLink class="nav-item" href="ajouterAct" Match="NavLinkMatch.All" title="Configurer les types d'actes">
                    <div class="nav-icon"><i class="bi bi-file-earmark-medical"></i></div>
                    <div class="nav-text">Types d'Actes</div>
                </NavLink>

                <NavLink class="nav-item" href="users" Match="NavLinkMatch.All" title="Gestion des utilisateurs">
                    <div class="nav-icon"><i class="bi bi-people-fill"></i></div>
                    <div class="nav-text">Utilisateurs</div>
                </NavLink>

                <NavLink class="nav-item" href="/banque" Match="NavLinkMatch.All" title="Banque">
                    <div class="nav-icon"><i class="bi bi-bank"></i></div>
                    <div class="nav-text">Banque</div>
                </NavLink>

                <NavLink class="nav-item" href="rapports" Match="NavLinkMatch.All" title="Rapports et statistiques">
                    <div class="nav-icon"><i class="bi bi-graph-up"></i></div>
                    <div class="nav-text">Rapports</div>
                </NavLink>

                <NavLink class="nav-item" href="parametres" Match="NavLinkMatch.All" title="Paramètres système">
                    <div class="nav-icon"><i class="bi bi-gear"></i></div>
                    <div class="nav-text">Paramètres</div>
                </NavLink>
            </div>
        </AuthorizeView>

    </div>

    <!-- ============= FOOTER : USER PROFILE ============= -->
    <div class="sidebar-footer user-footer">
        <a href="/profile" class="user-profile footer-profile" title="@_displayName - @_roleLabel">
            <div class="avatar">
                <span class="avatar-initials">@_initials</span>
            </div>
            <div class="user-info">
                <div class="user-name">@_displayName</div>
                <div class="user-role">@_roleLabel</div>
            </div>
        </a>

        <a href="/Account/Logout" class="logout-btn" title="Déconnexion">
            <i class="bi bi-box-arrow-right"></i>
        </a>
    </div>
</div>

@code {
    [Parameter] public bool IsMiniMode { get; set; }

    private string _displayName = "Utilisateur";
    private string _initials = "U";
    private string _roleLabel = "—";

    private int _pendingCount = 0;
    private bool _badgeBump = false;  // 🆕 Pour animation visuelle quand notif arrive

    // 🆕 SignalR
    private HubConnection? _hubConnection;
    private string? _userRole = null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var email = user.Identity.Name ?? "";
            _displayName = email.Contains('@') ? email.Split('@')[0] : email;

            _initials = string.IsNullOrEmpty(_displayName) ? "U"
                      : _displayName.Length >= 2 ? _displayName[..2].ToUpper()
                      : _displayName[..1].ToUpper();

            if (user.IsInRole(RoleNames.Admin))
            {
                _roleLabel = "Administrateur";
                _userRole = RoleNames.Admin;
            }
            else if (user.IsInRole(RoleNames.Responsable))
            {
                _roleLabel = "Resp. Juridique";
                _userRole = RoleNames.Responsable;
            }
            else if (user.IsInRole(RoleNames.Agent))
            {
                _roleLabel = "Agent Juridique";
                _userRole = RoleNames.Agent;
            }

            if (user.IsInRole(RoleNames.Admin) || user.IsInRole(RoleNames.Responsable))
            {
                await RefreshPendingCountAsync();
            }

            // 🆕 Connexion SignalR pour les notifications temps réel
            await ConnectToSignalRAsync();
        }
    }

    private async Task RefreshPendingCountAsync()
    {
        try
        {
            _pendingCount = await WorkflowService.CountEnAttenteAsync();
        }
        catch
        {
            _pendingCount = 0;
        }
    }

    // ════════════════════════════════════════════════
    // 🆕 NOTIFICATIONS SIGNALR
    // ════════════════════════════════════════════════

    private async Task ConnectToSignalRAsync()
    {
        try
        {
            // Construction de la connexion vers le Hub
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/notificationHub"))
                .WithAutomaticReconnect()  // Reconnexion auto si la connexion tombe
                .Build();

            // ═══ ÉCOUTE 1 : Acte soumis (pour les Responsables) ═══
            _hubConnection.On<dynamic>("ActeSoumis", async (data) =>
            {
                await InvokeAsync(async () =>
                {
                    // Rafraîchir le compteur depuis la base
                    await RefreshPendingCountAsync();

                    // Animation du badge (bump)
                    _badgeBump = true;
                    StateHasChanged();

                    // Notification visuelle
                    Snackbar.Add(
                        $"Nouvel acte à valider !",
                        Severity.Info,
                        config =>
                        {
                            config.VisibleStateDuration = 5000;
                            config.ShowCloseIcon = true;
                            config.Icon = Icons.Material.Filled.NotificationsActive;
                        });

                    // Désactiver l'animation après 1s
                    await Task.Delay(1000);
                    _badgeBump = false;
                    StateHasChanged();
                });
            });

            // ═══ ÉCOUTE 2 : Acte validé (pour les Agents) ═══
            _hubConnection.On<dynamic>("ActeValide", async (data) =>
            {
                await InvokeAsync(() =>
                {
                    Snackbar.Add(
                        $"Un de vos actes a été validé !",
                        Severity.Success,
                        config =>
                        {
                            config.VisibleStateDuration = 5000;
                            config.ShowCloseIcon = true;
                            config.Icon = Icons.Material.Filled.CheckCircle;
                        });
                    return Task.CompletedTask;
                });
            });

            // ═══ ÉCOUTE 3 : Acte rejeté (pour les Agents) ═══
            _hubConnection.On<dynamic>("ActeRejete", async (data) =>
            {
                await InvokeAsync(() =>
                {
                    Snackbar.Add(
                        $"Un de vos actes a été rejeté.",
                        Severity.Warning,
                        config =>
                        {
                            config.VisibleStateDuration = 7000;
                            config.ShowCloseIcon = true;
                            config.Icon = Icons.Material.Filled.Cancel;
                        });
                    return Task.CompletedTask;
                });
            });

            // Démarrer la connexion
            await _hubConnection.StartAsync();

            // Rejoindre le groupe correspondant au rôle de l'utilisateur
            if (!string.IsNullOrEmpty(_userRole))
            {
                await _hubConnection.SendAsync("JoinRoleGroup", _userRole);
            }

            Console.WriteLine($"[SignalR] Connecté au Hub. Rôle : {_userRole}");
        }
        catch (Exception ex)
        {
            // On ne casse pas l'app si SignalR plante
            Console.WriteLine($"[SignalR] Erreur connexion : {ex.Message}");
        }
    }

    // ════════════════════════════════════════════════
    // 🆕 NETTOYAGE — Très important pour éviter les fuites
    // ════════════════════════════════════════════════

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            try
            {
                // Quitter le groupe avant de fermer
                if (!string.IsNullOrEmpty(_userRole))
                {
                    await _hubConnection.SendAsync("LeaveRoleGroup", _userRole);
                }

                await _hubConnection.DisposeAsync();
                Console.WriteLine("[SignalR] Connexion fermée proprement.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SignalR] Erreur dispose : {ex.Message}");
            }
        }
    }
}

<style>
    /* ════════════════════════════════════════════════════════════════
           VARIABLES BOA — Charte vert profond + or premium
           ════════════════════════════════════════════════════════════════ */
    :root {
        --sidebar-width: 46vh;
        --sidebar-collapsed: 40px;
        --boa-green-darkest: #052218;
        --boa-green-deep: #0A2922;
        --boa-green-dark: #0E3D2E;
        --boa-green-mid: #0E7C5C;
        --boa-green-bright: #14A574;
        --boa-green-glow: rgba(20, 165, 116, 0.25);
        --boa-gold: #C9A86A;
        --boa-gold-bright: #E0BD7E;
        --boa-gold-soft: rgba(201, 168, 106, 0.15);
        --text-primary: #ffffff;
        --text-secondary: rgba(255, 255, 255, 0.78);
        --text-muted: rgba(255, 255, 255, 0.5);
        --border-soft: rgba(255, 255, 255, 0.08);
        --border-gold: rgba(201, 168, 106, 0.25);
        --shadow-deep: 0 14px 40px rgba(0, 0, 0, 0.45);
        --shadow-glow-green: 0 4px 16px rgba(14, 124, 92, 0.4);
        --shadow-glow-gold: 0 4px 16px rgba(201, 168, 106, 0.3);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
    }

    .sidebar {
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        background: radial-gradient(900px 520px at 12% 8%, rgba(20, 165, 116, 0.18), transparent 55%), radial-gradient(900px 520px at 85% 18%, rgba(201, 168, 106, 0.12), transparent 58%), radial-gradient(700px 400px at 50% 100%, rgba(14, 124, 92, 0.15), transparent 60%), linear-gradient(180deg, var(--boa-green-deep) 0%, var(--boa-green-darkest) 100%);
        padding: 10px;
        gap: 12px;
        border-right: 1px solid var(--border-soft);
        transition: var(--transition);
        position: relative;
    }

        .sidebar::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 2px;
            height: 100%;
            background: linear-gradient(180deg, transparent 0%, rgba(201, 168, 106, 0.3) 30%, rgba(201, 168, 106, 0.3) 70%, transparent 100%);
            pointer-events: none;
        }

    .brand-container {
        display: flex;
        align-items: center;
        padding: 14px;
        border: 1px solid var(--border-gold);
        border-radius: var(--radius-lg);
        background: linear-gradient(135deg, rgba(20, 165, 116, 0.2), rgba(201, 168, 106, 0.08)), rgba(255, 255, 255, 0.02);
        box-shadow: var(--shadow-deep);
        position: relative;
        overflow: hidden;
    }

        .brand-container::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, var(--boa-gold-soft) 0%, transparent 60%);
            pointer-events: none;
        }

    .brand-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
        position: relative;
        z-index: 1;
    }

    .brand-title {
        font-size: 18px;
        font-weight: 900;
        letter-spacing: 1.2px;
        color: white;
        background: linear-gradient(90deg, #ffffff 0%, var(--boa-gold-bright) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .brand-subtitle {
        font-size: 11px;
        font-weight: 600;
        color: var(--text-secondary);
        letter-spacing: 0.3px;
    }

    .sidebar-nav {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .nav-section {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 2px 2px 6px;
        margin-bottom: 8px;
    }

    .section-label {
        margin: 12px 12px 8px;
        font-size: 10.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--boa-gold);
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-label::before {
            content: '';
            width: 4px;
            height: 4px;
            background: var(--boa-gold);
            border-radius: 50%;
            box-shadow: 0 0 6px var(--boa-gold);
        }

        .section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, var(--border-gold) 0%, transparent 100%);
        }

    .nav-item {
        color: white;
        display: flex;
        align-items: center;
        text-decoration: none;
        transition: var(--transition);
        border-radius: var(--radius-md);
        gap: 12px;
        margin: 1px 8px;
        padding: 8px;
        white-space: nowrap;
        position: relative;
        overflow: hidden;
    }

        .nav-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 0;
            background: linear-gradient(180deg, var(--boa-green-bright), var(--boa-gold));
            border-radius: 0 4px 4px 0;
            transition: height 0.3s ease;
        }

        .nav-item:hover {
            background: rgba(20, 165, 116, 0.12);
            transform: translateX(4px);
        }

            .nav-item:hover::before {
                height: 70%;
            }

            .nav-item:hover .nav-icon {
                background: linear-gradient(135deg, var(--boa-green-mid), var(--boa-green-bright));
                color: white;
                box-shadow: var(--shadow-glow-green);
            }

        .nav-item.active {
            background: linear-gradient(90deg, rgba(14, 124, 92, 0.4) 0%, rgba(20, 165, 116, 0.25) 50%, transparent 100%);
            color: white;
            box-shadow: inset 0 0 0 1px rgba(201, 168, 106, 0.2);
        }

            .nav-item.active::before {
                height: 70%;
            }

            .nav-item.active .nav-icon {
                background: linear-gradient(135deg, var(--boa-green-mid) 0%, var(--boa-green-bright) 100%);
                color: white;
                box-shadow: var(--shadow-glow-green), 0 0 0 1px var(--border-gold);
            }

            .nav-item.active .nav-text {
                font-weight: 700;
                color: white;
            }

    .nav-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.06);
        font-size: 16px;
        border-radius: var(--radius-sm);
        flex-shrink: 0;
        position: relative;
        transition: var(--transition);
        color: var(--text-secondary);
    }

    .nav-text {
        font-size: 14px;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--text-secondary);
        transition: color 0.2s ease;
    }

    .nav-item:hover .nav-text {
        color: white;
    }

    .sidebar-footer {
        padding: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: auto;
        border: 1px solid var(--border-gold);
        border-radius: var(--radius-lg);
        background: linear-gradient(135deg, rgba(20, 165, 116, 0.18), rgba(201, 168, 106, 0.08)), rgba(255, 255, 255, 0.02);
        box-shadow: var(--shadow-deep);
        position: relative;
        overflow: hidden;
    }

        .sidebar-footer::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -20%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(20, 165, 116, 0.15) 0%, transparent 60%);
            pointer-events: none;
        }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: inherit;
        flex: 1;
        min-width: 0;
        padding: 4px;
        border-radius: var(--radius-sm);
        transition: var(--transition);
        position: relative;
        z-index: 1;
    }

        .user-profile:hover {
            background: rgba(255, 255, 255, 0.06);
        }

    .avatar {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: var(--radius-md);
        background: linear-gradient(135deg, var(--boa-green-bright) 0%, var(--boa-green-mid) 60%, var(--boa-green-dark) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: var(--shadow-glow-green), inset 0 0 0 1.5px var(--border-gold);
        position: relative;
    }

        .avatar::after {
            content: '';
            position: absolute;
            bottom: -1px;
            right: -1px;
            width: 12px;
            height: 12px;
            background: var(--boa-gold);
            border-radius: 50%;
            border: 2.5px solid var(--boa-green-deep);
            box-shadow: 0 0 4px var(--boa-gold);
        }

    .avatar-initials {
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: white;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .user-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
        overflow: hidden;
    }

    .user-name {
        font-size: 13px;
        font-weight: 700;
        color: white;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        letter-spacing: 0.2px;
    }

    .user-role {
        font-size: 11px;
        font-weight: 600;
        color: var(--boa-gold-bright);
        letter-spacing: 0.4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-transform: uppercase;
    }

    .nav-badge-pending {
        background: linear-gradient(135deg, #DC2626 0%, #B91C1C 60%, #EF4444 100%);
        color: white;
        font-size: 11px;
        font-weight: 800;
        min-width: 22px;
        height: 22px;
        padding: 0 7px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: auto;
        box-shadow: 0 2px 8px rgba(220, 38, 38, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.2);
        animation: pulse-badge 2s ease-in-out infinite;
        letter-spacing: 0.3px;
        flex-shrink: 0;
    }

        /* 🆕 Animation BUMP — Le badge "saute" quand une nouvelle notif arrive */
        .nav-badge-pending.badge-bump {
            animation: badge-bump 0.6s cubic-bezier(0.36, 0, 0.66, -0.56) !important;
        }

    @@keyframes badge-bump {
        0% {
            transform: scale(1);
        }

        25% {
            transform: scale(1.5) rotate(-8deg);
            background: linear-gradient(135deg, #F59E0B 0%, #D97706 60%, #FBBF24 100%);
            box-shadow: 0 0 24px rgba(245, 158, 11, 0.9);
        }

        50% {
            transform: scale(1.3) rotate(5deg);
        }

        75% {
            transform: scale(1.2) rotate(-3deg);
        }

        100% {
            transform: scale(1);
        }
    }

    .nav-icon-dot {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 10px;
        height: 10px;
        background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%);
        border-radius: 50%;
        border: 2px solid var(--boa-green-deep);
        animation: pulse-badge 2s ease-in-out infinite;
    }

    @@keyframes pulse-badge {
        0%, 100% {
            transform: scale(1);
            box-shadow: 0 2px 8px rgba(220, 38, 38, 0.5);
        }

        50% {
            transform: scale(1.1);
            box-shadow: 0 4px 16px rgba(220, 38, 38, 0.75);
        }
    }

    .logout-btn {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        padding: 0;
        border-radius: var(--radius-sm);
        border: 1px solid rgba(255, 107, 107, 0.2);
        background: rgba(255, 107, 107, 0.12);
        color: #ff6b6b;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
        text-decoration: none;
        font-size: 16px;
        position: relative;
        z-index: 1;
    }

        .logout-btn:hover {
            background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
            color: white;
            transform: scale(1.08) rotate(-3deg);
            box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);
            border-color: transparent;
        }

    .sidebar-nav::-webkit-scrollbar {
        width: 4px;
    }

    .sidebar-nav::-webkit-scrollbar-track {
        background: transparent;
