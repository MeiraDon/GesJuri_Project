@page "/ajouterAct"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Gestion des types d'actes - GesCPSI</PageTitle>

@using MudBlazor
@using GesCPSI_Project.Models
@using GesCPSI_Project.Interfaces
@using GesCPSI_Project.Components

@inject IAjoutAct AjoutActService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="ajout-page">

    <!-- ═════════════ HEADER BLEU ROYAL ═════════════ -->
    <div class="ajout-topbar">
        <div class="topbar-bg-deco"></div>
        <div class="topbar-content">
            <div class="topbar-title-block">
                <div class="topbar-icon">
                    <i class="bi bi-sliders2-vertical"></i>
                </div>
                <div>
                    <h1 class="topbar-title">Atelier des Modèles</h1>
                    <p class="topbar-subtitle">
                        <i class="bi bi-tools"></i>
                        Configurez les types d'actes disponibles dans l'application
                    </p>
                </div>
            </div>

            <div class="topbar-stats">
                <div class="topbar-stat stat-total">
                    <div class="stat-icon-mini">
                        <i class="bi bi-collection-fill"></i>
                    </div>
                    <div class="stat-data">
                        <div class="stat-num">@ajoutActList.Count</div>
                        <div class="stat-lbl">Total</div>
                    </div>
                </div>

                <div class="stat-divider-vert"></div>

                <div class="topbar-stat stat-pp">
                    <div class="stat-icon-mini">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="stat-data">
                        <div class="stat-num">@CountPP</div>
                        <div class="stat-lbl">Pers. Physique</div>
                    </div>
                </div>

                <div class="stat-divider-vert"></div>

                <div class="topbar-stat stat-pm">
                    <div class="stat-icon-mini">
                        <i class="bi bi-building-fill"></i>
                    </div>
                    <div class="stat-data">
                        <div class="stat-num">@CountPM</div>
                        <div class="stat-lbl">Pers. Morale</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═════════════ SPLIT WORKSPACE ═════════════ -->
    <div class="workspace-split">

        <!-- ───── ZONE FORMULAIRE (gauche, sticky) ───── -->
        <div class="form-pane">
            <div class="form-sticky">
                <div class="form-card">

                    <div class="form-card-header">
                        <div class="form-mode-pill @(isEditing ? "mode-edit" : "mode-new")">
                            @if (isEditing)
                            {
                                <i class="bi bi-pencil-fill"></i>
                                <span>Modification</span>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle-fill"></i>
                                <span>Nouveau modèle</span>
                            }
                        </div>

                        @if (isEditing)
                        {
                            <button class="form-cancel-btn" @onclick="ResetForm" title="Annuler la modification">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>

                    <MudForm @ref="form">

                        <!-- Catégorie -->
                        <div class="field-group">
                            <label class="field-label">
                                <span class="field-number">1</span>
                                Catégorie de client
                            </label>
                            <MudSelect T="string"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       @bind-Value="ajoutActModel.CategorieClient"
                                       Required="true">
                                <MudSelectItem Value="@("Personne Physique")">Personne Physique</MudSelectItem>
                                <MudSelectItem Value="@("Personne Morale")">Personne Morale</MudSelectItem>
                            </MudSelect>
                        </div>

                        <!-- Modèle d'acte -->
                        <div class="field-group">
                            <label class="field-label">
                                <span class="field-number">2</span>
                                Modèle d'acte officiel
                            </label>
                            <MudSelect T="TemplateType"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       @bind-Value="ajoutActModel.TemplateType"
                                       Required="true">
                                <MudSelectItem Value="@TemplateType.CautionnementSpecifiquePhysique">Cautionnement Spécifique — PP</MudSelectItem>
                                <MudSelectItem Value="@TemplateType.CautionnementSpecifiqueMorale">Cautionnement Spécifique — PM</MudSelectItem>
                                <MudSelectItem Value="@TemplateType.ToutEngagementPhysique">Tout Engagement — PP</MudSelectItem>
                                <MudSelectItem Value="@TemplateType.ToutEngagementMorale">Tout Engagement — PM</MudSelectItem>
                                <MudSelectItem Value="@TemplateType.DelegationLoyersMorale">Délégation de Loyers — PM</MudSelectItem>
                            </MudSelect>
                            <div class="field-helper">Détermine le rendu PDF et l'aperçu officiel</div>
                        </div>

                        <!-- Nom -->
                        <div class="field-group">
                            <label class="field-label">
                                <span class="field-number">3</span>
                                Nom du type d'acte
                            </label>
                            <MudTextField @bind-Value="ajoutActModel.NomAct"
                                          @bind-Value:after="@(() => SuggererTemplateType())"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true"
                                          RequiredError="Le nom est obligatoire"
                                          Placeholder="Ex: Cautionnement spécifique particulier" />
                        </div>

                        <!-- Description -->
                        <div class="field-group">
                            <label class="field-label">
                                <span class="field-number">4</span>
                                Description (optionnel)
                            </label>
                            <MudTextField @bind-Value="ajoutActModel.Description"
                                          @bind-Value:after="@(() => SuggererTemplateType())"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="3"
                                          Placeholder="Quelques mots pour expliquer ce type d'acte..." />
                        </div>

                        <!-- Boutons d'action -->
                        <div class="form-actions">
                            <button class="form-btn form-btn-primary"
                                    @onclick="AjouterOuModifierActe"
                                    disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-mini"></span>
                                    <span>Enregistrement...</span>
                                }
                                else
                                {
                                    <i class="bi @(isEditing ? "bi-check2" : "bi-plus-circle-fill")"></i>
                                    <span>@(isEditing ? "Mettre à jour" : "Enregistrer")</span>
                                }
                            </button>

                            @if (isEditing)
                            {
                                <button class="form-btn form-btn-ghost" @onclick="ResetForm">
                                    Annuler
                                </button>
                            }
                        </div>

                    </MudForm>
                </div>
            </div>
        </div>

        <!-- ───── ZONE PRÉVISUALISATION (droite) ───── -->
        <div class="preview-pane">
            <div class="preview-label">
                <i class="bi bi-eye-fill"></i>
                <span>APERÇU EN DIRECT</span>
            </div>

            @{
                var (previewIcon, previewGradient) = GetActeStyle(ajoutActModel.TemplateType);
                var hasName = !string.IsNullOrWhiteSpace(ajoutActModel.NomAct);
                var hasCat = !string.IsNullOrWhiteSpace(ajoutActModel.CategorieClient);
            }

            <div class="preview-card @(isEditing ? "preview-edit-mode" : "")">
                @if (isEditing)
                {
                    <div class="preview-ribbon">
                        <i class="bi bi-pencil-fill"></i>
                        Modification en cours
                    </div>
                }

                <div class="preview-icon-wrap" style="background: @previewGradient;">
                    <i class="bi @previewIcon"></i>
                </div>

                <div class="preview-body">
                    @if (hasCat)
                    {
                        var isMorale = ajoutActModel.CategorieClient == "Personne Morale";
                        <div class="preview-cat @(isMorale ? "preview-cat-morale" : "preview-cat-physique")">
                            <i class="bi @(isMorale ? "bi-building-fill" : "bi-person-fill")"></i>
                            <span>@ajoutActModel.CategorieClient</span>
                        </div>
                    }
                    else
                    {
                        <div class="preview-cat preview-cat-empty">
                            <i class="bi bi-question-circle"></i>
                            <span>Catégorie non définie</span>
                        </div>
                    }

                    <h2 class="preview-title @(!hasName ? "preview-empty" : "")">
                        @(hasName ? ajoutActModel.NomAct : "Nom du type d'acte...")
                    </h2>

                    <p class="preview-desc @(string.IsNullOrWhiteSpace(ajoutActModel.Description) ? "preview-empty" : "")">
                        @(string.IsNullOrWhiteSpace(ajoutActModel.Description) ? "La description apparaîtra ici..." : ajoutActModel.Description)
                    </p>

                    <div class="preview-divider"></div>

                    <div class="preview-template-info">
                        <div class="template-label">Modèle PDF</div>
                        <div class="template-value">
                            <i class="bi bi-file-earmark-text"></i>
                            @GetTemplateLabel(ajoutActModel.TemplateType)
                        </div>
                    </div>
                </div>
            </div>

            <div class="preview-hint">
                <i class="bi bi-info-circle"></i>
                <span>Cette carte se met à jour automatiquement pendant votre saisie</span>
            </div>
        </div>

    </div>

    <!-- ═════════════ LISTE DES ACTES (cards) ═════════════ -->
    <section class="list-section">
        <div class="list-header">
            <div class="list-title-block">
                <h2 class="list-title">
                    <i class="bi bi-collection"></i>
                    Modèles enregistrés
                </h2>
                <p class="list-subtitle">
                    <i class="bi bi-pencil"></i> pour modifier ·
                    <i class="bi bi-trash"></i> pour supprimer
                </p>
            </div>

            <div class="filter-pills">
                <button class="filter-pill @(_filterCat == null ? "active" : "")" @onclick="@(() => _filterCat = null)">
                    Tous (@ajoutActList.Count)
                </button>
                <button class="filter-pill @(_filterCat == "Personne Physique" ? "active" : "")" @onclick="@(() => _filterCat = "Personne Physique")">
                    <i class="bi bi-person-fill"></i>
                    <span>PP (@CountPP)</span>
                </button>
                <button class="filter-pill @(_filterCat == "Personne Morale" ? "active" : "")" @onclick="@(() => _filterCat = "Personne Morale")">
                    <i class="bi bi-building-fill"></i>
                    <span>PM (@CountPM)</span>
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-zone">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (!FilteredList.Any())
        {
            <div class="empty-zone">
                <div class="empty-icon">
                    <i class="bi bi-folder-plus"></i>
                </div>
                <div class="empty-title">Aucun modèle enregistré</div>
                <div class="empty-subtitle">Créez votre premier type d'acte avec le formulaire à gauche</div>
            </div>
        }
        else
        {
            <div class="cards-grid">
                @foreach (var acte in FilteredList)
                {
                    var (icon, gradient) = GetActeStyle(acte.TemplateType);
                    var isCurrentEdit = isEditing && idEnEdition == acte.IdAjout;

                    <div class="list-card @(isCurrentEdit ? "list-card-editing" : "")">

                        @if (isCurrentEdit)
                        {
                            <div class="editing-tag">
                                <i class="bi bi-pencil-fill"></i> En cours
                            </div>
                        }

                        <div class="list-card-head">
                            <div class="list-card-icon" style="background: @gradient;">
                                <i class="bi @icon"></i>
                            </div>
                            <div class="list-card-actions">
                                <button class="card-action-btn card-action-edit"
                                        @onclick="@(() => ModifierActe(acte))"
                                        title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="card-action-btn card-action-delete"
                                        @onclick="@(() => ConfirmerSuppression(acte.IdAjout))"
                                        title="Supprimer">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>

                        <div class="list-card-body">
                            <div class="list-cat @(acte.CategorieClient == "Personne Morale" ? "list-cat-morale" : "list-cat-physique")">
                                <i class="bi @(acte.CategorieClient == "Personne Morale" ? "bi-building-fill" : "bi-person-fill")"></i>
                                <span>@acte.CategorieClient</span>
                            </div>

                            <h3 class="list-card-title">@acte.NomAct</h3>

                            @if (!string.IsNullOrWhiteSpace(acte.Description))
                            {
                                <p class="list-card-desc">@acte.Description</p>
                            }
                            else
                            {
                                <p class="list-card-desc list-empty-desc">Pas de description</p>
                            }
                        </div>

                        <div class="list-card-foot">
                            <span class="list-template-tag">
                                <i class="bi bi-file-earmark-text"></i>
                                @GetTemplateLabel(acte.TemplateType)
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</div>


@code {
    private MudForm? form;
    private AjoutActModel ajoutActModel = new AjoutActModel();
    private List<AjoutActModel> ajoutActList = new();
    private bool isSaving = false;
    private bool isLoading = false;
    private bool isEditing = false;
    private int? idEnEdition = null;

    private string? _filterCat = null;

    private int CountPP => ajoutActList.Count(a => a.CategorieClient == "Personne Physique");
    private int CountPM => ajoutActList.Count(a => a.CategorieClient == "Personne Morale");

    private List<AjoutActModel> FilteredList =>
        string.IsNullOrEmpty(_filterCat)
            ? ajoutActList
            : ajoutActList.Where(a => a.CategorieClient == _filterCat).ToList();

    protected override async Task OnInitializedAsync() => await ChargerListeAsync();

    private async Task ChargerListeAsync()
    {
        try
        {
            isLoading = true;
            ajoutActList = await AjoutActService.GetAllAsync() ?? new List<AjoutActModel>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur lors du chargement : {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetTemplateLabel(TemplateType type) => type switch
    {
        TemplateType.CautionnementSpecifiquePhysique => "Cautionn. Spéc. PP",
        TemplateType.CautionnementSpecifiqueMorale => "Cautionn. Spéc. PM",
        TemplateType.ToutEngagementPhysique => "Tout Engag. PP",
        TemplateType.ToutEngagementMorale => "Tout Engag. PM",
        TemplateType.DelegationLoyersMorale => "Délég. Loyers PM",
        _ => "—"
    };

    private (string icon, string gradient) GetActeStyle(TemplateType type) => type switch
    {
        TemplateType.CautionnementSpecifiquePhysique => ("bi-shield-shaded", "linear-gradient(135deg, #1A1F3A 0%, #2A2F4A 100%)"),
        TemplateType.CautionnementSpecifiqueMorale => ("bi-building-fill", "linear-gradient(135deg, #1F3C88 0%, #3F3A8A 100%)"),
        TemplateType.ToutEngagementPhysique => ("bi-person-badge", "linear-gradient(135deg, #0E7C5C 0%, #2F5D50 100%)"),
        TemplateType.ToutEngagementMorale => ("bi-buildings", "linear-gradient(135deg, #92400E 0%, #C9A86A 100%)"),
        TemplateType.DelegationLoyersMorale => ("bi-house-door-fill", "linear-gradient(135deg, #9B1C2D 0%, #BE3144 100%)"),
        _ => ("bi-file-earmark-text", "linear-gradient(135deg, #475569 0%, #64748B 100%)")
    };

    private async Task AjouterOuModifierActe()
    {
        if (form == null) return;

        await form.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add("Veuillez corriger les erreurs du formulaire", Severity.Warning);
            return;
        }

        isSaving = true;
        try
        {
            Result<AjoutActModel> result;

            if (isEditing && idEnEdition.HasValue)
            {
                var existing = await AjoutActService.GetByIdAsync(idEnEdition.Value);
                if (existing == null)
                {
                    Snackbar.Add("Type d'acte non trouvé", Severity.Error);
                    return;
                }

                existing.NomAct = ajoutActModel.NomAct?.Trim() ?? string.Empty;
                existing.Description = ajoutActModel.Description?.Trim();
                existing.CategorieClient = ajoutActModel.CategorieClient;
                existing.TemplateType = ajoutActModel.TemplateType;

                result = await AjoutActService.UpdateAsync(existing);
            }
            else
            {
                var nouveauActe = new AjoutActModel
                    {
                        NomAct = ajoutActModel.NomAct?.Trim() ?? string.Empty,
                        Description = ajoutActModel.Description?.Trim(),
                        CategorieClient = ajoutActModel.CategorieClient,
                        TemplateType = ajoutActModel.TemplateType
                    };
                result = await AjoutActService.AddAsync(nouveauActe);
            }

            if (result.IsSuccess)
            {
                Snackbar.Add(isEditing ? "Type d'acte modifié avec succès" : "Type d'acte ajouté avec succès", Severity.Success);
                ResetForm();
                await ChargerListeAsync();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Erreur inconnue", Severity.Error);
            }
        }
        finally { isSaving = false; }
    }

    private void SuggererTemplateType()
    {
        var nom = (ajoutActModel.NomAct ?? "").ToLowerInvariant();
        var cat = ajoutActModel.CategorieClient ?? "";
        var estMorale = cat.Contains("Morale", StringComparison.OrdinalIgnoreCase);

        if (nom.Contains("délégation") || nom.Contains("delegation") || nom.Contains("loyer"))
        {
            ajoutActModel.TemplateType = TemplateType.DelegationLoyersMorale;
        }
        else if (nom.Contains("tout engagement") || nom.Contains("tous engagement")
              || nom.Contains("solde débiteur") || nom.Contains("compte courant"))
        {
            ajoutActModel.TemplateType = estMorale
                ? TemplateType.ToutEngagementMorale
                : TemplateType.ToutEngagementPhysique;
        }
        else
        {
            ajoutActModel.TemplateType = estMorale
                ? TemplateType.CautionnementSpecifiqueMorale
                : TemplateType.CautionnementSpecifiquePhysique;
        }
    }

    private void ModifierActe(AjoutActModel acte)
    {
        isEditing = true;
        idEnEdition = acte.IdAjout;
        ajoutActModel = new AjoutActModel
            {
                CategorieClient = acte.CategorieClient,
                NomAct = acte.NomAct,
                Description = acte.Description,
                TemplateType = acte.TemplateType
            };
    }

    private async Task ConfirmerSuppression(int id)
    {
        var parameters = new DialogParameters<DialogConfirmation>
        {
            { x => x.ContentText, "Êtes-vous sûr de vouloir supprimer ce type d'acte ? Cette action est irréversible." }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };

        var dialogRef = await DialogService.ShowAsync<DialogConfirmation>("Confirmation", parameters, options);
        var result = await dialogRef.Result.ConfigureAwait(false);

        if (result?.Data is true)
        {
            await SupprimerActeConfirme(id);
        }
    }

    private async Task SupprimerActeConfirme(int id)
    {
        try
        {
            var acte = await AjoutActService.GetByIdAsync(id);
            if (acte == null)
            {
                Snackbar.Add("Type d'acte non trouvé", Severity.Warning);
                return;
            }

            var result = await AjoutActService.DeleteAsync(acte);
            if (result.IsSuccess)
            {
                Snackbar.Add("Type d'acte supprimé avec succès", Severity.Success);
                await ChargerListeAsync();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Erreur lors de la suppression", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    private void ResetForm()
    {
        ajoutActModel = new AjoutActModel();
        isEditing = false;
        idEnEdition = null;
        form?.ResetValidation();
    }
}

<style>
    /* ════════════════════════════════════════════════
           ATELIER DES MODÈLES — DESIGN BLEU ROYAL BNP
           ════════════════════════════════════════════════ */
    .ajout-page {
        display: flex;
        flex-direction: column;
        gap: 24px;
        padding: 8px;
        background: radial-gradient(800px 500px at 80% 20%, rgba(30, 64, 175, 0.04), transparent 60%), radial-gradient(600px 400px at 20% 80%, rgba(79, 70, 229, 0.04), transparent 60%), #F5F7FB;
        min-height: 100vh;
    }

    /* ═══════════ HEADER BLEU ROYAL ═══════════ */
    .ajout-topbar {
        background: radial-gradient(700px 350px at 85% 30%, rgba(252, 211, 77, 0.1), transparent 60%), radial-gradient(500px 300px at 15% 80%, rgba(79, 70, 229, 0.2), transparent 65%), linear-gradient(135deg, #0A1E5C 0%, #1E40AF 40%, #2563EB 75%, #1E3A8A 100%);
        padding: 24px 28px;
        border-radius: 18px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 32px rgba(30, 64, 175, 0.3);
    }

        /* Filigrane or en bas */
        .ajout-topbar::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent 0%, rgba(252, 211, 77, 0.4) 25%, rgba(252, 211, 77, 0.7) 50%, rgba(252, 211, 77, 0.4) 75%, transparent 100%);
            pointer-events: none;
        }

        /* Motif "plan d'architecte" (grille subtile) */
        .ajout-topbar::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

    .topbar-bg-deco {
        position: absolute;
        top: -40%;
        right: -10%;
        width: 380px;
        height: 380px;
        background: radial-gradient(circle, rgba(252, 211, 77, 0.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .topbar-content {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .topbar-title-block {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    /* Icône Atelier (engrenages or sur bleu) */
    .topbar-icon {
        width: 58px;
        height: 58px;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(252, 211, 77, 0.25), rgba(255, 255, 255, 0.1));
        border: 1.5px solid rgba(252, 211, 77, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.7rem;
        flex-shrink: 0;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        position: relative;
    }

        .topbar-icon::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 16px;
            border: 1.5px dashed rgba(252, 211, 77, 0.35);
            animation: rotate-slow 30s linear infinite;
        }

    @@keyframes rotate-slow {
        to {
            transform: rotate(360deg);
        }
    }

    .topbar-title {
        color: white;
        font-size: 1.6rem;
        font-weight: 800;
        margin: 0;
        line-height: 1.2;
        letter-spacing: -0.4px;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .topbar-subtitle {
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.88rem;
        margin: 4px 0 0 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 500;
    }

