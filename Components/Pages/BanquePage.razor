@page "/banque"
@rendermode InteractiveServer

<PageTitle>Banques - GesCPSI</PageTitle>

@using MudBlazor
@using GesCPSI_Project.Models
@using GesCPSI_Project.Interfaces
@using System.ComponentModel.DataAnnotations
@using GesCPSI_Project.Components.Dialogs
@inject IBanque BanqueService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <div class="banque-page">

        <!-- ═════════════ HEADER VERT BOA PROFOND ═════════════ -->
        <MudPaper Class="banque-hero" Elevation="0">
            <div class="hero-bg-deco"></div>
            <div class="hero-content">
                <div class="hero-main">
                    <div class="hero-icon-wrap">
                        <i class="bi bi-bank2"></i>
                    </div>
                    <div class="hero-text">
                        <h1 class="hero-title">Gestion des Banques</h1>
                        <p class="hero-meta">
                            <span class="meta-strong">@banques.Count banque@(banques.Count > 1 ? "s" : "")</span>
                            <span class="meta-sep">·</span>
                            <span>institutions partenaires</span>
                            <span class="meta-sep">·</span>
                            <span class="meta-boa">
                                <i class="bi bi-shield-fill-check"></i>
                                BOA-TOGO active
                            </span>
                        </p>
                    </div>
                </div>

                <div class="hero-actions">
                    <MudTooltip Text="Actualiser la liste">
                        <button class="hero-btn-icon" @onclick="RefreshList">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </MudTooltip>
                    <button class="hero-btn-primary" @onclick="OpenQuickAdd">
                        <i class="bi bi-plus-lg"></i>
                        <span>Nouvelle banque</span>
                    </button>
                </div>
            </div>
        </MudPaper>

        <!-- ═════════════ STATS CARDS PREMIUM (4 cartes bancaires) ═════════════ -->
        <div class="stats-grid">

            <div class="stat-card stat-total">
                <div class="stat-card-bg"></div>
                <div class="stat-icon-wrap">
                    <i class="bi bi-buildings-fill"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Total banques</div>
                    <div class="stat-value">@banques.Count</div>
                    <div class="stat-sub">
                        <i class="bi bi-arrow-up-circle-fill"></i>
                        <span>Référentiel actif</span>
                    </div>
                </div>
            </div>

            <div class="stat-card stat-cities">
                <div class="stat-card-bg"></div>
                <div class="stat-icon-wrap">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Villes couvertes</div>
                    <div class="stat-value">@GetDistinctCities()</div>
                    <div class="stat-sub">
                        <i class="bi bi-pin-map-fill"></i>
                        <span>Sièges sociaux</span>
                    </div>
                </div>
            </div>

            <div class="stat-card stat-capital">
                <div class="stat-card-bg"></div>
                <div class="stat-icon-wrap">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Capital moyen</div>
                    <div class="stat-value-small">@GetAverageCapital()</div>
                    <div class="stat-sub">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>FCFA moyen</span>
                    </div>
                </div>
            </div>

            <div class="stat-card stat-recent">
                <div class="stat-card-bg"></div>
                <div class="stat-icon-wrap">
                    <i class="bi bi-stars"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">Dernier ajout</div>
                    <div class="stat-value-small">@GetLastAddedDate()</div>
                    <div class="stat-sub">
                        <i class="bi bi-clock-history"></i>
                        <span>Activité récente</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- ═════════════ FORMULAIRE PREMIUM SECTIONNÉ ═════════════ -->
        <div class="form-card" id="form">
            <div class="form-header">
                <div class="form-header-left">
                    <div class="form-header-icon @(isEditing ? "editing" : "creating")">
                        <i class="bi @(isEditing ? "bi-pencil-square" : "bi-plus-square")"></i>
                    </div>
                    <div>
                        <h3 class="form-title">
                            @(isEditing ? "Modifier une banque" : "Enregistrer une banque")
                        </h3>
                        <p class="form-subtitle">
                            @(isEditing ? "Mise à jour des informations bancaires" : "Référencement d'une nouvelle institution")
                        </p>
                    </div>
                </div>
                <div class="form-header-badge @(isEditing ? "badge-edit" : "badge-new")">
                    <i class="bi @(isEditing ? "bi-pencil-fill" : "bi-asterisk")"></i>
                    <span>@(isEditing ? "ÉDITION" : "NOUVEAU")</span>
                </div>
            </div>

            <div class="form-body">
                <EditForm EditContext="@editContext" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-warning alert-sm mb-3" />

                    <!-- Section 1 : Informations principales (MARINE) -->
                    <div class="form-section section-primary">
                        <div class="section-header">
                            <div class="section-icon">
                                <i class="bi bi-building-fill"></i>
                            </div>
                            <div class="section-title">Informations principales</div>
                            <span class="section-required">Obligatoire</span>
                        </div>
                        <div class="section-body">
                            <MudTextField @bind-Value="banque.NomRaisonSocialBnq"
                                          Label="Nom / Raison sociale"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="Champ requis"
                                          Margin="Margin.Dense"
                                          Class="mb-2" />

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="banque.SigleBnq"
                                                  Label="Sigle"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="banque.FormeJuridique"
                                                  Label="Forme juridique"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        </div>
                    </div>

                    <!-- Section 2 : Capital et siège (OR) -->
                    <div class="form-section section-gold">
                        <div class="section-header">
                            <div class="section-icon">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                            <div class="section-title">Capital et siège</div>
                        </div>
                        <div class="section-body">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="banque.CapitalSocial"
                                                  Label="Capital social"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Adornment="Adornment.End"
                                                  AdornmentText="FCFA" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="banque.SiegeSocial"
                                                  Label="Siège social"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  RequiredError="Champ requis"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        </div>
                    </div>

                    <!-- Section 3 : Identifiants légaux (VERT) -->
                    <div class="form-section section-green">
                        <div class="section-header">
                            <div class="section-icon">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div class="section-title">Identifiants légaux</div>
                        </div>
                        <div class="section-body">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="banque.RegistreCommerce"
                                                  Label="RCCM/NIF"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="banque.Swift"
                                                  Label="Code SWIFT/BIC"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        </div>
                    </div>

                    <!-- Section 4 : Représentation (INDIGO) -->
                    <div class="form-section section-indigo">
                        <div class="section-header">
                            <div class="section-icon">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>
                            <div class="section-title">Représentation</div>
                        </div>
                        <div class="section-body">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="banque.RepresentantBnq"
                                                  Label="Représentant"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="banque.FonctionRepresentant"
                                                  Label="Fonction"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        </div>
                    </div>

                    <!-- Section 5 : Contacts (ORANGE) -->
                    <div class="form-section section-orange">
                        <div class="section-header">
                            <div class="section-icon">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div class="section-title">Contacts</div>
                        </div>
                        <div class="section-body">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="banque.TelBnq"
                                                  Label="Téléphone"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="banque.EmailBnq"
                                                  Label="Email"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        </div>
                    </div>

                    <!-- Actions du formulaire -->
                    <div class="form-actions">
                        <div class="form-actions-left">
                            <button type="button" class="btn-form btn-cancel" @onclick="ResetForm">
                                <i class="bi bi-x-lg"></i>
                                <span>Annuler</span>
                            </button>
                            <button type="button" class="btn-form btn-preview" @onclick="@(() => ShowPreview(banque))" disabled="@(banque.IdBnq == 0)">
                                <i class="bi bi-eye-fill"></i>
                                <span>Aperçu</span>
                            </button>
                        </div>
                        <button type="submit" class="btn-form btn-save @(isEditing ? "saving-edit" : "saving-new")">
                            <i class="bi @(isEditing ? "bi-pencil-fill" : "bi-check-circle-fill")"></i>
                            <span>@(isEditing ? "Mettre à jour" : "Enregistrer")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- ═════════════ LISTE BANQUES PREMIUM (cartes bancaires) ═════════════ -->
        <div class="list-card">
            <div class="list-header">
                <div class="list-header-left">
                    <div class="list-header-icon">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                    </div>
                    <div>
                        <h3 class="list-title">Liste des banques</h3>
                        <p class="list-subtitle">@banques.Count institution@(banques.Count > 1 ? "s" : "") référencée@(banques.Count > 1 ? "s" : "")</p>
                    </div>
                </div>
                <div class="list-header-right">
                    <div class="list-search">
                        <i class="bi bi-search"></i>
                        <input type="text" class="list-search-input" placeholder="Rechercher..." @bind="searchTerm" @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(searchTerm))
                        {
                            <button class="list-search-clear" @onclick='() => searchTerm = ""'>
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="list-body">
                @if (!filteredBanques.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-bank"></i>
                        </div>
                        <div class="empty-title">Aucune banque trouvée</div>
                        <div class="empty-subtitle">Commencez par ajouter votre première banque partenaire</div>
                        <button class="empty-action" @onclick="ResetForm">
                            <i class="bi bi-plus-lg"></i>
                            <span>Ajouter une banque</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="banques-grid">
                        @foreach (var banqueItem in filteredBanques)
                        {
                            var isBoaBanque = IsBoa(banqueItem);
                            <div class="banque-card @(isBoaBanque ? "is-boa" : "") @(banqueItem.IdBnq == banque.IdBnq ? "is-active" : "")">

                                <!-- Top : avatar + badge -->
                                <div class="banque-card-top">
                                    <div class="banque-avatar @(isBoaBanque ? "avatar-boa" : "avatar-default")">
                                        <i class="bi @(isBoaBanque ? "bi-shield-fill-check" : "bi-bank")"></i>
                                    </div>
                                    @if (isBoaBanque)
                                    {
                                        <div class="banque-badge badge-boa">
                                            <i class="bi bi-patch-check-fill"></i>
                                            <span>BANQUE APPLICATIVE</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="banque-badge badge-ref">
                                            <i class="bi bi-bookmark-fill"></i>
                                            <span>RÉFÉRENTIEL</span>
                                        </div>
                                    }
                                </div>

                                <!-- Nom -->
                                <div class="banque-name-block">
                                    <div class="banque-name">@banqueItem.NomRaisonSocialBnq</div>
                                    @if (!string.IsNullOrWhiteSpace(banqueItem.SigleBnq))
                                    {
                                        <div class="banque-sigle">@banqueItem.SigleBnq</div>
                                    }
                                </div>

                                <!-- Détails -->
                                <div class="banque-details">
                                    <div class="detail-row">
                                        <i class="bi bi-person-fill"></i>
                                        <span class="detail-text">@(string.IsNullOrWhiteSpace(banqueItem.RepresentantBnq) ? "—" : banqueItem.RepresentantBnq)</span>
                                    </div>
                                    <div class="detail-row">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        <span class="detail-text">@(string.IsNullOrWhiteSpace(banqueItem.SiegeSocial) ? "—" : banqueItem.SiegeSocial)</span>
                                    </div>
                                    <div class="detail-row">
                                        <i class="bi bi-telephone-fill"></i>
                                        <span class="detail-text">@(string.IsNullOrWhiteSpace(banqueItem.TelBnq) ? "—" : banqueItem.TelBnq)</span>
                                    </div>
                                    <div class="detail-row">
                                        <i class="bi bi-key-fill"></i>
                                        <span class="detail-text detail-mono">
                                            SWIFT: @(string.IsNullOrWhiteSpace(banqueItem.Swift) ? "—" : banqueItem.Swift)
                                        </span>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="banque-card-actions">
                                    <button class="card-btn card-btn-view" @onclick="@(() => ShowPreview(banqueItem))" title="Détails">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                    <button class="card-btn card-btn-edit" @onclick="@(() => Edit(banqueItem))" title="Modifier">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    <button class="card-btn card-btn-delete" @onclick="@(() => ConfirmDelete(banqueItem))" title="Supprimer" disabled="@isBoaBanque">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
</MudContainer>

@code {
    private EditContext editContext = default!;
    private BanqueModel banque = new();
    private List<BanqueModel> banques = new();
    private bool isEditing = false;
    private string searchTerm = string.Empty;

    private List<BanqueModel> filteredBanques =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? banques
            : banques.Where(b =>
                (b.NomRaisonSocialBnq?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (b.SigleBnq?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (b.RepresentantBnq?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (b.SiegeSocial?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (b.Swift?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(banque);
        await LoadBanques();
    }

    private bool IsBoa(BanqueModel model)
    {
        return string.Equals(model.SigleBnq?.Trim(), "BOA", StringComparison.OrdinalIgnoreCase)
            || (model.NomRaisonSocialBnq?.Contains("BOA", StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task LoadBanques()
    {
        try
        {
            banques = await BanqueService.GetAllAsync() ?? new List<BanqueModel>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur lors du chargement des banques : {ex.Message}", Severity.Error);
        }
    }

    private async Task Save()
    {
        if (!editContext.Validate())
        {
            Snackbar.Add("Veuillez corriger les erreurs du formulaire.", Severity.Warning);
            return;
        }

        try
        {
            var result = isEditing
                ? await BanqueService.UpdateAsync(banque)
                : await BanqueService.AddAsync(banque);

            if (result.IsSuccess)
            {
                Snackbar.Add("Banque enregistrée avec succès.", Severity.Success);
                await LoadBanques();
                ResetForm();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Erreur lors de l'enregistrement.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    private void Edit(BanqueModel model)
    {
        banque = new BanqueModel
            {
                IdBnq = model.IdBnq,
                NomRaisonSocialBnq = model.NomRaisonSocialBnq,
                SigleBnq = model.SigleBnq,
                FormeJuridique = model.FormeJuridique,
                CapitalSocial = model.CapitalSocial,
                SiegeSocial = model.SiegeSocial,
                RegistreCommerce = model.RegistreCommerce,
                Swift = model.Swift,
                TelBnq = model.TelBnq,
                EmailBnq = model.EmailBnq,
                RepresentantBnq = model.RepresentantBnq,
                FonctionRepresentant = model.FonctionRepresentant,
                NomCollaborateur = model.NomCollaborateur,
                VisaCollaborateur = model.VisaCollaborateur
            };

        isEditing = true;
        editContext = new EditContext(banque);
        NavigationManager.NavigateTo("/banque#form", false);
    }

    private async Task ConfirmDelete(BanqueModel model)
    {
        if (IsBoa(model))
        {
            Snackbar.Add("La banque BOA ne peut pas être supprimée car elle est utilisée par l'application.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
            {
                ["ContentText"] = $"Êtes-vous sûr de vouloir supprimer la banque « {model.NomRaisonSocialBnq} » ? Cette action est irréversible.",
                ["ButtonText"] = "Supprimer",
                ["Color"] = Color.Error
            };

        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true
            };

        var dialog = await DialogService.ShowAsync<DialogConfirmation>("Confirmation de suppression", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var deleteResult = await BanqueService.DeleteAsync(model);

                if (deleteResult.IsSuccess)
                {
                    Snackbar.Add("Banque supprimée avec succès.", Severity.Success);
                    await LoadBanques();

                    if (banque.IdBnq == model.IdBnq)
                        ResetForm();
                }
                else
                {
                    Snackbar.Add(deleteResult.ErrorMessage ?? "Erreur lors de la suppression.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
            }
        }
    }

    private void ResetForm()
    {
        banque = new BanqueModel();
        isEditing = false;
        editContext = new EditContext(banque);
    }

    private async Task RefreshList()
    {
        await LoadBanques();
        Snackbar.Add("Liste actualisée.", Severity.Info);
    }

    private Task OpenQuickAdd()
    {
        ResetForm();
        NavigationManager.NavigateTo("/banque#form", false);
        return Task.CompletedTask;
    }

    private async Task ShowPreview(BanqueModel model)
    {
        var parameters = new DialogParameters
            {
                ["Banque"] = model
            };

        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                Position = DialogPosition.Center
            };

        var dialogRef = await DialogService.ShowAsync<BanquePreviewDialog>("Détails de la banque", parameters, options);
        await dialogRef.Result;
    }

    private int GetDistinctCities()
    {
        return banques
            .Select(b => b.SiegeSocial?.Split(',').FirstOrDefault()?.Trim())
            .Where(city => !string.IsNullOrWhiteSpace(city))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
    }

    private string GetAverageCapital()
    {
        if (!banques.Any())
            return "N/A";

        var capitals = banques
            .Select(b =>
            {
                var raw = b.CapitalSocial?.Replace(" ", "").Replace(",", "");
                return decimal.TryParse(raw, out var capital) ? capital : 0m;
            })
            .Where(c => c > 0)
            .ToList();

        return capitals.Any() ? $"{capitals.Average():N0}" : "N/A";
    }

    private string GetLastAddedDate()
    {
        return banques.Any() ? "Récent" : "Jamais";
    }
}

<style>
    /* ════════════════════════════════════════════════
           BANQUE PAGE — DESIGN BANCAIRE PREMIUM BOA
           ════════════════════════════════════════════════ */

    .banque-page {
        display: flex;
        flex-direction: column;
        gap: 24px;
        background: radial-gradient(800px 500px at 80% 20%, rgba(14, 124, 92, 0.03), transparent 60%), radial-gradient(600px 400px at 20% 80%, rgba(30, 64, 175, 0.04), transparent 60%), #F5F7FB;
        min-height: 100vh;
        padding: 8px;
    }

    /* ═══════════ HEADER VERT BOA ÉPURÉ (sans bordeaux) ═══════════ */
    .banque-hero {
        background: radial-gradient(900px 500px at 88% 15%, rgba(252, 211, 77, 0.15), transparent 60%), radial-gradient(700px 400px at 10% 90%, rgba(20, 165, 116, 0.18), transparent 65%), radial-gradient(500px 300px at 50% 50%, rgba(20, 165, 116, 0.12), transparent 70%), linear-gradient(135deg, #0A2922 0%, #0E7C5C 60%, #14A574 100%) !important;
        padding: 28px 32px !important;
        border-radius: 20px !important;
        position: relative;
        overflow: hidden;
        box-shadow: 0 16px 48px rgba(10, 41, 34, 0.25), inset 0 1px 0 rgba(252, 211, 77, 0.18), inset 0 0 0 1px rgba(252, 211, 77, 0.08);
    }

        /* Filigrane doré épais en bas (signature BOA) */
        .banque-hero::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
