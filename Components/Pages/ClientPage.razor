@page "/clientPage" 
@page "/clientPage/{IdAjout:int}"
@rendermode InteractiveServer

<PageTitle>Client</PageTitle>

@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using GesCPSI_Project.Models
@using GesCPSI_Project.Interfaces
@using GesCPSI_Project.ViewModels

@inject IClient ClientService
@inject IClientAct ClientActService
@inject IRolesClientAct RolesClientActService
@inject ITypesAct TypesActService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<div class="container py-4" lang="fr">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">

            <!-- ═════════════ HEADER COMPACT (harmonisé avec listAct/validationAct) ═════════════ -->
            <MudPaper Class="client-hero mb-4" Elevation="0">
                <div class="hero-bg-deco"></div>
                <div class="hero-content">

                    <div class="hero-main">
                        <div class="hero-icon-wrap">
                            <i class="bi @(isEdit ? "bi-person-fill-gear" : "bi-person-plus-fill")"></i>
                        </div>
                        <div class="hero-text">
                            <h1 class="hero-title">
                                @(isEdit ? "Modifier un client" : "Créer un client")
                            </h1>
                            <p class="hero-meta">
                                @if (!string.IsNullOrWhiteSpace(roleLabel))
                                {
                                    <span class="meta-role-pill">
                                        <i class="bi bi-bookmark-star-fill"></i>
                                        Rôle : @roleLabel
                                    </span>
                                    <span class="meta-sep">·</span>
                                }
                                <span>Renseignez les informations du client</span>
                            </p>
                        </div>
                    </div>

                    <div class="hero-actions">
                        @if (acteId.HasValue)
                        {
                            <div class="hero-context-pill">
                                <i class="bi bi-link-45deg"></i>
                                <span>Lié à l'acte <strong>#@acteId</strong></span>
                            </div>
                        }
                        @if (IdAjout > 0 && !acteId.HasValue)
                        {
                            <div class="hero-context-pill hero-context-pill-alt">
                                <i class="bi bi-tag-fill"></i>
                                <span>Type #@IdAjout</span>
                            </div>
                        }

                        <!-- Bouton vers la liste complète -->
                        <button class="hero-btn-gold" @onclick="GoToClientsList" title="Voir tous les clients enregistrés">
                            <i class="bi bi-people-fill"></i>
                            <span>Voir tous les clients</span>
                            <span class="hero-btn-count">@_clients.Count</span>
                        </button>
                    </div>

                </div>
            </MudPaper>

            <!-- ═════════════ HERO BOARD (innovation MudBlazor) ═════════════ -->
            <MudPaper Class="client-hero-board mb-4" Elevation="0">

                <div class="hero-board-grid">

                    <!-- COL 1 : Donut MudBlazor avec total au centre -->
                    <div class="hero-donut-wrap">
                        <MudChart ChartType="ChartType.Donut"
                                  Width="160px"
                                  Height="160px"
                                  InputData="@_donutData"
                                  InputLabels="@_donutLabels"
                                  ChartOptions="@_donutOptions"
                                  LegendPosition="Position.Bottom"
                                  Class="hero-donut-chart">
                        </MudChart>
                        <div class="hero-donut-center">
                            <div class="donut-value">@_clients.Count</div>
                            <div class="donut-label">CLIENTS</div>
                        </div>
                    </div>

                    <!-- COL 2 : Barres segmentées de répartition -->
                    <div class="hero-bars-wrap">
                        <div class="hero-bars-title">
                            <i class="bi bi-bar-chart-line-fill"></i>
                            <span>Répartition par type</span>
                        </div>

                        <div class="bar-row">
                            <div class="bar-label">
                                <span class="bar-dot dot-physique"></span>
                                <span>Personnes physiques</span>
                            </div>
                            <div class="bar-value">
                                <strong>@_nbPhysiques</strong>
                                <span class="bar-pct">· @GetPct(_nbPhysiques)%</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill bar-fill-physique" style="width: @GetPct(_nbPhysiques)%;"></div>
                            </div>
                        </div>

                        <div class="bar-row">
                            <div class="bar-label">
                                <span class="bar-dot dot-morale"></span>
                                <span>Personnes morales</span>
                            </div>
                            <div class="bar-value">
                                <strong>@_nbMorales</strong>
                                <span class="bar-pct">· @GetPct(_nbMorales)%</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill bar-fill-morale" style="width: @GetPct(_nbMorales)%;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- COL 3 : Métriques d'activité (compact info-block) -->
                    <div class="hero-activity-wrap">
                        <div class="activity-label">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Activité</span>
                        </div>
                        <div class="activity-value">
                            <span class="activity-number">+@_nouveauxCeMois</span>
                            <span class="activity-trend">
                                <i class="bi bi-arrow-up-right"></i>
                                ce mois
                            </span>
                        </div>
                        <div class="activity-sub">
                            Dernier ajout : <strong>@(_dernierClient ?? "—")</strong>
                        </div>
                    </div>

                </div>
            </MudPaper>

            <!-- ═════════════ FORMULAIRE PREMIUM (avec indicateur de complétion) ═════════════ -->
            <MudPaper Class="client-form-card mb-4" Elevation="0">

                <!-- Barre de progression du formulaire (INNOVATION) -->
                <div class="form-progress-bar">
                    <div class="form-progress-info">
                        <div class="form-progress-label">
                            <i class="bi bi-clipboard-check"></i>
                            <span>Complétion du formulaire</span>
                        </div>
                        <div class="form-progress-pct">
                            <span class="pct-value">@GetCompletionPct()%</span>
                            <span class="pct-status">
                                @if (GetCompletionPct() < 30)
                                {
                                    <span class="status-low">À démarrer</span>
                                }
                                else if (GetCompletionPct() < 70)
                                {
                                    <span class="status-mid">En cours</span>
                                }
                                else
                                {
                                    <span class="status-high">Presque prêt</span>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="form-progress-track">
                        <div class="form-progress-fill" style="width: @GetCompletionPct()%;"></div>
                    </div>
                </div>

                <div class="form-body">
                    <EditForm EditContext="@editContext" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form-inner-wrap">
                            <GesCPSI_Project.Components.Forms.ClientForm Model="@vm" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="form-alert form-alert-error">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>@errorMessage</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(successMessage))
                        {
                            <div class="form-alert form-alert-success">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@successMessage</span>
                            </div>
                        }

                        <div class="form-actions">
                            <button type="button" class="form-btn form-btn-back" @onclick="GoBack" disabled="@isSaving">
                                <i class="bi bi-arrow-left"></i>
                                <span>Retour</span>
                            </button>

                            <div class="form-actions-right">
                                <button type="button" class="form-btn form-btn-reset" @onclick="ResetForm" disabled="@isSaving">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    <span>Réinitialiser</span>
                                </button>

                                <button type="submit" class="form-btn form-btn-save" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Enregistrement...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check2-circle"></i>
                                        <span>Enregistrer le client</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>

            </MudPaper>

            <div class="text-muted small mb-4">
                Si vous venez du wizard, vous serez renvoyé automatiquement après l’enregistrement.
            </div>

            
        </div>
    </div>
</div>


@code {
    [Parameter] public int IdAjout { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")]
    public string? returnUrl { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "role")]
    public string? role { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "acteId")]
    public int? acteId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "clientId")]
    public int? clientId { get; set; }

    private ClientModelViewModel vm = new();
    private EditContext editContext = default!;

    private bool isSaving;
    private bool isEdit;
    private string? errorMessage;
    private string? successMessage;
    private string? roleLabel;

    // LISTE
    private List<ClientModel> _clients = new();
    private bool _loadingClients = true;
    private string _search = string.Empty;
    private string? _typeClientFilter = null;

    private bool CanSelectClientForWizard =>
        acteId.HasValue && acteId.Value > 0 && !string.IsNullOrWhiteSpace(roleLabel) && !string.IsNullOrWhiteSpace(returnUrl);

    private List<ClientModel> FilteredClients => GetFilteredClients();

    // === Hero Board (Donut + Bars + Activité) ===
    private double[] _donutData = new double[] { 0, 0 };
    private string[] _donutLabels = new[] { "Physiques", "Morales" };

    private ChartOptions _donutOptions = new ChartOptions
        {
            ChartPalette = new[] { "#0E7C5C", "#C9A86A" }
        };

    private int _nbPhysiques => _clients.Count(c => string.Equals(c.TypeClient, "Personne Physique", StringComparison.OrdinalIgnoreCase));
    private int _nbMorales => _clients.Count(c => string.Equals(c.TypeClient, "Personne Morale", StringComparison.OrdinalIgnoreCase));
    private int _nouveauxCeMois => _clients.Count(c => c.IdClt > 0); // adapte si un champ DateCreation
    private string? _dernierClient => _clients.OrderByDescending(c => c.IdClt).FirstOrDefault() is { } c
        ? (!string.IsNullOrWhiteSpace(c.NomRaisonsociale) ? c.NomRaisonsociale : $"{c.Nom} {c.Prenoms}".Trim())
        : null;

    private int GetPct(int value)
    {
        if (_clients.Count == 0) return 0;
        return (int)Math.Round((double)value / _clients.Count * 100);
    }

    // Helper : pourcentage de complétion du formulaire (innovation)
    private int GetCompletionPct()
    {
        if (vm == null) return 0;

        var fields = new[]
        {
        vm.TypeClient,
        vm.Nom,
        vm.Prenoms,
        vm.NomRaisonsociale,
        vm.NomRepresentant,
        vm.NumCompte,
        vm.NumRCCM,
        vm.Nationalite,
        vm.PaysNaiss,
        vm.LieuNaiss,
        vm.Adressecomplet,
        vm.VilleCommune,
        vm.PaysResidn,
        vm.TelCel,
        vm.TelBur,
        vm.ProfessionClt,
        vm.SituationMatrim,
        vm.TypePieceID,
        vm.NumPieceID,
        vm.LieuDelivPiece
    };

        int total = fields.Length;
        int filled = fields.Count(f => !string.IsNullOrWhiteSpace(f));

        return (int)Math.Round((double)filled / total * 100);
    }

    // Naviguer vers la liste complète (en gardant le contexte)
    private void GoToClientsList()
    {
        var queryParams = new List<string>();

        if (!string.IsNullOrWhiteSpace(returnUrl))
            queryParams.Add($"returnUrl={Uri.EscapeDataString(returnUrl)}");

        if (!string.IsNullOrWhiteSpace(role))
            queryParams.Add($"role={Uri.EscapeDataString(role)}");

        if (acteId.HasValue)
            queryParams.Add($"acteId={acteId.Value}");

        if (IdAjout > 0)
            queryParams.Add($"idAjout={IdAjout}");

        var url = "/clientsListePage" + (queryParams.Any() ? "?" + string.Join("&", queryParams) : "");
        NavigationManager.NavigateTo(url);
    }

    private void RefreshHeroBoard()
    {
        _donutData = new double[] { _nbPhysiques, _nbMorales };
    }

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(vm);

        roleLabel = role switch
        {
            "Debiteur" or "débiteur" or "debiteur" or "Débiteur" => "Débiteur",
            "Caution" or "caution" => "Caution",
            "Temoin1" or "temoin1" or "Témoin1" => "Témoin1",
            "Temoin2" or "temoin2" or "Témoin2" => "Témoin2",
            _ => null
        };

        if (clientId.HasValue && clientId.Value > 0)
        {
            await LoadClientAsync(clientId.Value);
            isEdit = true;
        }

        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        try
        {
            _loadingClients = true;
            _clients = await ClientService.GetAllAsync() ?? new List<ClientModel>();
            RefreshHeroBoard();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur chargement liste clients : {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingClients = false;
            StateHasChanged();
        }
    }

    private async Task ReloadClientsAsync()
    {
        await LoadClientsAsync();
        Snackbar.Add("Liste des clients actualisée.", Severity.Success);
    }

    private List<ClientModel> GetFilteredClients()
    {
        IEnumerable<ClientModel> query = _clients;

        if (!string.IsNullOrWhiteSpace(_typeClientFilter))
        {
            query = query.Where(c => string.Equals(c.TypeClient, _typeClientFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim().ToLowerInvariant();

            query = query.Where(c =>
                c.IdClt.ToString().Contains(s) ||
                (GetClientDisplayName(c).ToLowerInvariant().Contains(s)) ||
                ((c.NomRaisonsociale ?? string.Empty).ToLowerInvariant().Contains(s)) ||
                ((c.NumRCCM ?? string.Empty).ToLowerInvariant().Contains(s)) ||
                ((c.NumCompte ?? string.Empty).ToLowerInvariant().Contains(s)) ||
                ((c.NomRepresentant ?? string.Empty).ToLowerInvariant().Contains(s)) ||
                ((c.TelCel ?? string.Empty).ToLowerInvariant().Contains(s)) ||
                ((c.TelBur ?? string.Empty).ToLowerInvariant().Contains(s)) ||
                ((c.TypePieceID ?? string.Empty).ToLowerInvariant().Contains(s)) ||
                ((c.NumPieceID ?? string.Empty).ToLowerInvariant().Contains(s)) ||
                ((c.Nationalite ?? string.Empty).ToLowerInvariant().Contains(s)));
        }

        return query
            .OrderByDescending(c => c.IdClt)
            .ToList();
    }

    private void ResetClientFilters()
    {
        _search = string.Empty;
        _typeClientFilter = null;
    }

    private string GetClientDisplayName(ClientModel c)
    {
        if (string.Equals(c.TypeClient, "Personne Morale", StringComparison.OrdinalIgnoreCase))
            return string.IsNullOrWhiteSpace(c.NomRaisonsociale) ? "Société non renseignée" : c.NomRaisonsociale!;

        return $"{c.Nom} {c.Prenoms}".Trim();
    }

    private string GetClientSubTitle(ClientModel c)
    {
        if (string.Equals(c.TypeClient, "Personne Morale", StringComparison.OrdinalIgnoreCase))
            return string.IsNullOrWhiteSpace(c.NomRepresentant) ? "-" : $"Représentant : {c.NomRepresentant}";

        return string.IsNullOrWhiteSpace(c.ProfessionClt) ? "-" : c.ProfessionClt!;
    }

    private Color GetClientTypeColor(ClientModel c)
    {
        return c.TypeClient switch
        {
            "Personne Physique" => Color.Success,
            "Personne Morale" => Color.Warning,
            _ => Color.Default
        };
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
                return value;
        }
        return "-";
    }

    private async Task EditClientFromList(int id)
    {
        clientId = id;
        isEdit = true;
        await LoadClientAsync(id);
        Snackbar.Add($"Client #{id} chargé en modification.", Severity.Info);
    }

    private void SelectClientForWizard(int id)
    {
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            Snackbar.Add("Aucune URL de retour définie.", Severity.Warning);
            return;
        }

        var sep = returnUrl.Contains('?') ? "&" : "?";
        var back = $"{returnUrl}{sep}clientId={id}&role={Uri.EscapeDataString(role ?? "")}";
        NavigationManager.NavigateTo(back, forceLoad: true);
    }

    private static DateTime ToUtcOrNow(DateTime? dt)
    {
        var value = dt ?? DateTime.UtcNow;

        return value.Kind switch
        {
            DateTimeKind.Utc => value,
            DateTimeKind.Local => value.ToUniversalTime(),
            _ => DateTime.SpecifyKind(value, DateTimeKind.Local).ToUniversalTime()
        };
    }

    private async Task LoadClientAsync(int id)
    {
        try
        {
            var c = await ClientService.GetByIdAsync(id);
            if (c is null)
            {
                Snackbar.Add("Client introuvable.", Severity.Warning);
                return;
            }

            vm.TypeClient = c.TypeClient;
            vm.NomRaisonsociale = c.NomRaisonsociale;
            vm.NomRepresentant = c.NomRepresentant;
            vm.Nom = c.Nom;
            vm.Prenoms = c.Prenoms;
            vm.Sexe = c.Sexe;
            vm.NumCompte = c.NumCompte;
            vm.NumRCCM = c.NumRCCM;
            vm.DateNaiss = c.DateNaiss;
            vm.PaysNaiss = c.PaysNaiss;
            vm.LieuNaiss = c.LieuNaiss;
            vm.Nationalite = c.Nationalite;

            vm.Adressecomplet = c.Adressecomplet;
            vm.VilleCommune = c.VilleCommune;
            vm.PaysResidn = c.PaysResidn;
            vm.BPClt = c.BPClt;

            vm.TelBur = c.TelBur;
            vm.TelCel = c.TelCel;
            vm.TelDom = c.TelDom;

            vm.ProfessionClt = c.ProfessionClt;
            vm.SituationMatrim = c.SituationMatrim;
            vm.NomConjoint = c.NomConjoint;
            vm.DateMariage = c.DateMariage;
            vm.LieuMariage = c.LieuMariage;
            vm.RegimeMatrim = c.RegimeMatrim;

            vm.TypePieceID = c.TypePieceID;
            vm.NumPieceID = c.NumPieceID;
            vm.DateDelivPiece = c.DateDelivPiece;
            vm.LieuDelivPiece = c.LieuDelivPiece;
            vm.PersonDelivPiece = c.PersonDelivPiece;

            editContext = new EditContext(vm);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur chargement client : {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (!editContext.Validate())
        {
            errorMessage = "Veuillez corriger les erreurs du formulaire.";
            return;
        }

        try
        {
            isSaving = true;

            var entity = new ClientModel
            {
                IdClt = clientId ?? 0,
                TypeClient = vm.TypeClient ?? "",
                NomRaisonsociale = vm.NomRaisonsociale ?? "",
                NomRepresentant = vm.NomRepresentant ?? "",
                Nom = vm.Nom ?? "",
                Prenoms = vm.Prenoms ?? "",
                Sexe = vm.Sexe ?? "",
                NumCompte = vm.NumCompte ?? "",
                NumRCCM = vm.NumRCCM ?? "",

                DateNaiss = ToUtcOrNow(vm.DateNaiss),

                PaysNaiss = vm.PaysNaiss ?? "",
                LieuNaiss = vm.LieuNaiss ?? "",
                Nationalite = vm.Nationalite ?? "",

                Adressecomplet = vm.Adressecomplet ?? "",
                VilleCommune = vm.VilleCommune ?? "",
                PaysResidn = vm.PaysResidn ?? "",
                BPClt = vm.BPClt ?? "",

                TelBur = vm.TelBur ?? "",
                TelCel = vm.TelCel ?? "",
                TelDom = vm.TelDom ?? "",

                ProfessionClt = vm.ProfessionClt ?? "",
                SituationMatrim = vm.SituationMatrim ?? "",
                NomConjoint = vm.NomConjoint ?? "",

                DateMariage = ToUtcOrNow(vm.DateMariage),

                LieuMariage = vm.LieuMariage ?? "",
                RegimeMatrim = vm.RegimeMatrim ?? "",

                TypePieceID = vm.TypePieceID ?? "",
                NumPieceID = vm.NumPieceID ?? "",

                DateDelivPiece = ToUtcOrNow(vm.DateDelivPiece),

                LieuDelivPiece = vm.LieuDelivPiece ?? "",
                PersonDelivPiece = vm.PersonDelivPiece ?? ""
            };

            Result<ClientModel> res;

            if (isEdit && entity.IdClt > 0)
                res = await ClientService.UpdateAsync(entity);
            else
                res = await ClientService.AddAsync(entity);

            if (!res.IsSuccess || res.Data is null)
            {
                errorMessage = res.ErrorMessage ?? "Impossible d'enregistrer le client.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            if (acteId.HasValue && acteId.Value > 0 && !string.IsNullOrWhiteSpace(roleLabel))
            {
                await UpsertClientActeAsync(acteId.Value, roleLabel!, res.Data.IdClt);
            }

            successMessage = "Client enregistré avec succès.";
            Snackbar.Add(successMessage, Severity.Success);

            clientId = res.Data.IdClt;
            isEdit = true;

            await LoadClientsAsync();

            if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                var sep = returnUrl.Contains('?') ? "&" : "?";
                var back = $"{returnUrl}{sep}clientId={res.Data.IdClt}&role={Uri.EscapeDataString(role ?? "")}";
                NavigationManager.NavigateTo(back, forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur : {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task UpsertClientActeAsync(int acteIdValue, string roleLibelle, int clientIdValue)
    {
        var roles = await RolesClientActService.GetAllAsync() ?? new List<RolesClientActModel>();
        var roleRow = roles.FirstOrDefault(r => string.Equals(r.Libelle?.Trim(), roleLibelle.Trim(), StringComparison.OrdinalIgnoreCase));
        if (roleRow is null)
        {
            Snackbar.Add($"Rôle introuvable en base: {roleLibelle}", Severity.Warning);
            return;
        }

        var all = await ClientActService.GetAllAsync() ?? new List<ClientActModel>();
        var existing = all.FirstOrDefault(x => x.IdActe == acteIdValue && x.IdRole == roleRow.IdRole);

        if (existing is null)
        {
            var ca = new ClientActModel
            {
                IdActe = acteIdValue,
                IdClt = clientIdValue,
                IdRole = roleRow.IdRole,
                DescriptionRole = roleLibelle
            };

            var r = await ClientActService.AddAsync(ca);
            if (!r.IsSuccess)
                Snackbar.Add(r.ErrorMessage ?? "Erreur liaison ClientAct.", Severity.Error);
        }
        else
        {
            existing.IdClt = clientIdValue;
            existing.DescriptionRole = roleLibelle;

            var r = await ClientActService.UpdateAsync(existing);
            if (!r.IsSuccess)
                Snackbar.Add(r.ErrorMessage ?? "Erreur update liaison ClientAct.", Severity.Error);
        }
    }

    private void ResetForm()
    {
        vm = new ClientModelViewModel();
        editContext = new EditContext(vm);
        errorMessage = null;
        successMessage = null;
        isEdit = false;
        clientId = null;
        StateHasChanged();
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(returnUrl))
            NavigationManager.NavigateTo(returnUrl, forceLoad: true);
        else
            NavigationManager.NavigateTo($"/saisirPage/{IdAjout}", forceLoad: true);
    }

    // === Helpers pour la liste stylée ===

    // Avatar dégradé selon le type + ID (différencié pour Physique vs Morale)
    private string GetClientAvatarGradient(ClientModel client)
    {
        if (string.Equals(client.TypeClient, "Personne Morale", StringComparison.OrdinalIgnoreCase))
        {
            // Or pour personnes morales
            var goldGradients = new[]
            {
            "linear-gradient(135deg, #C9A86A, #B58E50)",
            "linear-gradient(135deg, #D97706, #B45309)",
            "linear-gradient(135deg, #92400E, #78350F)"
        };
            return goldGradients[Math.Abs(client.IdClt) % goldGradients.Length];
        }
        else
        {
            // Marine pour personnes physiques
            var marineGradients = new[]
            {
            "linear-gradient(135deg, #0A2540, #1F3C88)",
            "linear-gradient(135deg, #1F3C88, #3F3A8A)",
            "linear-gradient(135deg, #0E7C5C, #047857)",
            "linear-gradient(135deg, #6366F1, #4F46E5)"
        };
            return marineGradients[Math.Abs(client.IdClt) % marineGradients.Length];
        }
    }

    // Classe CSS pour le type chip
    private string GetTypeClass(string? type) => type switch
    {
        "Personne Physique" => "type-pill-physique",
        "Personne Morale" => "type-pill-morale",
        _ => "type-pill-default"
    };

    // Innovation : 3 derniers clients = badge "Nouveau"
    private bool IsRecentClient(ClientModel client)
    {
        var top3Ids = _clients
            .OrderByDescending(c => c.IdClt)
            .Take(3)
            .Select(c => c.IdClt)
            .ToList();
        return top3Ids.Contains(client.IdClt);
    }

}

