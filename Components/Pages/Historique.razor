@page "/historique"
@attribute [Authorize]
@rendermode InteractiveServer

@using GesCPSI_Project.Models
@using GesCPSI_Project.Interfaces
@using GesCPSI_Project.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization

@inject IAuditLog AuditService
@inject ITypesAct TypesActService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService

<PageTitle>Historique — GesCPSI</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">

    <!-- ============ HEADER COMPACT (harmonisé + innovation historique) ============ -->
    <MudPaper Class="history-hero" Elevation="0">
        <div class="hero-bg-deco"></div>
        <div class="hero-content">

            <div class="hero-main">
                <div class="hero-icon-wrap">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="hero-text">
                    <h1 class="hero-title">Journal d'audit</h1>
                    <p class="hero-meta">
                        @if (_isAgent)
                        {
                            <span><i class="bi bi-person-fill-check me-1"></i>Vos actions</span>
                        }
                        else
                        {
                            <span><i class="bi bi-eye-fill me-1"></i>Observation complète</span>
                        }
                        <span class="meta-sep">·</span>
                        <span class="meta-strong">@_stats.Total événement@(_stats.Total > 1 ? "s" : "")</span>
                        <span class="meta-sep">·</span>
                        <span>tracé@(_stats.Total > 1 ? "s" : "") en continu</span>
                    </p>
                </div>
            </div>

            <div class="hero-actions">
                @if (_stats.Today > 0)
                {
                    <div class="hero-today-pill">
                        <span class="today-dot"></span>
                        <i class="bi bi-calendar-day-fill"></i>
                        <span><strong>@_stats.Today</strong> aujourd'hui</span>
                    </div>
                }
                <MudTooltip Text="Actualiser">
                    <button class="hero-btn-icon" @onclick="LoadDataAsync" disabled="@_loading">
                        <i class="bi bi-arrow-clockwise @(_loading ? "spinning" : "")"></i>
                    </button>
                </MudTooltip>
            </div>

        </div>
    </MudPaper>

    <!-- ============ FILTRES ============ -->
    <MudPaper Class="filters-card mb-3" Elevation="0">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <MudTextField @bind-Value="_search"
                              Placeholder="Rechercher dans les détails, ID acte..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Margin="Margin.Dense"
                              Immediate="true"
                              FullWidth="true" />
            </div>
            <div class="col-md-3">
                <MudSelect T="string"
                           @bind-Value="_actionFilter"
                           Label="Type d'action"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           FullWidth="true">
                    <MudSelectItem Value="@((string?)null)">Toutes</MudSelectItem>
                    <MudSelectItem Value="@("CREATION")">Création</MudSelectItem>
                    <MudSelectItem Value="@("SOUMISSION")">Soumission</MudSelectItem>
                    <MudSelectItem Value="@("VALIDATION")">Validation</MudSelectItem>
                    <MudSelectItem Value="@("REJET")">Rejet</MudSelectItem>
                    <MudSelectItem Value="@("REOUVERTURE")">Ré-ouverture</MudSelectItem>
                    <MudSelectItem Value="@("ARCHIVAGE")">Archivage</MudSelectItem>
                </MudSelect>
            </div>
            <div class="col-md-2">
                <MudDatePicker @bind-Date="_dateFrom"
                               Label="Depuis"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true" />
            </div>
            <div class="col-md-2">
                <MudDatePicker @bind-Date="_dateTo"
                               Label="Jusqu'à"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true" />
            </div>
            <div class="col-md-1 d-flex">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           OnClick="ResetFilters"
                           FullWidth="true">
                    Reset
                </MudButton>
            </div>
        </div>
    </MudPaper>

    <!-- ============ LISTE DES LOGS ============ -->
    @if (_loading)
    {
        <div class="text-center py-5">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (!FilteredLogs.Any())
    {
        <MudPaper Class="empty-state" Elevation="0">
            <div class="empty-state-icon">
                <i class="bi bi-journal-bookmark"></i>
            </div>
            <MudText Typo="Typo.h5" Class="mt-3" Style="color:#0F172A; font-weight:700;">
                Aucun événement trouvé
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                Modifiez vos filtres ou attendez de nouvelles actions.
            </MudText>
        </MudPaper>
    }
    else
    {
        <div class="timeline-container">
            @foreach (var dayGroup in GroupedLogs)
            {
                <!-- ═══ SÉPARATEUR DE JOUR ═══ -->
                <div class="day-divider @(IsToday(dayGroup.Key) ? "is-today" : "") @(IsYesterday(dayGroup.Key) ? "is-yesterday" : "")">
                    <div class="day-divider-line"></div>
                    <div class="day-badge">
                        <div class="day-badge-icon">
                            @if (IsToday(dayGroup.Key))
                            {
                                <i class="bi bi-broadcast"></i>
                            }
                            else if (IsYesterday(dayGroup.Key))
                            {
                                <i class="bi bi-arrow-counterclockwise"></i>
                            }
                            else
                            {
                                <i class="bi bi-calendar3"></i>
                            }
                        </div>
                        <div class="day-badge-text">
                            <span class="day-badge-label">@GetDayLabel(dayGroup.Key)</span>
                            @if (!IsToday(dayGroup.Key) && !IsYesterday(dayGroup.Key))
                            {
                                <span class="day-badge-date">@GetDayDateShort(dayGroup.Key)</span>
                            }
                            else
                            {
                                <span class="day-badge-date">@GetDayDateShort(dayGroup.Key)</span>
                            }
                        </div>
                        <div class="day-badge-count">
                            @dayGroup.Count() action@(dayGroup.Count() > 1 ? "s" : "")
                        </div>
                    </div>
                    <div class="day-divider-line"></div>
                </div>

                <!-- ═══ ACTIONS DU JOUR (avec ligne verticale connectée) ═══ -->
                <div class="day-events">
                    @foreach (var log in dayGroup.OrderByDescending(l => l.DateAction))
                    {
                        <div class="log-entry" @onclick="@(() => ShowActeHistory(log.IdActe))">
                            <div class="log-marker-wrap">
                                <div class="log-marker" style="background: @GetActionColor(log.Action);">
                                    <MudIcon Icon="@GetActionIcon(log.Action)"
                                             Style="color: white; font-size: 18px;" />
                                </div>
                            </div>

                            <div class="log-content">
                                <div class="log-header">
                                    <div class="log-action-info">
                                        <span class="log-action-label" style="color: @GetActionColor(log.Action);">
                                            @GetActionLabel(log.Action)
                                        </span>
                                        <span class="log-acte-link">
                                            <i class="bi bi-file-earmark-text"></i>
                                            Acte #@log.IdActe
                                        </span>
                                    </div>
                                    <span class="log-time">
                                        <i class="bi bi-clock"></i>
                                        @log.DateAction.ToLocalTime().ToString("HH:mm")
                                    </span>
                                </div>

                                @if (!string.IsNullOrEmpty(log.UserNomComplet))
                                {
                                    <div class="log-user">
                                        <i class="bi bi-person-circle"></i>
                                        <strong>@log.UserNomComplet</strong>
                                        @if (!string.IsNullOrEmpty(log.UserRole))
                                        {
                                            <span class="log-role-chip role-@(log.UserRole?.ToLower())">
                                                @GetRoleLabel(log.UserRole)
                                            </span>
                                        }
                                    </div>
                                }

                                @if (log.StatutAvant.HasValue && log.StatutApres.HasValue
                               && log.StatutAvant != log.StatutApres)
                                {
                                    <div class="log-transition">
                                        <ActeStatutBadge Statut="log.StatutAvant.Value" Size="Size.Small" />
                                        <i class="bi bi-arrow-right log-transition-arrow"></i>
                                        <ActeStatutBadge Statut="log.StatutApres.Value" Size="Size.Small" />
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(log.Details))
                                {
                                    <div class="log-details">
                                        <i class="bi bi-chat-square-quote"></i>
                                        <span>@log.Details</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

</MudContainer>

@code {
    private List<AuditLogEntry> _logs = new();
    private AuditLogStats _stats = new();
    private bool _loading = true;
    private bool _isAgent = false;
    private int? _currentUserId;

    // Filtres
    private string _search = "";
    private string? _actionFilter;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    private IEnumerable<AuditLogEntry> FilteredLogs
    {
        get
        {
            IEnumerable<AuditLogEntry> filtered = _logs;

            if (!string.IsNullOrWhiteSpace(_actionFilter))
                filtered = filtered.Where(l => l.Action == _actionFilter);

            if (_dateFrom.HasValue)
                filtered = filtered.Where(l => l.DateAction.Date >= _dateFrom.Value.Date);

            if (_dateTo.HasValue)
                filtered = filtered.Where(l => l.DateAction.Date <= _dateTo.Value.Date);

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim().ToLowerInvariant();
                filtered = filtered.Where(l =>
                    l.IdActe.ToString().Contains(s) ||
                    (l.Details ?? "").ToLowerInvariant().Contains(s) ||
                    (l.UserNomComplet ?? "").ToLowerInvariant().Contains(s) ||
                    GetActionLabel(l.Action).ToLowerInvariant().Contains(s));
            }

            return filtered;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await IdentifyCurrentUserAsync();
        await LoadDataAsync();
    }

    private async Task IdentifyCurrentUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var nameIdentifier = user.Claims
            .FirstOrDefault(c => c.Type.Contains("nameidentifier"))?.Value;

        if (int.TryParse(nameIdentifier, out var id))
            _currentUserId = id;

        _isAgent = user.IsInRole(RoleNames.Agent)
                   && !user.IsInRole(RoleNames.Admin)
                   && !user.IsInRole(RoleNames.Responsable);
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            // Si Agent, on restreint à ses actes
            var filter = new AuditLogFilter
                {
                    RestrictToAgentId = _isAgent ? _currentUserId : null
                };

            _logs = await AuditService.GetAllAsync(filter);
            _stats = await AuditService.GetStatsAsync(_isAgent ? _currentUserId : null);
        }
        catch (Exception ex)
        {
            // log silencieux
            Console.WriteLine($"Erreur chargement historique : {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ResetFilters()
    {
        _search = "";
        _actionFilter = null;
        _dateFrom = null;
        _dateTo = null;
    }

    private async Task ShowActeHistory(int acteId)
    {
        var parameters = new DialogParameters { ["ActeId"] = acteId };
        var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true
            };

        await DialogService.ShowAsync<GesCPSI_Project.Components.Dialogs.ActeHistoryDialog>(
            $"Historique acte #{acteId}", parameters, options);
    }

    // ============ HELPERS UI ============
    private static string GetActionLabel(string action) => action switch
    {
        "CREATION" => "Création",
        "SOUMISSION" => "Envoyé en validation",
        "VALIDATION" => "Validé",
        "REJET" => "Rejeté",
        "REOUVERTURE" => "Ré-ouvert",
        "ARCHIVAGE" => "Archivé",
        _ => action
    };

    private static string GetActionIcon(string action) => action switch
    {
        "CREATION" => Icons.Material.Filled.Add,
        "SOUMISSION" => Icons.Material.Filled.Send,
        "VALIDATION" => Icons.Material.Filled.CheckCircle,
        "REJET" => Icons.Material.Filled.Cancel,
        "REOUVERTURE" => Icons.Material.Filled.Refresh,
        "ARCHIVAGE" => Icons.Material.Filled.Archive,
        _ => Icons.Material.Filled.Circle
    };

    private static string GetActionColor(string action) => action switch
    {
        "CREATION" => "#5E6B7D",
        "SOUMISSION" => "#D97706",
        "VALIDATION" => "#0E7C5C",
        "REJET" => "#9B1C2D",
        "REOUVERTURE" => "#D97706",
        "ARCHIVAGE" => "#1F3C88",
        _ => "#5E6B7D"
    };

    private static string GetRoleLabel(string? role) => role switch
    {
        RoleNames.Admin => "Admin",
        RoleNames.Agent => "Agent",
        RoleNames.Responsable => "Responsable",
        _ => role ?? "—"
    };

    private static Color GetRoleColor(string? role) => role switch
    {
        RoleNames.Admin => Color.Error,
        RoleNames.Agent => Color.Info,
        RoleNames.Responsable => Color.Success,
        _ => Color.Default
    };

    // ════════════════════════════════════════════════
    // HELPERS pour la timeline groupée par jour
    // ════════════════════════════════════════════════

    private List<IGrouping<DateTime, AuditLogEntry>> GroupedLogs =>
        FilteredLogs
            .GroupBy(l => l.DateAction.ToLocalTime().Date)
            .OrderByDescending(g => g.Key)
            .ToList();

    private string GetDayLabel(DateTime date)
    {
        var today = DateTime.Now.Date;
        var diff = (today - date).Days;

        if (diff == 0) return "Aujourd'hui";
        if (diff == 1) return "Hier";
        if (diff < 7) return $"Il y a {diff} jours";

        // Jour de la semaine en français
        var culture = new System.Globalization.CultureInfo("fr-FR");
        return culture.TextInfo.ToTitleCase(date.ToString("dddd d MMMM yyyy", culture));
    }

    private string GetDayDateShort(DateTime date)
    {
        var culture = new System.Globalization.CultureInfo("fr-FR");
        return date.ToString("d MMM yyyy", culture);
    }

    private bool IsToday(DateTime date) => date.Date == DateTime.Now.Date;
    private bool IsYesterday(DateTime date) => date.Date == DateTime.Now.Date.AddDays(-1);

    private string GetRelativeHour(DateTime date)
    {
        var diff = DateTime.UtcNow - date;
        if (diff.TotalMinutes < 1) return "À l'instant";
        if (diff.TotalMinutes < 60) return $"Il y a {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24) return $"Il y a {(int)diff.TotalHours}h";
        return date.ToLocalTime().ToString("HH:mm");
    }
}

<style>
    /* ============ HEADER COMPACT (harmonisé avec listAct/validationAct/archives) ============ */
    .history-hero {
        background: radial-gradient(700px 350px at 85% 30%, rgba(201, 168, 106, 0.12), transparent 60%), radial-gradient(500px 300px at 15% 80%, rgba(20, 165, 116, 0.15), transparent 65%), linear-gradient(135deg, #0A2922 0%, #0E7C5C 60%, #14A574 100%) !important;
        padding: 22px 28px !important;
        border-radius: 16px !important;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(14, 124, 92, 0.2);
    }

        .history-hero::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent 0%, rgba(201, 168, 106, 0.4) 25%, rgba(201, 168, 106, 0.7) 50%, rgba(201, 168, 106, 0.4) 75%, transparent 100%);
