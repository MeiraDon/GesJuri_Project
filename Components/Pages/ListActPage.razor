    private static string GetInitialsFromText(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || text == "Non spécifié")
            return "?";

        // Prendre uniquement la première ligne (au cas où c'est multi-lignes)
        var firstLine = text.Split('\n')[0].Trim();
        var parts = firstLine.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return (parts[0][..1] + parts[1][..1]).ToUpper();

        return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
    }

    private (string cssClass, string icon, string label) GetStatutVisual(ActeStatut statut) => statut switch
    {
        ActeStatut.Brouillon => ("status-draft", "bi-pencil-square", "Brouillon"),
        ActeStatut.EnAttenteValidation => ("status-pending", "bi-hourglass-split", "En attente"),
        ActeStatut.Valide => ("status-valid", "bi-check-circle-fill", "Validé"),
        ActeStatut.Rejete => ("status-rejected", "bi-x-circle-fill", "Rejeté"),
        ActeStatut.Archive => ("status-archived", "bi-archive-fill", "Archivé"),
        _ => ("status-unknown", "bi-question-circle", "Inconnu")
    };


    // Helper : avatar avec dégradé basé sur l'ID
    private static string GetAvatarGradient(int id)
    {
        var gradients = new[]
        {
        "linear-gradient(135deg, #0A2540, #1F3C88)",
        "linear-gradient(135deg, #0E7C5C, #2F5D50)",
        "linear-gradient(135deg, #1F3C88, #3F3A8A)",
        "linear-gradient(135deg, #C9A86A, #B58E50)",
        "linear-gradient(135deg, #9B1C2D, #7A1623)",
        "linear-gradient(135deg, #D97706, #B45309)"
    };
        return gradients[Math.Abs(id) % gradients.Length];
    }

    // Helper : temps relatif "il y a Xh"
    private static string GetRelativeTime(DateTime date)
    {
        var diff = DateTime.UtcNow - date;

        if (diff.TotalMinutes < 1) return "À l'instant";
        if (diff.TotalMinutes < 60) return $"Il y a {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24) return $"Il y a {(int)diff.TotalHours}h";
        if (diff.TotalDays < 7) return $"Il y a {(int)diff.TotalDays}j";
        if (diff.TotalDays < 30) return $"Il y a {(int)(diff.TotalDays / 7)} sem";

        return date.ToLocalTime().ToString("dd/MM/yyyy");
    }


    // 🆕 Compte les actes pour chaque onglet, en respectant le filtrage par rôle
    private int GetCountForTab(int tabIndex)
    {
        IEnumerable<TypesActModel> source = _actes
            .Where(a => a.StatutWorkflow != ActeStatut.Archive);

        // Appliquer le filtre par rôle
        if (_isResponsable && !_isAdmin)
        {
            source = source.Where(a =>
                a.StatutWorkflow == ActeStatut.EnAttenteValidation
                || a.StatutWorkflow == ActeStatut.Valide);
        }

        // Si Agent : restriction à ses propres actes
        if (_isAgent && _currentUserId.HasValue)
        {
            source = source.Where(a => a.IdUser == _currentUserId.Value);
        }

        return tabIndex switch
        {
            0 => source.Count(),  // Tous
            1 => source.Count(a => a.StatutWorkflow == ActeStatut.Brouillon),
            2 => source.Count(a => a.StatutWorkflow == ActeStatut.EnAttenteValidation),
            3 => source.Count(a => a.StatutWorkflow == ActeStatut.Valide),
            4 => source.Count(a => a.StatutWorkflow == ActeStatut.Rejete),
            _ => 0
        };
    }



