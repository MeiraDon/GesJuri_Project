@page "/listAct"
@rendermode InteractiveServer

<PageTitle>Gestion des Actes - Tableau de bord</PageTitle>

@using GesCPSI_Project.Models
@using GesCPSI_Project.Interfaces
@using GesCPSI_Project.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject ITypesAct TypesActService
@inject IClientAct ClientActService
@inject IRolesClientAct RolesClientActService
@inject IClient ClientService
@inject IAjoutAct AjoutActService
@inject ICautionnement CautionnementService
@inject IPret PretService
@inject ICharge ChargeService
@inject IAutorisation AutorisationService
@inject IEntiteJur EntiteJurService
@inject IActeWorkflow WorkflowService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">

    <div class="listact-page">

        <!-- ═════════════ HEADER DÉGRADÉ MARINE ═════════════ -->
        <MudPaper Class="listact-hero" Elevation="0">
            <div class="hero-bg-deco"></div>
            <div class="hero-content">
                <div class="hero-main">
                    <div class="hero-icon-wrap">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                    <div class="hero-text">
                        <h1 class="hero-title">Gestion des Actes</h1>
                        <p class="hero-meta">
                            <span class="meta-strong">@_actes.Count(a => a.StatutWorkflow != ActeStatut.Archive) actes</span>
                            <span class="meta-sep">·</span>
                            <span>@_actes.Count(a => a.StatutWorkflow == ActeStatut.Brouillon || a.StatutWorkflow == ActeStatut.EnAttenteValidation) en cours</span>
                            <span class="meta-sep">·</span>
                            <span class="meta-live">
                                <span class="live-dot"></span>
                                Mises à jour en temps réel
                            </span>
                        </p>
                    </div>
                </div>

                <div class="hero-actions">
                    <MudTooltip Text="Actualiser">
                        <button class="hero-btn-icon" @onclick="ReloadAsync" disabled="@_loading">
                            <i class="bi bi-arrow-clockwise @(_loading ? "spinning" : "")"></i>
                        </button>
                    </MudTooltip>
                    <button class="hero-btn-primary" @onclick='() => NavigationManager.NavigateTo("/choisirAct")'>
                        <i class="bi bi-plus-lg"></i>
                        <span>Nouvel acte</span>
                    </button>
                </div>
            </div>
        </MudPaper>

        <!-- ═════════════ STATS CARDS (5 colonnes garanties) ═════════════ -->
        <div class="stats-grid-5">

            <MudCard Elevation="2" Class="rounded-lg mud-theme-primary hover-lift stat-mini-card">
                <MudCardContent>
                    <div class="stat-mini-content">
                        <div class="stat-mini-text">
                            <div class="stat-mini-value">@_actes.Count(a => a.StatutWorkflow != ActeStatut.Archive)</div>
                            <div class="stat-mini-label">Total des Actes</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="stat-mini-icon" />
                    </div>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="2" Class="rounded-lg mud-theme-secondary hover-lift stat-mini-card">
                <MudCardContent>
                    <div class="stat-mini-content">
                        <div class="stat-mini-text">
                            <div class="stat-mini-value">@_actes.Count(a => a.StatutWorkflow == ActeStatut.Brouillon)</div>
                            <div class="stat-mini-label">Brouillons</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="stat-mini-icon" />
                    </div>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="2" Class="rounded-lg mud-theme-warning hover-lift stat-mini-card">
                <MudCardContent>
                    <div class="stat-mini-content">
                        <div class="stat-mini-text">
                            <div class="stat-mini-value">@_actes.Count(a => a.StatutWorkflow == ActeStatut.EnAttenteValidation)</div>
                            <div class="stat-mini-label">En attente</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.PendingActions" Class="stat-mini-icon" />
                    </div>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="2" Class="rounded-lg mud-theme-success hover-lift stat-mini-card">
                <MudCardContent>
                    <div class="stat-mini-content">
                        <div class="stat-mini-text">
                            <div class="stat-mini-value">@_actes.Count(a => a.StatutWorkflow == ActeStatut.Valide)</div>
                            <div class="stat-mini-label">Validés</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="stat-mini-icon" />
                    </div>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="2" Class="rounded-lg mud-theme-error hover-lift stat-mini-card">
                <MudCardContent>
                    <div class="stat-mini-content">
                        <div class="stat-mini-text">
                            <div class="stat-mini-value">@_actes.Count(a => a.StatutWorkflow == ActeStatut.Rejete)</div>
                            <div class="stat-mini-label">Rejetés</div>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Class="stat-mini-icon" />
                    </div>
                </MudCardContent>
            </MudCard>

        </div>

        <!-- ═════════════ TABS MODERNES ═════════════ -->
        <!-- ═════════════ TABS MODERNES ═════════════ -->
        <div class="custom-tabs">
            @* Onglet "Tous" : visible pour tous *@
            <button class="custom-tab @(_activeTabIndex == 0 ? "active" : "")" @onclick="@(() => { _activeTabIndex = 0; })">
                <i class="bi bi-grid-3x3"></i>
                <span>Tous</span>
                <span class="custom-tab-count">@GetCountForTab(0)</span>
            </button>

            @* Onglet "Brouillons" : caché pour le Responsable *@
            @if (!_isResponsable || _isAdmin)
            {
                <button class="custom-tab @(_activeTabIndex == 1 ? "active" : "")" @onclick="@(() => { _activeTabIndex = 1; })">
                    <i class="bi bi-pencil-square"></i>
                    <span>Brouillons</span>
                    <span class="custom-tab-count">@GetCountForTab(1)</span>
                </button>
            }

            @* Onglet "En attente" : visible pour tous *@
            <button class="custom-tab @(_activeTabIndex == 2 ? "active" : "")" @onclick="@(() => { _activeTabIndex = 2; })">
                <i class="bi bi-hourglass-split"></i>
                <span>En attente</span>
                <span class="custom-tab-count">@GetCountForTab(2)</span>
            </button>

            @* Onglet "Validés" : visible pour tous *@
            <button class="custom-tab @(_activeTabIndex == 3 ? "active" : "")" @onclick="@(() => { _activeTabIndex = 3; })">
                <i class="bi bi-check-circle"></i>
                <span>Validés</span>
                <span class="custom-tab-count">@GetCountForTab(3)</span>
            </button>

            @* Onglet "Rejetés" : caché pour le Responsable *@
            @if (!_isResponsable || _isAdmin)
            {
                <button class="custom-tab @(_activeTabIndex == 4 ? "active" : "")" @onclick="@(() => { _activeTabIndex = 4; })">
                    <i class="bi bi-x-circle"></i>
                    <span>Rejetés</span>
                    <span class="custom-tab-count">@GetCountForTab(4)</span>
                </button>
            }
        </div>

        <!-- ═════════════ FILTRES ÉQUILIBRÉS ═════════════ -->
        <div class="listact-filters">

            <!-- Groupe gauche : filtres -->
            <div class="filters-group">

                <div class="filter-search">
                    <i class="bi bi-search filter-search-icon"></i>
                    <input type="text"
                           class="filter-search-input"
                           placeholder="Rechercher par ID, type, débiteur ou caution..."
                           @bind="_search"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(_search))
                    {
                        <button class="filter-search-clear" @onclick='() => _search = ""'>
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>

                <div class="filter-type">
                    <MudSelect T="int?" @bind-Value="_selectedTypeId"
                               Placeholder="Tous les types"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true"
                               FullWidth="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">Tous les types</MudSelectItem>
                        @foreach (var type in _acteTypes)
                        {
                            <MudSelectItem T="int?" Value="@((int?)type.IdAjout)">@type.NomAct</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                @if (!_isAgent)
                {
                    <label class="filter-pill-toggle @(_showOnlyMine ? "active" : "")">
                        <input type="checkbox" @bind="_showOnlyMine" />
                        <i class="bi @(_showOnlyMine ? "bi-person-fill-check" : "bi-people-fill")"></i>
                        <span>Mes actes</span>
                        @if (_showOnlyMine && _currentUserId.HasValue)
                        {
                            <span class="filter-pill-count">
                                @_actes.Count(a => a.IdUser == _currentUserId.Value && a.StatutWorkflow != ActeStatut.Archive)
                            </span>
                        }
                    </label>
                }

            </div>

            <!-- Séparateur visuel -->
            <div class="filters-divider"></div>

            <!-- Groupe droite : reset -->
            <div class="filters-action">
                <MudTooltip Text="Réinitialiser tous les filtres" Placement="Placement.Top">
                    <button class="filter-reset-pro" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </MudTooltip>
            </div>

        </div>

        <!-- ═════════════ TABLE ═════════════ -->
        @if (_loading)
        {
            <div class="loading-zone">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                <p>Chargement des actes...</p>
            </div>
        }
        else if (!FilteredActes.Any())
        {
            <div class="empty-zone">
                <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                <div class="empty-title">Aucun acte trouvé</div>
                <div class="empty-subtitle">Modifie tes filtres ou crée un nouvel acte</div>
                <button class="empty-action" @onclick='() => NavigationManager.NavigateTo("/choisirAct")'>
                    <i class="bi bi-plus-lg"></i>
                    <span>Créer un acte</span>
                </button>
            </div>
        }
        else
        {
            <MudPaper Class="listact-table-card" Elevation="0">
                <MudTable Items="FilteredActes"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          Dense="false"
                          RowsPerPage="15"
                          Class="listact-table">

                    <HeaderContent>
                        <MudTh>Acte</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh>Débiteur</MudTh>
                        <MudTh>Caution</MudTh>
                        <MudTh>Statut</MudTh>
                        <MudTh>Mise à jour</MudTh>
                        <MudTh Style="text-align:right;">Actions</MudTh>
                    </HeaderContent>

                    <RowTemplate Context="acte">

                        @{
                            var (statutClass, statutIcon, statutLabel) = GetStatutVisual(acte.StatutWorkflow);
                        }

                        <MudTd>
                            <div class="acte-cell">
                                <div class="acte-avatar" style="background: @GetAvatarGradient(acte.IdActe);">
                                    <i class="bi bi-file-earmark-text-fill"></i>
                                </div>
                                <div class="acte-info">
                                    <div class="acte-id">#@acte.IdActe</div>
                                    <div class="acte-sub">Créé le @acte.DateCreation.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                        </MudTd>

                        <MudTd>
                            <span class="type-pill">@acte.NomTypesActe</span>
                        </MudTd>

                        <MudTd>
                            <span class="party-name">@GetDebiteurName(acte.IdActe)</span>
                        </MudTd>

                        <MudTd>
                            <span class="party-name">@GetCautionName(acte.IdActe)</span>
                        </MudTd>

                        <MudTd>
                            <div class="status-cell">
                                <span class="custom-status-badge @statutClass">
                                    @if (acte.StatutWorkflow == ActeStatut.EnAttenteValidation)
                                    {
                                        <span class="status-dot-anim"></span>
                                    }
                                    else
                                    {
                                        <i class="bi @statutIcon"></i>
                                    }
                                    <span>@statutLabel</span>
                                </span>
                                @if (acte.StatutWorkflow == ActeStatut.Rejete && !string.IsNullOrWhiteSpace(acte.MotifRejet))
                                {
                                    <MudTooltip Text="@($"Motif : {acte.MotifRejet}")" Placement="Placement.Top">
                                        <span class="status-info-icon">
                                            <i class="bi bi-info-circle-fill"></i>
                                        </span>
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>

                        <MudTd>
                            <div class="maj-cell">
                                <div class="maj-relative">@GetRelativeTime(acte.DateMaj)</div>
                                <div class="maj-absolute">@acte.DateMaj.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </MudTd>

                        <MudTd Style="text-align:right;">
                            <div class="actions-group">

                                <MudTooltip Text="Aperçu" Placement="Placement.Top">
                                    <button class="action-btn action-btn-view" @onclick="@(() => PreviewActe(acte))">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                </MudTooltip>

                                <MudTooltip Text="@(CanEditActe(acte) ? "Modifier" : "Modification impossible")" Placement="Placement.Top">
                                    <button class="action-btn action-btn-edit"
                                            @onclick="@(() => Edit(acte))"
                                            disabled="@(!CanEditActe(acte))">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                </MudTooltip>

                                @if (!string.IsNullOrWhiteSpace(acte.PdfGenerePath))
                                {
                                    <MudTooltip Text="Télécharger PDF" Placement="Placement.Top">
                                        <button class="action-btn action-btn-download" @onclick="@(() => DownloadPdf(acte))">
                                            <i class="bi bi-download"></i>
                                        </button>
                                    </MudTooltip>
                                }

                                @* 🔒 Téléverser le document signé : visible UNIQUEMENT si le PDF a été généré
   (sinon on ne peut pas télécharger pour signer, donc on ne peut pas téléverser non plus) *@
                                @if (acte.StatutWorkflow == ActeStatut.Valide && !string.IsNullOrWhiteSpace(acte.PdfGenerePath))
                                {
                                    <AuthorizeView Roles="@($"{RoleNames.Admin},{RoleNames.Responsable}")">
                                        <MudTooltip Text="Téléverser le document signé" Placement="Placement.Top">
                                            <button class="action-btn action-btn-upload" @onclick="@(() => OpenUploadDialogAsync(acte))">
                                                <i class="bi bi-cloud-upload-fill"></i>
                                            </button>
                                        </MudTooltip>
                                    </AuthorizeView>
                                }

                                <MudTooltip Text="Envoyer au responsable" Placement="Placement.Top">
                                    <button class="action-btn action-btn-send"
                                            @onclick="@(() => SendActeAsync(acte))"
                                            disabled="@(_loading || !CanSendActe(acte))">
                                        <i class="bi bi-send-fill"></i>
                                    </button>
                                </MudTooltip>

                                @if (acte.StatutWorkflow == ActeStatut.Rejete)
                                {
                                    <MudTooltip Text="Ré-ouvrir l'acte" Placement="Placement.Top">
                                        <button class="action-btn action-btn-reopen"
                                                @onclick="@(() => RouvrirActeAsync(acte))"
                                                disabled="@_loading">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </MudTooltip>
                                }

                                <MudTooltip Text="@(CanDeleteActe(acte) ? "Supprimer" : "Suppression impossible")" Placement="Placement.Top">
                                    <button class="action-btn action-btn-delete"
                                            @onclick="@(() => ConfirmDelete(acte))"
                                            disabled="@(!CanDeleteActe(acte))">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </MudTooltip>

                            </div>
                        </MudTd>
                    </RowTemplate>

                    <PagerContent>
                        <MudTablePager PageSizeOptions="new[]{10, 25, 50}" />
                    </PagerContent>
                </MudTable>
            </MudPaper>
        }

    </div>

</MudContainer>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<TypesActModel> _actes = new();
    private bool _loading = true;

    private bool _showOnlyMine = false;
    private int? _currentUserId;
    private bool _isAgent = false;
    private bool _isResponsable = false;  // 🆕
    private bool _isAdmin = false;        // 🆕

    private string _search = "";
    private ActeStatut? _statutFilterEnum = null;
    private string? _statutFilter = null; // (gardé pour compat, mais inutilisé)
    private int? _selectedTypeId = null;
    private int _activeTabIndex = 0;

    private List<AjoutActModel> _acteTypes = new();

    private Dictionary<int, string> _debiteurs = new();
    private Dictionary<int, string> _cautions = new();

    private List<TypesActModel> FilteredActes => GetFilteredActes();

    protected override async Task OnInitializedAsync()
    {
        await IdentifyCurrentUserAsync();
        await LoadDataAsync();
    }

    private async Task IdentifyCurrentUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var nameIdentifier = user.Claims
                .FirstOrDefault(c => c.Type.Contains("nameidentifier"))?.Value;

            if (int.TryParse(nameIdentifier, out var id))
                _currentUserId = id;

            // 🆕 Détection des rôles
            _isAgent = user.IsInRole(RoleNames.Agent);
            _isResponsable = user.IsInRole(RoleNames.Responsable);
            _isAdmin = user.IsInRole(RoleNames.Admin);

            if (_isAgent)
                _showOnlyMine = true;
        }
    }

    private bool _disposed;
    private CancellationTokenSource? _cts = new CancellationTokenSource();

    [Parameter, SupplyParameterFromQuery(Name = "refresh")]
    public int? Refresh { get; set; }


    protected override async Task OnParametersSetAsync()
    {
        if (Refresh == 1)
        {
            await LoadDataAsync();

            // ✅ Nettoyage: évite refresh infini au F5
            NavigationManager.NavigateTo("/listAct", replace: true);
        }
    }

    private static string FormatClientDisplay(ClientModel? client)
    {
        if (client is null)
            return "Non spécifié";

        if (string.Equals(client.TypeClient, "Personne Morale", StringComparison.OrdinalIgnoreCase))
        {
            var lignes = new List<string>();

            if (!string.IsNullOrWhiteSpace(client.NomRaisonsociale))
                lignes.Add(client.NomRaisonsociale.Trim());
            else
                lignes.Add("Personne morale");

            if (!string.IsNullOrWhiteSpace(client.NomRepresentant))
                lignes.Add($"Représentant : {client.NomRepresentant.Trim()}");

            if (!string.IsNullOrWhiteSpace(client.NumCompte))
                lignes.Add($"Compte : {client.NumCompte.Trim()}");

            return string.Join("\n", lignes);
        }
        else
        {
            var lignes = new List<string>();

            var nomComplet = $"{client.Nom} {client.Prenoms}".Trim();

            if (!string.IsNullOrWhiteSpace(nomComplet))
                lignes.Add(nomComplet);
            else if (!string.IsNullOrWhiteSpace(client.NomRepresentant))
                lignes.Add(client.NomRepresentant.Trim());
            else
                lignes.Add("Personne physique");

            if (!string.IsNullOrWhiteSpace(client.NumCompte))
                lignes.Add($"Compte : {client.NumCompte.Trim()}");

            return string.Join("\n", lignes);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        try { _cts?.Cancel(); } catch { }
        _cts?.Dispose();
    }

    private Task SafeStateHasChanged()
    {
        if (_disposed) return Task.CompletedTask;
        return InvokeAsync(StateHasChanged);
    }

    private readonly SemaphoreSlim _loadLock = new(1, 1);

    private async Task LoadDataAsync()
    {
        await _loadLock.WaitAsync();
        try
        {
            _loading = true;
            await SafeStateHasChanged();

            // ✅ IMPORTANT : séquentiel (pas de WhenAll, pas de tasks EF en parallèle)
            _actes = await TypesActService.GetAllAsync() ?? new List<TypesActModel>();
            _acteTypes = await AjoutActService.GetAllAsync() ?? new List<AjoutActModel>();

            await LoadActeParticipantsAsync();
        }
        catch (OperationCanceledException)
        {
            // normal si tu quittes la page
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur chargement : {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            _loadLock.Release();
            await SafeStateHasChanged();
        }
    }

    private async Task ReloadAsync()
    {
        await LoadDataAsync();
        Snackbar.Add("Liste actualisée", Severity.Success);
    }

    private async Task LoadActeParticipantsAsync()
    {
        var links = await ClientActService.GetAllAsync() ?? new List<ClientActModel>();
        var roles = await RolesClientActService.GetAllAsync() ?? new List<RolesClientActModel>();
        var clients = await ClientService.GetAllAsync() ?? new List<ClientModel>();

        var roleDebiteurIds = roles
            .Where(r => !string.IsNullOrWhiteSpace(r.Libelle) &&
                        (string.Equals(r.Libelle.Trim(), "Debiteur", StringComparison.OrdinalIgnoreCase) ||
                         string.Equals(r.Libelle.Trim(), "Débiteur", StringComparison.OrdinalIgnoreCase)))
            .Select(r => r.IdRole)
            .ToHashSet();

        var roleCautionIds = roles
            .Where(r => !string.IsNullOrWhiteSpace(r.Libelle) &&
                        string.Equals(r.Libelle.Trim(), "Caution", StringComparison.OrdinalIgnoreCase))
            .Select(r => r.IdRole)
            .ToHashSet();

        _debiteurs.Clear();
        _cautions.Clear();

        foreach (var link in links)
        {
            var client = clients.FirstOrDefault(c => c.IdClt == link.IdClt);
            var display = FormatClientDisplay(client);

            if (roleDebiteurIds.Contains(link.IdRole) && !_debiteurs.ContainsKey(link.IdActe))
            {
                _debiteurs[link.IdActe] = display;
            }

            if (roleCautionIds.Contains(link.IdRole) && !_cautions.ContainsKey(link.IdActe))
            {
                _cautions[link.IdActe] = display;
            }
        }
    }

    private List<TypesActModel> GetFilteredActes()
    {
        // 🆕 EXCLURE les actes archivés (ils ont leur propre page /archives)
        IEnumerable<TypesActModel> filtered = _actes
            .Where(a => a.StatutWorkflow != ActeStatut.Archive);

        // 🔒 FILTRE PAR RÔLE
        // - Agent : voit ses propres actes dans tous les statuts (sauf Archive)
        // - Responsable : voit UNIQUEMENT les actes En attente et Validés
        // - Admin : voit tout
        if (_isResponsable && !_isAdmin)
        {
            filtered = filtered.Where(a =>
                a.StatutWorkflow == ActeStatut.EnAttenteValidation
                || a.StatutWorkflow == ActeStatut.Valide);
        }

        // Tabs (4 panneaux - plus d'archivés)
        filtered = _activeTabIndex switch
        {
            1 => filtered.Where(a => a.StatutWorkflow == ActeStatut.Brouillon),
            2 => filtered.Where(a => a.StatutWorkflow == ActeStatut.EnAttenteValidation),
            3 => filtered.Where(a => a.StatutWorkflow == ActeStatut.Valide),
            4 => filtered.Where(a => a.StatutWorkflow == ActeStatut.Rejete),
            _ => filtered
        };

        // Filtre Statut (combobox)
        if (_statutFilterEnum.HasValue)
            filtered = filtered.Where(a => a.StatutWorkflow == _statutFilterEnum.Value);

        /// Filtre "Mes actes"
        // 🔒 SÉCURITÉ : l'Agent ne voit JAMAIS les actes des autres,
        // même s'il décoche le checkbox
        if (_isAgent && _currentUserId.HasValue)
        {
            filtered = filtered.Where(a => a.IdUser == _currentUserId.Value);
        }
        else if (_showOnlyMine && _currentUserId.HasValue)
        {
            // Admin/Resp : checkbox optionnel
            filtered = filtered.Where(a => a.IdUser == _currentUserId.Value);
        }

        // Type
        if (_selectedTypeId.HasValue)
            filtered = filtered.Where(a => a.IdAjout == _selectedTypeId.Value);

        // Search
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim().ToLowerInvariant();
            filtered = filtered.Where(a =>
                a.IdActe.ToString().Contains(s) ||
                (a.NomTypesActe ?? "").ToLowerInvariant().Contains(s) ||
                ActeStatutHelper.GetLabel(a.StatutWorkflow).ToLowerInvariant().Contains(s) ||
                GetDebiteurName(a.IdActe).ToLowerInvariant().Contains(s) ||
                GetCautionName(a.IdActe).ToLowerInvariant().Contains(s));
        }

        return filtered.OrderByDescending(a => a.DateMaj).ToList();
    }

