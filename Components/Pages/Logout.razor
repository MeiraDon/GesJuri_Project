@page "/logout"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<div class="logout-page">
    <div class="logout-bg-gradient"></div>
    <div class="logout-bg-glow"></div>

    <div class="logout-card">
        <div class="logout-icon-wrap">
            <i class="bi bi-box-arrow-right"></i>
        </div>

        <div class="logout-spinner">
            <div class="spinner-ring"></div>
            <div class="spinner-ring spinner-ring-delay"></div>
        </div>

        <h2 class="logout-title">À bientôt</h2>
        <p class="logout-subtitle">Déconnexion en cours, vous êtes redirigé...</p>

        <div class="logout-bank-tag">
            <span class="bank-dot"></span>
            <span>GesCPSI · BOA-TOGO</span>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Petite pause pour que l'utilisateur voie la transition (UX)
        await Task.Delay(1200);

        // Redirection vers l'endpoint HTTP qui fait le vrai SignOut (force reload nécessaire)
        Navigation.NavigateTo("/account/signout", forceLoad: true);
    }
}

<style>
    .logout-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0A2922 0%, #0E7C5C 60%, #14A574 100%);
        position: relative;
        overflow: hidden;
        font-family: 'Inter', sans-serif;
    }

    .logout-bg-gradient {
        position: absolute;
        inset: 0;
        background: radial-gradient(700px 350px at 90% 20%, rgba(252, 211, 77, 0.18), transparent 60%), radial-gradient(500px 280px at 10% 90%, rgba(20, 165, 116, 0.3), transparent 65%);
        pointer-events: none;
    }

    .logout-bg-glow {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent 0%, rgba(252, 211, 77, 0.7) 50%, transparent 100%);
    }

    .logout-card {
        background: white;
        padding: 48px 56px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 25px 60px rgba(10, 41, 34, 0.4);
        position: relative;
        z-index: 1;
        min-width: 380px;
        animation: card-appear 0.5s ease-out;
    }

    @@keyframes card-appear {
        from {
            opacity: 0;
            transform: translateY(10px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .logout-icon-wrap {
        width: 72px;
        height: 72px;
        margin: 0 auto 22px;
        border-radius: 18px;
        background: linear-gradient(135deg, #5E6B7D, #0A2540);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #FCD34D;
        font-size: 1.9rem;
        box-shadow: 0 10px 24px rgba(10, 37, 64, 0.3);
    }

    .logout-spinner {
        position: relative;
        width: 56px;
        height: 56px;
        margin: 0 auto 22px;
    }

    .spinner-ring {
        position: absolute;
        inset: 0;
        border: 3px solid transparent;
        border-top-color: #14A574;
        border-right-color: #14A574;
        border-radius: 50%;
        animation: ring-spin 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    }

    .spinner-ring-delay {
        border-top-color: #FCD34D;
        border-right-color: #FCD34D;
        opacity: 0.5;
        animation-delay: -0.6s;
        animation-duration: 1.8s;
    }

    @@keyframes ring-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .logout-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #0A2540;
        margin: 0 0 8px;
        letter-spacing: -0.4px;
    }

    .logout-subtitle {
        color: #5E6B7D;
        font-size: 0.92rem;
        font-weight: 500;
        margin: 0 0 24px;
    }

    .logout-bank-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #F8FAFC;
        border: 1px solid #E5E7EB;
        padding: 7px 14px;
        border-radius: 20px;
        color: #475569;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.6px;
    }

    .bank-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #14A574;
        box-shadow: 0 0 8px rgba(20, 165, 116, 0.6);
        animation: bank-pulse 1.6s ease-in-out infinite;
    }

    @@keyframes bank-pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.5;
            transform: scale(1.3);
        }
    }
</style>