@page "/parametres"
@attribute [Authorize(Roles = RoleNames.Admin)]
@rendermode InteractiveServer

@using GesCPSI_Project.Models
@using MudBlazor

@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Paramètres — GesCPSI</PageTitle>

<div class="settings-cockpit">

    <!-- ═════════════ HEADER CYBER (multicolore unique) ═════════════ -->
    <div class="cockpit-hero">
        <div class="cyber-grid"></div>
        <div class="cyber-orb cyber-orb-1"></div>
        <div class="cyber-orb cyber-orb-2"></div>
        <div class="cyber-orb cyber-orb-3"></div>

        <div class="hero-content">
            <div class="hero-main">
                <div class="hero-icon-cyber">
                    <div class="icon-pulse"></div>
                    <i class="bi bi-sliders"></i>
                </div>
                <div>
                    <div class="hero-eyebrow">
                        <span class="cyber-dot"></span>
                        <span>PANNEAU DE CONTRÔLE</span>
                        <span class="cyber-status">SYSTÈME ACTIF</span>
                    </div>
                    <h1 class="hero-title">Paramètres</h1>
                    <p class="hero-meta">
                        Configuration globale de l'application
                        <span class="meta-sep">·</span>
                        <span class="admin-badge">
                            <i class="bi bi-shield-fill-check"></i>
                            Admin
                        </span>
                    </p>
                </div>
            </div>

            <div class="hero-actions">
                <div class="system-info">
                    <div class="system-info-item">
                        <i class="bi bi-cpu"></i>
                        <div>
                            <div class="info-value">v2.4.1</div>
                            <div class="info-label">Version</div>
                        </div>
                    </div>
                    <div class="system-info-item">
                        <i class="bi bi-hdd-network"></i>
                        <div>
                            <div class="info-value">@_uptime</div>
                            <div class="info-label">Uptime</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═════════════ COCKPIT LAYOUT (sidebar modules + contenu) ═════════════ -->
    <div class="cockpit-layout">

        <!-- Navigation modules (gauche) -->
        <aside class="modules-nav">
            <div class="modules-nav-header">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                <span>MODULES</span>
            </div>

            @foreach (var module in _modules)
            {
                <button class="module-btn @(_activeModule == module.Id ? "active" : "")"
                        @onclick="() => SelectModule(module.Id)"
                        style="--module-color: @module.Color; --module-glow: @module.GlowColor;">
                    <div class="module-icon">
                        <i class="bi @module.Icon"></i>
                    </div>
                    <div class="module-text">
                        <div class="module-name">@module.Name</div>
                        <div class="module-desc">@module.Description</div>
                    </div>
                    <div class="module-arrow">
                        <i class="bi bi-chevron-right"></i>
                    </div>
                    @if (module.HasUpdate)
                    {
                        <span class="module-dot"></span>
                    }
                </button>
            }
        </aside>

        <!-- Panneau de contenu (droite) -->
        <main class="modules-content">

            @switch (_activeModule)
            {
                case "appearance":
                    <div class="module-panel" @key="@_activeModule">
                        <div class="panel-header" style="--accent: #A855F7;">
                            <div class="panel-icon">
                                <i class="bi bi-palette-fill"></i>
                            </div>
                            <div>
                                <h2 class="panel-title">Apparence</h2>
                                <p class="panel-subtitle">Personnalisez l'interface utilisateur</p>
                            </div>
                            <div class="panel-badge">3 options</div>
                        </div>

                        <div class="settings-list">
                            <SettingRow Icon="bi-moon-stars-fill"
                                       IconColor="#8B5CF6"
                                       Title="Mode sombre"
                                       Description="Active le thème sombre pour réduire la fatigue oculaire"
                                       Type="toggle"
                                       Value="@_darkMode"
                                       OnChange="(bool v) => _darkMode = v" />

                            <SettingRow Icon="bi-arrows-collapse"
                                       IconColor="#A855F7"
                                       Title="Densité d'affichage"
                                       Description="Espacement entre les éléments de l'interface"
                                       Type="select"
                                       Options="@(new[] { "Compacte", "Confortable", "Spacieuse" })"
                                       SelectedOption="@_density"
                                       OnSelectChange="(string v) => _density = v" />

                            <SettingRow Icon="bi-magic"
                                       IconColor="#C084FC"
                                       Title="Animations"
                                       Description="Activer les transitions et animations de l'interface"
                                       Type="toggle"
                                       Value="@_animations"
                                       OnChange="(bool v) => _animations = v" />
                        </div>
                    </div>
                    break;

                case "notifications":
                    <div class="module-panel" @key="@_activeModule">
                        <div class="panel-header" style="--accent: #F59E0B;">
                            <div class="panel-icon">
                                <i class="bi bi-bell-fill"></i>
                            </div>
                            <div>
                                <h2 class="panel-title">Notifications</h2>
                                <p class="panel-subtitle">Gérez les alertes et notifications</p>
                            </div>
                            <div class="panel-badge">4 options</div>
                        </div>

                        <div class="settings-list">
                            <SettingRow Icon="bi-envelope-fill"
                                       IconColor="#F59E0B"
                                       Title="Notifications email"
                                       Description="Recevoir des notifications par email pour les événements importants"
                                       Type="toggle"
                                       Value="@_emailNotif"
                                       OnChange="(bool v) => _emailNotif = v" />

                            <SettingRow Icon="bi-broadcast"
                                       IconColor="#FBBF24"
                                       Title="Notifications in-app"
                                       Description="Afficher les notifications dans l'application"
                                       Type="toggle"
                                       Value="@_inAppNotif"
                                       OnChange="(bool v) => _inAppNotif = v" />

                            <SettingRow Icon="bi-exclamation-triangle-fill"
                                       IconColor="#EF4444"
                                       Title="Alertes critiques"
                                       Description="Recevoir les alertes pour les actes en attente urgente"
                                       Type="toggle"
                                       Value="@_criticalAlerts"
                                       OnChange="(bool v) => _criticalAlerts = v" />

                            <SettingRow Icon="bi-clock-history"
                                       IconColor="#F97316"
                                       Title="Fréquence des résumés"
                                       Description="Période d'envoi du résumé d'activité par email"
                                       Type="select"
                                       Options="@(new[] { "Quotidien", "Hebdomadaire", "Mensuel", "Jamais" })"
                                       SelectedOption="@_summaryFreq"
                                       OnSelectChange="(string v) => _summaryFreq = v" />
                        </div>
                    </div>
                    break;

                case "security":
                    <div class="module-panel" @key="@_activeModule">
                        <div class="panel-header" style="--accent: #EF4444;">
                            <div class="panel-icon">
                                <i class="bi bi-shield-shaded"></i>
                            </div>
                            <div>
                                <h2 class="panel-title">Sécurité</h2>
                                <p class="panel-subtitle">Authentification et accès</p>
                            </div>
                            <div class="panel-badge alert">CRITIQUE</div>
                        </div>

                        <div class="settings-list">
                            <SettingRow Icon="bi-key-fill"
                                       IconColor="#DC2626"
                                       Title="Authentification 2FA"
                                       Description="Forcer la 2FA pour tous les administrateurs"
                                       Type="toggle"
                                       Value="@_twoFA"
                                       OnChange="(bool v) => _twoFA = v" />

                            <SettingRow Icon="bi-hourglass-split"
                                       IconColor="#F87171"
                                       Title="Durée de session (minutes)"
                                       Description="Déconnexion automatique après inactivité"
                                       Type="select"
                                       Options="@(new[] { "15 min", "30 min", "60 min", "2 heures", "Jamais" })"
                                       SelectedOption="@_sessionDuration"
                                       OnSelectChange="(string v) => _sessionDuration = v" />

                            <SettingRow Icon="bi-incognito"
                                       IconColor="#991B1B"
                                       Title="Politique de mot de passe"
                                       Description="Minimum 12 caractères, majuscule, chiffre et symbole"
                                       Type="select"
                                       Options="@(new[] { "Standard", "Renforcée", "Maximum" })"
                                       SelectedOption="@_passwordPolicy"
                                       OnSelectChange="(string v) => _passwordPolicy = v" />

                            <SettingRow Icon="bi-shield-lock-fill"
                                       IconColor="#7F1D1D"
                                       Title="Verrouillage après échecs"
                                       Description="Nombre de tentatives échouées avant verrouillage"
                                       Type="select"
                                       Options="@(new[] { "3 tentatives", "5 tentatives", "10 tentatives" })"
                                       SelectedOption="@_lockoutAttempts"
                                       OnSelectChange="(string v) => _lockoutAttempts = v" />

                            <SettingRow Icon="bi-list-check"
                                       IconColor="#DC2626"
                                       Title="Audit log détaillé"
                                       Description="Enregistrer toutes les actions des utilisateurs"
                                       Type="toggle"
                                       Value="@_auditLog"
                                       OnChange="(bool v) => _auditLog = v" />
                        </div>
                    </div>
                    break;

                case "workflow":
                    <div class="module-panel" @key="@_activeModule">
                        <div class="panel-header" style="--accent: #10B981;">
                            <div class="panel-icon">
                                <i class="bi bi-diagram-3-fill"></i>
                            </div>
                            <div>
                                <h2 class="panel-title">Configuration métier</h2>
                                <p class="panel-subtitle">Workflow des actes et archivage</p>
                            </div>
                            <div class="panel-badge">4 options</div>
                        </div>

                        <div class="settings-list">
                            <SettingRow Icon="bi-arrow-right-circle-fill"
                                       IconColor="#10B981"
                                       Title="Validation automatique"
                                       Description="Validation auto des actes après X jours"
                                       Type="toggle"
                                       Value="@_autoValidation"
                                       OnChange="(bool v) => _autoValidation = v" />

                            <SettingRow Icon="bi-archive-fill"
                                       IconColor="#059669"
                                       Title="Archivage automatique"
                                       Description="Archiver automatiquement les actes signés"
                                       Type="select"
                                       Options="@(new[] { "Immédiat", "Après 7 jours", "Après 30 jours", "Manuel" })"
                                       SelectedOption="@_autoArchive"
                                       OnSelectChange="(string v) => _autoArchive = v" />

                            <SettingRow Icon="bi-clock-fill"
                                       IconColor="#34D399"
                                       Title="Délai de relance"
                                       Description="Rappel automatique des actes en attente"
                                       Type="select"
                                       Options="@(new[] { "1 jour", "3 jours", "7 jours", "Désactivé" })"
                                       SelectedOption="@_reminderDelay"
                                       OnSelectChange="(string v) => _reminderDelay = v" />

                            <SettingRow Icon="bi-file-earmark-pdf-fill"
                                       IconColor="#047857"
                                       Title="Format PDF par défaut"
                                       Description="Qualité de génération des PDFs officiels"
                                       Type="select"
                                       Options="@(new[] { "Standard", "Haute qualité", "Archive (PDF/A)" })"
                                       SelectedOption="@_pdfFormat"
                                       OnSelectChange="(string v) => _pdfFormat = v" />
                        </div>
                    </div>
                    break;

                case "data":
                    <div class="module-panel" @key="@_activeModule">
                        <div class="panel-header" style="--accent: #06B6D4;">
                            <div class="panel-icon">
                                <i class="bi bi-database-fill-gear"></i>
                            </div>
                            <div>
                                <h2 class="panel-title">Données & Backup</h2>
                                <p class="panel-subtitle">Sauvegarde et exports</p>
                            </div>
                            <div class="panel-badge">3 options</div>
                        </div>

                        <div class="settings-list">
                            <SettingRow Icon="bi-cloud-arrow-up-fill"
                                       IconColor="#06B6D4"
                                       Title="Sauvegarde automatique"
                                       Description="Backup quotidien de la base de données"
                                       Type="toggle"
                                       Value="@_autoBackup"
                                       OnChange="(bool v) => _autoBackup = v" />

                            <SettingRow Icon="bi-calendar-week"
                                       IconColor="#0891B2"
                                       Title="Rétention des backups"
                                       Description="Durée de conservation des sauvegardes"
                                       Type="select"
                                       Options="@(new[] { "7 jours", "30 jours", "90 jours", "1 an" })"
                                       SelectedOption="@_backupRetention"
                                       OnSelectChange="(string v) => _backupRetention = v" />

                            <SettingRow Icon="bi-trash3-fill"
                                       IconColor="#0E7490"
                                       Title="Purge des logs"
                                       Description="Suppression automatique des anciens logs d'audit"
                                       Type="select"
                                       Options="@(new[] { "Jamais", "Après 1 an", "Après 2 ans", "Après 5 ans" })"
                                       SelectedOption="@_logPurge"
                                       OnSelectChange="(string v) => _logPurge = v" />
                        </div>

                        <!-- Actions spéciales -->
                        <div class="actions-zone">
                            <h3 class="actions-title">
                                <i class="bi bi-lightning-charge-fill"></i>
                                Actions immédiates
                            </h3>
                            <div class="action-btns-grid">
                                <button class="action-btn-special btn-backup" @onclick="TriggerBackup">
                                    <i class="bi bi-cloud-download-fill"></i>
                                    <span>Backup maintenant</span>
                                </button>
                                <button class="action-btn-special btn-export" @onclick="ExportData">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                    <span>Exporter données</span>
                                </button>
                                <button class="action-btn-special btn-danger" @onclick="ConfirmPurge">
                                    <i class="bi bi-exclamation-octagon-fill"></i>
                                    <span>Purger les logs</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    break;

                case "system":
                    <div class="module-panel" @key="@_activeModule">
                        <div class="panel-header" style="--accent: #EC4899;">
                            <div class="panel-icon">
                                <i class="bi bi-gear-wide-connected"></i>
                            </div>
                            <div>
                                <h2 class="panel-title">Système</h2>
                                <p class="panel-subtitle">Informations et maintenance</p>
                            </div>
                            <div class="panel-badge">Lecture seule</div>
                        </div>

                        <!-- Dashboard infos système -->
                        <div class="system-grid">
                            <div class="system-card sys-version">
                                <div class="sys-icon"><i class="bi bi-tag-fill"></i></div>
                                <div class="sys-content">
                                    <div class="sys-label">Version actuelle</div>
                                    <div class="sys-value">2.4.1</div>
                                    <div class="sys-sub">Build 2026.06.15</div>
                                </div>
                            </div>

                            <div class="system-card sys-uptime">
                                <div class="sys-icon"><i class="bi bi-stopwatch-fill"></i></div>
                                <div class="sys-content">
                                    <div class="sys-label">Uptime serveur</div>
                                    <div class="sys-value">@_uptime</div>
                                    <div class="sys-sub">99.98% dispo.</div>
                                </div>
                            </div>

                            <div class="system-card sys-db">
                                <div class="sys-icon"><i class="bi bi-database-fill"></i></div>
                                <div class="sys-content">
                                    <div class="sys-label">Base de données</div>
                                    <div class="sys-value">PostgreSQL 16</div>
                                    <div class="sys-sub">Healthy · 2.4 GB</div>
                                </div>
                            </div>

                            <div class="system-card sys-cache">
                                <div class="sys-icon"><i class="bi bi-lightning-fill"></i></div>
                                <div class="sys-content">
                                    <div class="sys-label">Cache</div>
                                    <div class="sys-value">Redis</div>
                                    <div class="sys-sub">Actif · 12 MB</div>
                                </div>
                            </div>

                            <div class="system-card sys-users">
                                <div class="sys-icon"><i class="bi bi-people-fill"></i></div>
                                <div class="sys-content">
                                    <div class="sys-label">Sessions actives</div>
                                    <div class="sys-value">7</div>
                                    <div class="sys-sub">Sur 15 connectés</div>
                                </div>
                            </div>

                            <div class="system-card sys-storage">
                                <div class="sys-icon"><i class="bi bi-hdd-fill"></i></div>
                                <div class="sys-content">
                                    <div class="sys-label">Stockage</div>
                                    <div class="sys-value">42%</div>
                                    <div class="sys-sub">8.4 / 20 GB</div>
                                    <div class="sys-progress">
                                        <div class="sys-progress-bar" style="width: 42%;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Actions système -->
                        <div class="actions-zone">
                            <h3 class="actions-title">
                                <i class="bi bi-tools"></i>
                                Maintenance
                            </h3>
                            <div class="action-btns-grid">
                                <button class="action-btn-special btn-info" @onclick="ClearCache">
                                    <i class="bi bi-arrow-clockwise"></i>
                                    <span>Vider le cache</span>
                                </button>
                                <button class="action-btn-special btn-warning" @onclick="RestartServices">
                                    <i class="bi bi-power"></i>
                                    <span>Redémarrer services</span>
                                </button>
                                <button class="action-btn-special btn-info" @onclick="DownloadLogs">
                                    <i class="bi bi-download"></i>
                                    <span>Télécharger logs</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    break;
            }

            <!-- Footer save bar -->
            <div class="save-bar">
                <div class="save-bar-info">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>Les modifications sont enregistrées automatiquement</span>
                </div>
                <button class="save-all-btn" @onclick="SaveAllSettings">
                    <i class="bi bi-check2-all"></i>
                    <span>Tout sauvegarder</span>
                </button>
            </div>

        </main>

    </div>
</div>

@code {
    // ═══════ MODULES ═══════
    private record ModuleInfo(string Id, string Name, string Description, string Icon, string Color, string GlowColor, bool HasUpdate);

    private List<ModuleInfo> _modules = new()
{
    new("appearance",    "Apparence",        "Thème et interface",         "bi-palette-fill",          "#0E7C5C", "rgba(14, 124, 92, 0.25)",  false),
    new("notifications", "Notifications",    "Alertes et emails",          "bi-bell-fill",             "#D97706", "rgba(217, 119, 6, 0.25)",  true),
    new("security",      "Sécurité",         "2FA et accès",               "bi-shield-shaded",         "#9B1C2D", "rgba(155, 28, 45, 0.25)",  true),
    new("workflow",      "Configuration",    "Workflow des actes",         "bi-diagram-3-fill",        "#14A574", "rgba(20, 165, 116, 0.25)",  false),
    new("data",          "Données",          "Backup et exports",          "bi-database-fill-gear",    "#0369A1", "rgba(3, 105, 161, 0.25)",   false),
    new("system",        "Système",          "Infos et maintenance",       "bi-gear-wide-connected",   "#6D28D9", "rgba(109, 40, 217, 0.25)",  false)
};

    private string _activeModule = "appearance";
    private string _uptime = "14j 7h";

    // ═══════ APPARENCE ═══════
    private bool _darkMode = false;
    private string _density = "Confortable";
    private bool _animations = true;

    // ═══════ NOTIFICATIONS ═══════
    private bool _emailNotif = true;
    private bool _inAppNotif = true;
    private bool _criticalAlerts = true;
    private string _summaryFreq = "Hebdomadaire";

    // ═══════ SÉCURITÉ ═══════
    private bool _twoFA = false;
    private string _sessionDuration = "60 min";
    private string _passwordPolicy = "Renforcée";
    private string _lockoutAttempts = "5 tentatives";
    private bool _auditLog = true;

    // ═══════ WORKFLOW ═══════
    private bool _autoValidation = false;
    private string _autoArchive = "Après 7 jours";
    private string _reminderDelay = "3 jours";
    private string _pdfFormat = "Haute qualité";

    // ═══════ DONNÉES ═══════
    private bool _autoBackup = true;
    private string _backupRetention = "30 jours";
    private string _logPurge = "Après 2 ans";

    private void SelectModule(string moduleId)
    {
        _activeModule = moduleId;
    }

    private void SaveAllSettings()
    {
        Snackbar.Add("Tous les paramètres ont été sauvegardés", Severity.Success);
    }

    private async Task TriggerBackup()
    {
        var ok = await DialogService.ShowMessageBox(
            "Lancer un backup ?",
            "Une sauvegarde complète de la base de données va être créée.",
            yesText: "Lancer",
            cancelText: "Annuler");

        if (ok == true)
        {
            Snackbar.Add("Backup en cours...", Severity.Info);
        }
    }

    private void ExportData()
    {
        Snackbar.Add("Export des données lancé", Severity.Info);
    }

    private async Task ConfirmPurge()
    {
        var ok = await DialogService.ShowMessageBox(
            "Purger les logs ?",
            "Cette action est irréversible. Les logs anciens seront définitivement supprimés.",
            yesText: "Purger",
            cancelText: "Annuler");

        if (ok == true)
        {
            Snackbar.Add("Purge des logs terminée", Severity.Success);
        }
    }

    private void ClearCache()
    {
        Snackbar.Add("Cache vidé avec succès", Severity.Success);
    }

    private async Task RestartServices()
    {
        var ok = await DialogService.ShowMessageBox(
            "Redémarrer les services ?",
            "Les services seront indisponibles pendant quelques secondes.",
            yesText: "Redémarrer",
            cancelText: "Annuler");

        if (ok == true)
        {
            Snackbar.Add("Services redémarrés", Severity.Success);
        }
    }

    private void DownloadLogs()
    {
        Snackbar.Add("Téléchargement des logs en cours...", Severity.Info);
    }
}


<style>
    /* ════════════════════════════════════════════════
               PARAMÈTRES — DESIGN ÉPURÉ VERT BOA
               Sobre, professionnel, cohérent dashboard
               ════════════════════════════════════════════════ */
    .settings-cockpit {
        display: flex;
        flex-direction: column;
        gap: 24px;
        padding: 8px;
        background: radial-gradient(900px 600px at 80% 10%, rgba(20, 165, 116, 0.06), transparent 60%), radial-gradient(700px 500px at 20% 90%, rgba(252, 211, 77, 0.04), transparent 60%), linear-gradient(180deg, #F7FBF9 0%, #ECFDF5 100%);
        min-height: 100vh;
    }

    /* ═══════════ HEADER VERT BOA ÉPURÉ ═══════════ */
    .cockpit-hero {
        background: radial-gradient(800px 400px at 90% 20%, rgba(252, 211, 77, 0.15), transparent 60%), radial-gradient(600px 300px at 20% 80%, rgba(20, 165, 116, 0.18), transparent 65%), linear-gradient(135deg, #0A2922 0%, #0E7C5C 60%, #14A574 100%);
        padding: 32px 36px;
        border-radius: 20px;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(252, 211, 77, 0.15);
        box-shadow: 0 16px 48px rgba(10, 41, 34, 0.25), inset 0 1px 0 rgba(252, 211, 77, 0.15);
    }

    /* Grille très subtile */
    .cyber-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(252, 211, 77, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(252, 211, 77, 0.04) 1px, transparent 1px);
        background-size: 60px 60px;
        pointer-events: none;
        mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
    }

    /* Orbes subtils (très atténués) */
    .cyber-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        animation: float-orb 12s ease-in-out infinite;
    }

    .cyber-orb-1 {
        width: 240px;
        height: 240px;
        background: radial-gradient(circle, #14A574, transparent);
        top: -60px;
        right: 10%;
        opacity: 0.25;
    }

    .cyber-orb-2 {
        width: 280px;
        height: 280px;
        background: radial-gradient(circle, #FCD34D, transparent);
        bottom: -80px;
        left: 5%;
        opacity: 0.15;
        animation-delay: 3s;
    }

