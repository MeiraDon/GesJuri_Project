@page "/profile"
@attribute [Authorize]
@rendermode InteractiveServer

@using GesCPSI_Project.Models
@using GesCPSI_Project.Interfaces
@using Microsoft.AspNetCore.Components.Authorization

@inject IProfile ProfileService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Mon profil - GesCPSI</PageTitle>

<div class="profile-page">

    <!-- ═════════════ HEADER ═════════════ -->
    <div class="profile-header">
        <div class="header-left">
            <div class="header-sticker sticker-primary">
                <i class="bi bi-person-fill"></i>
            </div>
            <div>
                <div class="header-title">Mon profil</div>
                <div class="header-subtitle">Gérez vos informations et votre sécurité</div>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-zone">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_profile is null)
    {
        <div class="empty-zone">
            <MudText Color="Color.Error">Profil introuvable</MudText>
        </div>
    }
    else
    {
        <!-- ═════════════ ROW 1 : INFOS + SÉCURITÉ ═════════════ -->
        <div class="profile-row">

            <!-- INFOS PERSONNELLES -->
            <div class="profile-card profile-info-card">
                <div class="card-head">
                    <div class="card-sticker sticker-primary">
                        <i class="bi bi-person-vcard-fill"></i>
                    </div>
                    <span class="card-title">Informations personnelles</span>
                </div>
                <div class="card-body">

                    <div class="avatar-block">
                        <div class="avatar-big">@GetInitials()</div>
                        <div class="avatar-info">
                            <div class="avatar-name">@(_profile.NomComplet ?? _profile.Email)</div>
                            <div class="avatar-role">@_profile.RoleLabel</div>
                        </div>
                    </div>

                    @if (!_editMode)
                    {
                        <!-- Mode VIEW -->
                        <div class="info-list">
                            <div class="info-row">
                                <div class="info-sticker sticker-email">
                                    <i class="bi bi-envelope-fill"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Email</div>
                                    <div class="info-value">@_profile.Email</div>
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-sticker sticker-phone">
                                    <i class="bi bi-telephone-fill"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Téléphone</div>
                                    <div class="info-value">@(string.IsNullOrWhiteSpace(_profile.Telephone) ? "Non renseigné" : _profile.Telephone)</div>
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-sticker sticker-name">
                                    <i class="bi bi-person-badge-fill"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Nom</div>
                                    <div class="info-value">@(string.IsNullOrWhiteSpace(_profile.Nom) ? "Non renseigné" : _profile.Nom)</div>
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-sticker sticker-name">
                                    <i class="bi bi-person-lines-fill"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Prénoms</div>
                                    <div class="info-value">@(string.IsNullOrWhiteSpace(_profile.Prenoms) ? "Non renseigné" : _profile.Prenoms)</div>
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-sticker sticker-date">
                                    <i class="bi bi-calendar-event-fill"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Membre depuis</div>
                                    <div class="info-value">@_profile.DateCreation.ToLocalTime().ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</div>
                                </div>
                            </div>
                        </div>

                        <div class="card-actions">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="EnterEditMode">
                                Modifier mes informations
                            </MudButton>
                        </div>
                    }
                    else
                    {
                        <!-- Mode EDIT -->
                        <div class="edit-form">

                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                                L'email ne peut pas être modifié. Contactez un administrateur pour cela.
                            </MudAlert>

                            <MudTextField @bind-Value="_editInput.Nom"
                                          Label="Nom de famille"
                                          HelperText="Ex: KOUASSI"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true"
                                          Class="mb-3" />

                            <MudTextField @bind-Value="_editInput.Prenoms"
                                          Label="Prénoms"
                                          HelperText="Ex: Jean Pierre"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true"
                                          Class="mb-3" />

                            <MudTextField @bind-Value="_editInput.Telephone"
                                          Label="Téléphone"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true"
                                          HelperText="Ex: +228 99 12 34 56" />

                            <div class="card-actions mt-3">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Default"
                                           OnClick="CancelEdit"
                                           Disabled="@_saving">
                                    Annuler
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           OnClick="SaveProfile"
                                           Disabled="@_saving">
                                    @if (_saving)
                                    {
                                        <span>Enregistrement...</span>
                                    }
                                    else
                                    {
                                        <span>Enregistrer</span>
                                    }
                                </MudButton>
                            </div>
                        </div>
                    }

                </div>
            </div>

            <!-- SÉCURITÉ -->
            <div class="profile-card profile-security-card">
                <div class="card-head">
                    <div class="card-sticker sticker-security">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <span class="card-title">Sécurité</span>
                </div>
                <div class="card-body">

                    <div class="info-list">
                        <div class="info-row">
                            <div class="info-sticker sticker-date">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Dernière connexion</div>
                                <div class="info-value">
                                    @if (_profile.DerniereConnexion.HasValue)
                                    {
                                        <span>@_profile.DerniereConnexion.Value.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span>Première connexion</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="info-row">
                            <div class="info-sticker sticker-status">
                                <i class="bi bi-shield-fill-check"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Statut du compte</div>
                                <div class="info-value">
                                    @if (_profile.IsActive)
                                    {
                                        <span class="status-active">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Actif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-inactive">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Désactivé
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="info-row">
                            <div class="info-sticker sticker-role">
                                <i class="bi bi-person-fill-gear"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Rôle</div>
                                <div class="info-value">@_profile.RoleLabel</div>
                            </div>
                        </div>
                    </div>

                    <div class="security-actions">
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                            Pour votre sécurité, changez régulièrement votre mot de passe.
                        </MudAlert>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Lock"
                                   OnClick="GoToChangePassword"
                                   FullWidth="true">
                            Changer mon mot de passe
                        </MudButton>
                    </div>

                </div>
            </div>

        </div>

        <!-- ═════════════ STATS D'ACTIVITÉ ═════════════ -->
        <div class="profile-card stats-card">
            <div class="card-head">
                <div class="card-sticker sticker-stats">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
                <span class="card-title">Mon activité</span>
            </div>
            <div class="card-body">

                @if (_isAgent)
                {
                    <!-- Stats Agent -->
                    <div class="stats-grid">
                        <div class="stat-mini stat-mini-total">
                            <div class="mini-sticker">
                                <i class="bi bi-file-earmark-plus-fill"></i>
                            </div>
                            <div class="mini-value">@_stats.ActesCrees</div>
                            <div class="mini-label">Actes créés</div>
                        </div>
                        <div class="stat-mini stat-mini-valid">
                            <div class="mini-sticker">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div class="mini-value">@_stats.ActesValides</div>
                            <div class="mini-label">Validés</div>
                        </div>
                        <div class="stat-mini stat-mini-pending">
                            <div class="mini-sticker">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div class="mini-value">@_stats.ActesEnAttente</div>
                            <div class="mini-label">En attente</div>
                        </div>
                        <div class="stat-mini stat-mini-reject">
                            <div class="mini-sticker">
                                <i class="bi bi-x-circle-fill"></i>
                            </div>
                            <div class="mini-value">@_stats.ActesRejetes</div>
                            <div class="mini-label">Rejetés</div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Stats Responsable/Admin -->
                    <div class="stats-grid">
                        <div class="stat-mini stat-mini-valid">
                            <div class="mini-sticker">
                                <i class="bi bi-patch-check-fill"></i>
                            </div>
                            <div class="mini-value">@_stats.ActesValidesParMoi</div>
                            <div class="mini-label">Validés par moi</div>
                        </div>
                        <div class="stat-mini stat-mini-reject">
                            <div class="mini-sticker">
                                <i class="bi bi-x-octagon-fill"></i>
                            </div>
                            <div class="mini-value">@_stats.ActesRejetesParMoi</div>
                            <div class="mini-label">Rejetés par moi</div>
                        </div>
                        <div class="stat-mini stat-mini-total">
                            <div class="mini-sticker">
                                <i class="bi bi-pencil-square"></i>
                            </div>
                            <div class="mini-value">@_stats.ActesCrees</div>
                            <div class="mini-label">Créés par moi</div>
                        </div>
                        <div class="stat-mini stat-mini-pending">
                            <div class="mini-sticker">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div class="mini-value">@_stats.ActesEnAttente</div>
                            <div class="mini-label">En attente</div>
                        </div>
                    </div>
                }

                @if (_stats.LastActionDate.HasValue)
                {
                    <div class="last-action-block">
                        <div class="last-action-label">Dernière action</div>
                        <div class="last-action-content">
                            <strong>@_stats.LastActionLabel</strong>
                            @if (_stats.LastActionActeId.HasValue)
                            {
                                <span> sur l'acte <strong>#@_stats.LastActionActeId</strong></span>
                            }
                            <span class="last-action-time">@FormatRelative(_stats.LastActionDate.Value)</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

</div>

@code {
    private ProfileDto? _profile;
    private ProfileStats _stats = new();
    private ProfileUpdateInput _editInput = new();

    private bool _loading = true;
    private bool _editMode = false;
    private bool _saving = false;
    private bool _isAgent = false;
    private int? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        await IdentifyCurrentUserAsync();
        await LoadProfileAsync();
    }

    private async Task IdentifyCurrentUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var nameIdentifier = user.Claims.FirstOrDefault(c => c.Type.Contains("nameidentifier"))?.Value;
        if (int.TryParse(nameIdentifier, out var id))
        {
            _currentUserId = id;
        }

        _isAgent = user.IsInRole(RoleNames.Agent)
                   && !user.IsInRole(RoleNames.Admin)
                   && !user.IsInRole(RoleNames.Responsable);
    }

    private async Task LoadProfileAsync()
    {
        if (_currentUserId is null)
        {
            _loading = false;
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            _profile = await ProfileService.GetProfileAsync(_currentUserId.Value);

            if (_profile != null)
            {
                _stats = await ProfileService.GetStatsAsync(_currentUserId.Value, _profile.Role);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur chargement profil : {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void EnterEditMode()
    {
        if (_profile is null) return;

        _editInput = new ProfileUpdateInput
            {
                Nom = _profile.Nom,
                Prenoms = _profile.Prenoms,
                Telephone = _profile.Telephone
            };

        _editMode = true;
    }

    private void CancelEdit()
    {
        _editMode = false;
        _editInput = new ProfileUpdateInput();
    }

    private async Task SaveProfile()
    {
        if (_currentUserId is null || _saving) return;

        _saving = true;
        StateHasChanged();

        try
        {
            var result = await ProfileService.UpdateProfileAsync(_currentUserId.Value, _editInput);

            if (!result.Success)
            {
                Snackbar.Add(result.ErrorMessage ?? "Erreur lors de la mise à jour.", Severity.Error);
                return;
            }

            Snackbar.Add("Profil mis à jour avec succès.", Severity.Success);
            _editMode = false;

            // Recharger le profil
            await LoadProfileAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private void GoToChangePassword()
    {
        Navigation.NavigateTo("/change-password", forceLoad: true);
    }

    private string GetInitials()
    {
        if (_profile is null) return "U";

        if (!string.IsNullOrWhiteSpace(_profile.NomComplet))
        {
            var parts = _profile.NomComplet.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
            {
                return (parts[0][..1] + parts[1][..1]).ToUpper();
            }
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
        }

        if (!string.IsNullOrWhiteSpace(_profile.Email))
        {
            return _profile.Email[..Math.Min(2, _profile.Email.Length)].ToUpper();
        }

        return "U";
    }

    private string FormatRelative(DateTime date)
    {
        var diff = DateTime.UtcNow - date;

        if (diff.TotalDays >= 1)
        {
            return $"il y a {(int)diff.TotalDays} jour{(diff.TotalDays >= 2 ? "s" : "")}";
        }
        if (diff.TotalHours >= 1)
        {
            return $"il y a {(int)diff.TotalHours} heure{(diff.TotalHours >= 2 ? "s" : "")}";
        }
        if (diff.TotalMinutes >= 1)
        {
            return $"il y a {(int)diff.TotalMinutes} min";
        }
        return "à l'instant";
    }
}

<style>
    /* ════════════════════════════════════════════════
           STICKERS UNIFIÉS — Cohérence Bootstrap Icons
           ════════════════════════════════════════════════ */

    /* === Sticker générique === */
    .header-sticker,
    .card-sticker,
    .info-sticker,
    .mini-sticker {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        flex-shrink: 0;
        position: relative;
        overflow: hidden;
        transition: all 0.25s ease;
    }

        /* Effet brillance au coin (façon sticker) */
        .header-sticker::before,
        .card-sticker::before,
        .info-sticker::before,
        .mini-sticker::before {
            content: '';
            position: absolute;
            top: 8%;
            left: 12%;
            width: 28%;
            height: 22%;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            filter: blur(4px);
            pointer-events: none;
        }

    /* === Tailles === */
    .header-sticker {
        width: 56px;
        height: 56px;
        font-size: 1.6rem;
    }

    .card-sticker {
        width: 38px;
        height: 38px;
        font-size: 1.1rem;
    }

    .info-sticker {
        width: 36px;
        height: 36px;
        font-size: 1rem;
    }

    .mini-sticker {
        width: 40px;
        height: 40px;
        font-size: 1.15rem;
        margin: 0 auto 8px auto;
    }

    /* === Couleurs sémantiques (palette BOA) === */
    .sticker-primary {
        background: linear-gradient(135deg, #0E7C5C, #14A574);
        color: white;
        box-shadow: 0 4px 14px rgba(14, 124, 92, 0.4), inset 0 -2px 4px rgba(0,0,0,0.15);
    }

    .sticker-security {
        background: linear-gradient(135deg, #9B1C2D, #DC2626);
        color: white;
        box-shadow: 0 4px 14px rgba(155, 28, 45, 0.4), inset 0 -2px 4px rgba(0,0,0,0.15);
    }

    .sticker-stats {
        background: linear-gradient(135deg, #FCD34D, #F59E0B);
        color: white;
        box-shadow: 0 4px 14px rgba(252, 211, 77, 0.5), inset 0 -2px 4px rgba(0,0,0,0.15);
    }

    .sticker-email {
        background: linear-gradient(135deg, #3B82F6, #1E40AF);
        color: white;
        box-shadow: 0 3px 10px rgba(59, 130, 246, 0.4);
    }

    .sticker-phone {
        background: linear-gradient(135deg, #14A574, #0E7C5C);
        color: white;
        box-shadow: 0 3px 10px rgba(20, 165, 116, 0.4);
    }

    .sticker-name {
        background: linear-gradient(135deg, #A78BFA, #7C3AED);
        color: white;
        box-shadow: 0 3px 10px rgba(124, 58, 237, 0.4);
    }

    .sticker-date {
        background: linear-gradient(135deg, #F59E0B, #D97706);
        color: white;
        box-shadow: 0 3px 10px rgba(245, 158, 11, 0.4);
    }

    .sticker-status {
        background: linear-gradient(135deg, #06B6D4, #0891B2);
        color: white;
        box-shadow: 0 3px 10px rgba(6, 182, 212, 0.4);
    }

    .sticker-role {
        background: linear-gradient(135deg, #EC4899, #BE185D);
        color: white;
        box-shadow: 0 3px 10px rgba(236, 72, 153, 0.4);
    }

    /* === Mini stickers (stats grid) — fond pâle, icône colorée === */
    .stat-mini-total .mini-sticker {
        background: linear-gradient(135deg, #EEF2FF, #DDD6FE);
        color: #4338CA;
    }

    .stat-mini-valid .mini-sticker {
        background: linear-gradient(135deg, #ECFDF5, #BBF7D0);
        color: #047857;
    }

    .stat-mini-pending .mini-sticker {
        background: linear-gradient(135deg, #FEF3C7, #FCD34D);
        color: #92400E;
    }

    .stat-mini-reject .mini-sticker {
        background: linear-gradient(135deg, #FEF2F2, #FECACA);
        color: #9B1C2D;
    }

    /* === Hover effects === */
    .info-row:hover .info-sticker,
    .stat-mini:hover .mini-sticker {
        transform: rotate(-6deg) scale(1.08);
    }

    .card-head .card-sticker:hover {
        transform: rotate(5deg) scale(1.05);
    }

    /* === Statuts dans le texte (Actif/Désactivé) === */
    .status-active {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #047857;
        font-weight: 700;
        background: linear-gradient(135deg, #ECFDF5, #DCFCE7);
        padding: 4px 12px;
        border-radius: 10px;
        border: 1px solid #BBF7D0;
    }

        .status-active i {
            color: #14A574;
        }

    .status-inactive {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #9B1C2D;
        font-weight: 700;
        background: linear-gradient(135deg, #FEF2F2, #FEE2E2);
        padding: 4px 12px;
        border-radius: 10px;
        border: 1px solid #FECACA;
    }

        .status-inactive i {
            color: #DC2626;
        }
</style>