        align-items: center;
        gap: 14px;
        border-bottom: 1px solid #BBF7D0;
    }

    .kpi-grid-preview {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        padding: 22px 24px;
    }

    .kpi-preview {
        padding: 18px;
        border-radius: 12px;
        text-align: center;
        position: relative;
        overflow: hidden;
        border: 1.5px solid;
    }

    .kpi-preview-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

