@page "/rapports"
@attribute [Authorize]
@rendermode InteractiveServer

@using GesCPSI_Project.Models
@using GesCPSI_Project.Interfaces
@using Microsoft.AspNetCore.Components.Authorization

@inject IRapportService RapportService
@inject IDashboard DashboardService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Rapports — GesCPSI</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <div class="rapports-page">

        <!-- ═════════════ HEADER VERT BOA + BORDEAUX ═════════════ -->
        <MudPaper Class="rapports-hero" Elevation="0">
            <div class="hero-bg-deco"></div>
            <div class="hero-content">
                <div class="hero-main">
                    <div class="hero-icon-wrap">
                        <i class="bi bi-file-earmark-bar-graph-fill"></i>
                    </div>
                    <div class="hero-text">
                        <h1 class="hero-title">Rapports d'activité</h1>
                        <p class="hero-meta">
                            <span class="meta-strong">Direction Juridique</span>
                            <span class="meta-sep">·</span>
                            <span>analyse et synthèse</span>
                            <span class="meta-sep">·</span>
                            <span class="meta-boa">
                                <i class="bi bi-shield-fill-check"></i>
                                @_roleLabel
                            </span>
                        </p>
                    </div>
                </div>

                <div class="hero-actions">
                    <MudTooltip Text="Réinitialiser les filtres">
                        <button class="hero-btn-icon" @onclick="ResetFilters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </MudTooltip>
                    <button class="hero-btn-primary" @onclick="GenerateReport" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span>Génération...</span>
                        }
                        else
                        {
                            <i class="bi bi-play-fill"></i>
                            <span>Générer le rapport</span>
                        }
                    </button>
                </div>
            </div>
        </MudPaper>

        <!-- ═════════════ FILTRES PÉRIODE ═════════════ -->
        <div class="filter-card">
            <div class="filter-card-header">
                <div class="filter-icon">
                    <i class="bi bi-calendar-range-fill"></i>
                </div>
                <div class="filter-text">
                    <div class="filter-title">Période d'analyse</div>
                    <div class="filter-subtitle">Définissez l'intervalle pour votre rapport</div>
                </div>
            </div>

            <div class="filter-body">
                <!-- Préselections rapides -->
                <div class="preset-tabs">
                    <button class="preset-tab @(_preset == "month" ? "active" : "")" @onclick='() => ApplyPreset("month")'>
                        <i class="bi bi-calendar3"></i>
                        <span>Mois en cours</span>
                    </button>
                    <button class="preset-tab @(_preset == "lastmonth" ? "active" : "")" @onclick='() => ApplyPreset("lastmonth")'>
                        <i class="bi bi-calendar-minus"></i>
                        <span>Mois dernier</span>
                    </button>
                    <button class="preset-tab @(_preset == "quarter" ? "active" : "")" @onclick='() => ApplyPreset("quarter")'>
                        <i class="bi bi-calendar-week"></i>
                        <span>Ce trimestre</span>
                    </button>
                    <button class="preset-tab @(_preset == "year" ? "active" : "")" @onclick='() => ApplyPreset("year")'>
                        <i class="bi bi-calendar4"></i>
                        <span>Cette année</span>
                    </button>
                    <button class="preset-tab @(_preset == "custom" ? "active" : "")" @onclick='() => _preset = "custom"'>
                        <i class="bi bi-sliders"></i>
                        <span>Personnalisé</span>
                    </button>
                </div>

                <!-- Dates -->
                <div class="date-inputs">
                    <div class="date-input-wrap">
                        <label class="date-label">Date de début</label>
                        <input type="date" class="date-input" @bind="_dateDebut" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="date-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                    <div class="date-input-wrap">
                        <label class="date-label">Date de fin</label>
                        <input type="date" class="date-input" @bind="_dateFin" @bind:format="yyyy-MM-dd" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ═════════════ APERÇU DES KPI (après génération) ═════════════ -->
        @if (_rapport != null)
        {
            <div class="kpi-preview-card">
                <div class="kpi-preview-header">
                    <div class="filter-icon icon-success">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="filter-text">
                        <div class="filter-title">Aperçu du rapport</div>
                        <div class="filter-subtitle">
                            Du @_rapport.DateDebut.ToString("dd MMM yyyy") au @_rapport.DateFin.ToString("dd MMM yyyy")
                            · <strong>@_rapport.Total acte@(_rapport.Total > 1 ? "s" : "")</strong> au total
                        </div>
                    </div>
                </div>

                <div class="kpi-grid-preview">
                    <div class="kpi-preview kpi-total">
                        <div class="kpi-preview-label">Total</div>
                        <div class="kpi-preview-value">@_rapport.Total</div>
                    </div>
                    <div class="kpi-preview kpi-valid">
                        <div class="kpi-preview-label">Validés</div>
                        <div class="kpi-preview-value">@_rapport.Valides</div>
                        <div class="kpi-preview-pct">@_rapport.TauxValidation%</div>
                    </div>
                    <div class="kpi-preview kpi-pending">
                        <div class="kpi-preview-label">En attente</div>
                        <div class="kpi-preview-value">@_rapport.EnAttente</div>
                    </div>
                    <div class="kpi-preview kpi-rejected">
                        <div class="kpi-preview-label">Rejetés</div>
                        <div class="kpi-preview-value">@_rapport.Rejetes</div>
                        <div class="kpi-preview-pct">@_rapport.TauxRejet%</div>
                    </div>
                </div>

                <!-- ═════════════ EXPORTS ═════════════ -->
                <div class="exports-section">
                    <div class="exports-title">
                        <i class="bi bi-download"></i>
                        <span>Télécharger le rapport</span>
                    </div>
                    <div class="exports-buttons">
                        <button class="export-btn export-pdf" @onclick="DownloadPdf" disabled="@_isExporting">
                            <div class="export-icon"><i class="bi bi-file-earmark-pdf-fill"></i></div>
                            <div class="export-info">
                                <div class="export-name">PDF</div>
                                <div class="export-desc">Rapport imprimable</div>
                            </div>
                        </button>
                        <button class="export-btn export-excel" @onclick="DownloadExcel" disabled="@_isExporting">
                            <div class="export-icon"><i class="bi bi-file-earmark-excel-fill"></i></div>
                            <div class="export-info">
                                <div class="export-name">Excel</div>
                                <div class="export-desc">Tableau analysable</div>
                            </div>
                        </button>
                        <button class="export-btn export-word" @onclick="DownloadWord" disabled="@_isExporting">
                            <div class="export-icon"><i class="bi bi-file-earmark-word-fill"></i></div>
                            <div class="export-info">
                                <div class="export-name">Word</div>
                                <div class="export-desc">Document éditable</div>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        }
        else if (!_isLoading)
        {
            <!-- État initial : aucun rapport généré -->
            <div class="empty-state-rapport">
                <div class="empty-icon">
                    <i class="bi bi-clipboard-data"></i>
                </div>
                <div class="empty-title">Aucun rapport généré</div>
                <div class="empty-subtitle">
                    Sélectionnez une période et cliquez sur <strong>« Générer le rapport »</strong> pour commencer
                </div>
            </div>
        }

    </div>
</MudContainer>

@code {
    private DateTime _dateDebut = DateTime.Today.AddDays(-DateTime.Today.Day + 1);
    private DateTime _dateFin = DateTime.Today;
    private string _preset = "month";
    private bool _isLoading;
    private bool _isExporting;

    private RapportActiviteDto? _rapport;
    private int? _currentUserId;
    private string _userRole = "";
    private string _userEmail = "";
    private string _roleLabel = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userEmail = user.Identity.Name ?? "";
            var nameIdentifier = user.Claims.FirstOrDefault(c => c.Type.Contains("nameidentifier"))?.Value;
            if (int.TryParse(nameIdentifier, out var id))
                _currentUserId = id;

            if (user.IsInRole(RoleNames.Admin)) { _userRole = RoleNames.Admin; _roleLabel = "Administrateur"; }
            else if (user.IsInRole(RoleNames.Responsable)) { _userRole = RoleNames.Responsable; _roleLabel = "Responsable Juridique"; }
            else if (user.IsInRole(RoleNames.Agent)) { _userRole = RoleNames.Agent; _roleLabel = "Agent Juridique"; }
        }

        ApplyPreset("month");
    }

    private void ApplyPreset(string preset)
    {
        _preset = preset;
        var today = DateTime.Today;

        switch (preset)
        {
            case "month":
                _dateDebut = new DateTime(today.Year, today.Month, 1);
                _dateFin = today;
                break;
            case "lastmonth":
                var lastMonth = today.AddMonths(-1);
                _dateDebut = new DateTime(lastMonth.Year, lastMonth.Month, 1);
                _dateFin = new DateTime(today.Year, today.Month, 1).AddDays(-1);
                break;
            case "quarter":
                var quarterStart = new DateTime(today.Year, ((today.Month - 1) / 3) * 3 + 1, 1);
                _dateDebut = quarterStart;
                _dateFin = today;
                break;
            case "year":
                _dateDebut = new DateTime(today.Year, 1, 1);
                _dateFin = today;
                break;
        }
    }

    private void ResetFilters()
    {
        _rapport = null;
        ApplyPreset("month");
    }

    private async Task GenerateReport()
    {
        if (_dateDebut > _dateFin)
        {
            Snackbar.Add("La date de début doit être antérieure à la date de fin.", Severity.Warning);
            return;
        }

        _isLoading = true;
        try
        {
            var restrictId = _userRole == RoleNames.Agent ? _currentUserId : null;
            _rapport = await RapportService.GenerateActivityReportAsync(
                _dateDebut, _dateFin, _userRole, restrictId, _userEmail);

            Snackbar.Add($"Rapport généré : {_rapport.Total} actes analysés.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DownloadPdf()
    {
        if (_rapport == null) return;
        _isExporting = true;
        try
        {
            var bytes = await RapportService.ExportToPdfAsync(_rapport);
            await DownloadFile(bytes, $"rapport-activite-{DateTime.Now:yyyyMMdd-HHmmss}.pdf", "application/pdf");
            Snackbar.Add("Rapport PDF téléchargé.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur PDF : {ex.Message}", Severity.Error);
        }
        finally { _isExporting = false; }
    }

    private async Task DownloadExcel()
    {
        if (_rapport == null) return;
        _isExporting = true;
        try
        {
            var bytes = await RapportService.ExportToExcelAsync(_rapport);
            await DownloadFile(bytes, $"rapport-activite-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Snackbar.Add("Rapport Excel téléchargé.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur Excel : {ex.Message}", Severity.Error);
        }
        finally { _isExporting = false; }
    }

    private async Task DownloadWord()
    {
        if (_rapport == null) return;
        _isExporting = true;
        try
        {
            var bytes = await RapportService.ExportToWordAsync(_rapport);
            await DownloadFile(bytes, $"rapport-activite-{DateTime.Now:yyyyMMdd-HHmmss}.docx",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document");
            Snackbar.Add("Rapport Word téléchargé.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur Word : {ex.Message}", Severity.Error);
        }
        finally { _isExporting = false; }
    }

    private async Task DownloadFile(byte[] bytes, string fileName, string mimeType)
    {
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, base64, mimeType);
    }
}

<style>
