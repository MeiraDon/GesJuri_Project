@page "/saisirPage/{IdAjout:int}"
@rendermode InteractiveServer

<PageTitle>Saisie</PageTitle>

@using MudBlazor
@using GesCPSI_Project.Models
@using GesCPSI_Project.Interfaces
@using GesCPSI_Project.Services
@using Microsoft.AspNetCore.Components.Forms
@using GesCPSI_Project.Components.Shared
@using GesCPSI_Project.ViewModels
@using Microsoft.AspNetCore.Components.Authorization


@inject IClientAct ClientActService
@inject ITypesAct TypesActService
@inject IAjoutAct AjoutActService
@inject IRolesClientAct RolesClientActService
@inject IClient ClientService
@inject ICautionnement CautionnementService
@inject IPret PretService
@inject ICharge ChargeService
@inject IAutorisation AutorisationService
@inject IEntiteJur EntiteJurService
@inject IUser UserService
@inject IBanque BanqueService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IActeWorkflow WorkflowService
@inject AuthenticationStateProvider AuthStateProvider

<div class="saisie-shell" lang="fr">

    <!-- ═══════════════ TOP BAR ═══════════════ -->
    <header class="saisie-topbar">
        <div class="topbar-left">
            <button class="btn-back-circle" @onclick="OnBack" disabled="@(step == WizardStep.Participants && isBusy)" title="Retour">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div>
                <div class="topbar-title">@(ajoutAct?.NomAct ?? "Nouvel acte")</div>
                <div class="topbar-subtitle">@GetStepLabel(step) • Étape @((int)step + 1) sur 7</div>
            </div>
        </div>
        <div class="topbar-right">
            <div class="topbar-progress-pill">
                <div class="progress-pill-fill" style="width: @(GetProgressPercent())%;"></div>
                <span class="progress-pill-text">@GetProgressPercent()%</span>
            </div>
        </div>
    </header>

    <!-- ═══════════════ STEPPER HORIZONTAL ═══════════════ -->
    <div class="stepper-horizontal">
        @{
            var steps = new[]
            {
        new { Step = WizardStep.Participants, Icon = "people-fill", Label = "Participants" },
        new { Step = WizardStep.Cautionnement, Icon = "shield-shaded", Label = "Cautionnement" },
        new { Step = WizardStep.Pret, Icon = "cash-stack", Label = "Prêt" },
        new { Step = WizardStep.Autorisation, Icon = "card-checklist", Label = "Autorisation" },
        new { Step = WizardStep.Charge, Icon = "receipt-cutoff", Label = "Charges" },
        new { Step = WizardStep.EntiteJuridique, Icon = "building-check", Label = "Entité Jur." },
        new { Step = WizardStep.Recap, Icon = "check2-circle", Label = "Récap" }
        };
        }

        <div class="stepper-line"></div>
        <div class="stepper-line-progress" style="width: calc(@(((int)step / 6.0) * 100)% - 24px);"></div>

        @foreach (var s in steps)
        {
            var stepIndex = (int)s.Step;
            var currentIndex = (int)step;
            var stateClass = stepIndex < currentIndex ? "done"
            : stepIndex == currentIndex ? "current"
            : "todo";

            <div class="step-dot-container">
                <div class="step-dot step-dot-@stateClass" title="@s.Label">
                    @if (stepIndex < currentIndex)
                    {
                        <i class="bi bi-check2"></i>
                    }
                    else if (stepIndex == currentIndex)
                    {
                        <i class="bi bi-@s.Icon"></i>
                    }
                    else
                    {
                        <span>@(stepIndex + 1)</span>
                    }
                </div>
                <div class="step-dot-label @(stateClass == "current" ? "label-active" : "")">@s.Label</div>
            </div>
        }
    </div>

    <!-- ═══════════════ ZONE PRINCIPALE ═══════════════ -->
    <div class="main-content">
        <EditForm EditContext="@CurrentContext" OnSubmit="@(_ => Task.CompletedTask)">
            <DataAnnotationsValidator />

            @* =================== PARTICIPANTS =================== *@
            @if (step == WizardStep.Participants)
            {
                <div class="content-card" @key="@WizardStep.Participants">
                    <div class="content-card-header">
                        <div class="content-card-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <div class="content-card-title">Participants</div>
                            <div class="content-card-subtitle">Choisissez ou créez les personnes (Débiteur, Caution, Témoins)</div>
                        </div>
                    </div>

                    <div class="participants-grid">
                        <div class="participant-cell">
                            @RenderParticipantCard(ParticipantRole.Debiteur, "Débiteur", "bi bi-person")
                        </div>
                        <div class="participant-cell">
                            @RenderParticipantCard(ParticipantRole.Caution, "Caution", "bi bi-person-lock")
                        </div>
                        @if (showTemoins)
                        {
                            <div class="participant-cell">
                                @RenderParticipantCard(ParticipantRole.Temoin1, "Témoin 1", "bi bi-person-check")
                            </div>
                            <div class="participant-cell">
                                @RenderParticipantCard(ParticipantRole.Temoin2, "Témoin 2", "bi bi-person-check")
                            </div>
                        }
                    </div>

                    <div class="tip-banner">
                        <i class="bi bi-lightbulb-fill"></i>
                        <span>Recherchez par <strong>nom</strong>, <strong>téléphone</strong> ou <strong>pièce</strong> (Type + Numéro)</span>
                    </div>
                </div>
            }

            @* =================== CAUTIONNEMENT =================== *@
            @if (step == WizardStep.Cautionnement)
            {
                <div class="content-card" @key="@WizardStep.Cautionnement">
                    <div class="content-card-header">
                        <div class="content-card-icon">
                            <i class="bi bi-shield-shaded"></i>
                        </div>
                        <div>
                            <div class="content-card-title">Cautionnement</div>
                            <div class="content-card-subtitle">Informations juridiques de l'acte de cautionnement</div>
                        </div>
                    </div>
                    <CascadingValue Value="cautionnementContext" IsFixed="true">
                        <GesCPSI_Project.Components.Forms.CautionnementForm Cautionnement="@model.Cautionnement" />
                    </CascadingValue>
                </div>
            }

            @* =================== PRET =================== *@
            @if (step == WizardStep.Pret)
            {
                <div class="content-card" @key="@WizardStep.Pret">
                    <div class="content-card-header">
                        <div class="content-card-icon">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                        <div>
                            <div class="content-card-title">Prêt</div>
                            <div class="content-card-subtitle">Informations sur le prêt bancaire</div>
                        </div>
                    </div>
                    <CascadingValue Value="pretContext" IsFixed="true">
                        <GesCPSI_Project.Components.Forms.PretForm Pret="@model.Pret" />
                    </CascadingValue>
                </div>
            }

            @* =================== AUTORISATION =================== *@
            @if (step == WizardStep.Autorisation)
            {
                <div class="content-card" @key="@WizardStep.Autorisation">
                    <div class="content-card-header">
                        <div class="content-card-icon">
                            <i class="bi bi-card-checklist"></i>
                        </div>
                        <div>
                            <div class="content-card-title">Autorisation de débit</div>
                            <div class="content-card-subtitle">Autorisation de prélèvement bancaire</div>
                        </div>
                    </div>
                    <CascadingValue Value="autorisationContext" IsFixed="true">
                        <GesCPSI_Project.Components.Forms.AutorisationForm Autorisation="@model.Autorisation" />
                    </CascadingValue>
                </div>
            }

            @* =================== CHARGE =================== *@
            @if (step == WizardStep.Charge)
            {
                <div class="content-card" @key="@WizardStep.Charge">
                    <div class="content-card-header">
                        <div class="content-card-icon">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>
                        <div>
                            <div class="content-card-title">Charges</div>
                            <div class="content-card-subtitle">Frais et taxes associés à l'acte</div>
                        </div>
                    </div>
                    <CascadingValue Value="chargeContext" IsFixed="true">
                        <GesCPSI_Project.Components.Forms.ChargeForm Charge="@model.Charge" />
                    </CascadingValue>
                </div>
            }

            @* =================== ENTITE JURIDIQUE =================== *@
            @if (step == WizardStep.EntiteJuridique)
            {
                <div class="content-card" @key="@WizardStep.EntiteJuridique">
                    <div class="content-card-header">
                        <div class="content-card-icon">
                            <i class="bi bi-building-check"></i>
                        </div>
                        <div>
                            <div class="content-card-title">Entité juridique</div>
                            <div class="content-card-subtitle">Informations sur l'officier public</div>
                        </div>
                    </div>
                    <CascadingValue Value="entiteJurContext" IsFixed="true">
                        <GesCPSI_Project.Components.Forms.EntiteJurForm EntiteJuridique="@model.EntiteJuridique" />
                    </CascadingValue>
                </div>
            }

            @* =================== RECAP =================== *@
            @* =================== RECAP =================== *@
            @if (step == WizardStep.Recap)
            {
                <div class="content-card recap-card" @key="@WizardStep.Recap">

                    <div class="content-card-header">
                        <div class="content-card-icon recap-icon">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                        <div>
                            <div class="content-card-title">Récapitulatif final</div>
                            <div class="content-card-subtitle">Vérifiez toutes les informations avant de valider l'acte</div>
                        </div>
                    </div>

                    <ValidationSummary />

                    @* ═══════════ BANDEAU RÉSUMÉ EXÉCUTIF ═══════════ *@
                    <div class="executive-summary">
                        <div class="exec-bg-deco"></div>
                        <div class="exec-content">
                            <div class="exec-left">
                                <div class="exec-label">Montant cautionnement</div>
                                <div class="exec-amount">@model.Cautionnement.MontantCautionne.ToString("N0")</div>
                                <div class="exec-currency">FCFA</div>
                            </div>
                            <div class="exec-divider"></div>
                            <div class="exec-right">
                                <div class="exec-info-item">
                                    <i class="bi bi-file-earmark-text-fill"></i>
                                    <div>
                                        <div class="exec-info-label">Type d'acte</div>
                                        <div class="exec-info-value">@(ajoutAct?.NomAct ?? "Cautionnement")</div>
                                    </div>
                                </div>
                                <div class="exec-info-item">
                                    <i class="bi bi-bank2"></i>
                                    <div>
                                        <div class="exec-info-label">Banque</div>
                                        <div class="exec-info-value">@(boaBank?.SigleBnq ?? "BOA-TOGO")</div>
                                    </div>
                                </div>
                                <div class="exec-info-item">
                                    <i class="bi bi-hash"></i>
                                    <div>
                                        <div class="exec-info-label">N° Acte</div>
                                        <div class="exec-info-value">#@(currentActeId ?? ActeId ?? 0)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ═══════════ PARTICIPANTS ═══════════ *@
                    <div class="recap-block">
                        <div class="recap-block-header">
                            <div class="recap-block-icon recap-icon-participants">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="recap-block-title">Participants</div>
                            <div class="recap-block-count">
                                @{
                                    var nbParticipants = participants.Count(p => p.Value.Selected is not null);
                                }
                                @nbParticipants assigné@(nbParticipants > 1 ? "s" : "")
                            </div>
                        </div>

                        <div class="participants-recap-modern">
                            @RenderParticipantRecapModern("Débiteur", "bi bi-person-fill", "debiteur", participants[ParticipantRole.Debiteur])
                            @RenderParticipantRecapModern("Caution", "bi bi-person-lock", "caution", participants[ParticipantRole.Caution])
                            @if (showTemoins)
                            {
                                @RenderParticipantRecapModern("Témoin 1", "bi bi-person-check", "temoin1", participants[ParticipantRole.Temoin1])
                                @RenderParticipantRecapModern("Témoin 2", "bi bi-person-check", "temoin2", participants[ParticipantRole.Temoin2])
                            }
                        </div>
                    </div>

                    @* ═══════════ GRID 2 COLONNES ═══════════ *@
                    <div class="recap-grid-modern">

                        <!-- Cautionnement -->
                        <div class="recap-block">
                            <div class="recap-block-header">
                                <div class="recap-block-icon recap-icon-caution">
                                    <i class="bi bi-shield-shaded"></i>
                                </div>
                                <div class="recap-block-title">Cautionnement</div>
                            </div>
                            <div class="recap-block-body">
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-hash"></i> N° cautionnement</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.Cautionnement.NumeroCautionmt) ? "—" : model.Cautionnement.NumeroCautionmt)</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-cash-coin"></i> Montant</span>
                                    <span class="recap-row-val recap-money">@model.Cautionnement.MontantCautionne.ToString("N0") FCFA</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-pen"></i> Date signature</span>
                                    <span class="recap-row-val">@model.Cautionnement.DateSignatureCautionmt.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-x-circle"></i> Date expiration</span>
                                    <span class="recap-row-val">@model.Cautionnement.DateExpirationCautionmt.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-geo-alt"></i> Lieu</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.Cautionnement.LieuSignatureCautionmt) ? "—" : model.Cautionnement.LieuSignatureCautionmt)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Prêt -->
                        <div class="recap-block">
                            <div class="recap-block-header">
                                <div class="recap-block-icon recap-icon-pret">
                                    <i class="bi bi-cash-stack"></i>
                                </div>
                                <div class="recap-block-title">Prêt</div>
                            </div>
                            <div class="recap-block-body">
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-hash"></i> Référence</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.Pret.ReferenceConvention) ? "—" : model.Pret.ReferenceConvention)</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-cash-coin"></i> Montant</span>
                                    <span class="recap-row-val recap-money">@model.Pret.MontantConcours.ToString("N0") FCFA</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-percent"></i> Taux</span>
                                    <span class="recap-row-val">@model.Pret.Taux %</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-hourglass-split"></i> Durée</span>
                                    <span class="recap-row-val">@model.Pret.DureMoisPret mois</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-pen"></i> Date signature</span>
                                    <span class="recap-row-val">@model.Pret.DateSignaturePret.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Autorisation -->
                        <div class="recap-block">
                            <div class="recap-block-header">
                                <div class="recap-block-icon recap-icon-auto">
                                    <i class="bi bi-card-checklist"></i>
                                </div>
                                <div class="recap-block-title">Autorisation de débit</div>
                            </div>
                            <div class="recap-block-body">
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-hash"></i> Numéro</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.Autorisation.NumeroAutorisation) ? "—" : model.Autorisation.NumeroAutorisation)</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-cash-coin"></i> Plafond</span>
                                    <span class="recap-row-val recap-money">@model.Autorisation.MontantMaxAutorise.ToString("N0") FCFA</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-calendar-event"></i> Date</span>
                                    <span class="recap-row-val">@model.Autorisation.DateAutorisation.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-geo-alt"></i> Lieu</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.Autorisation.LieuAutorisation) ? "—" : model.Autorisation.LieuAutorisation)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Charges -->
                        <div class="recap-block">
                            <div class="recap-block-header">
                                <div class="recap-block-icon recap-icon-charge">
                                    <i class="bi bi-receipt-cutoff"></i>
                                </div>
                                <div class="recap-block-title">Charges</div>
                            </div>
                            <div class="recap-block-body">
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-tag"></i> Type</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.Charge.TypeCharge) ? "—" : model.Charge.TypeCharge)</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-cash-coin"></i> Montant</span>
                                    <span class="recap-row-val recap-money">@model.Charge.MontantCharge.ToString("N0") FCFA</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-person-circle"></i> Payé par</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.Charge.PayePar) ? "—" : model.Charge.PayePar)</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-circle-fill"></i> Statut</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.Charge.StatutCharge) ? "—" : model.Charge.StatutCharge)</span>
                                </div>
                            </div>
                        </div>

                    </div>

                    @* ═══════════ ENTITÉ JURIDIQUE — PLEINE LARGEUR ═══════════ *@
                    <div class="recap-block recap-block-full">
                        <div class="recap-block-header">
                            <div class="recap-block-icon recap-icon-entite">
                                <i class="bi bi-building-check"></i>
                            </div>
                            <div class="recap-block-title">Entité juridique</div>
                        </div>
                        <div class="recap-block-body">
                            <div class="recap-entite-grid">
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-calendar-event"></i> Date acte</span>
                                    <span class="recap-row-val">@model.EntiteJuridique.DateActeJuridique.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-hash"></i> Référence</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.EntiteJuridique.Reference) ? "—" : model.EntiteJuridique.Reference)</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-person-badge"></i> Huissier</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.EntiteJuridique.NomHuissier) ? "—" : model.EntiteJuridique.NomHuissier)</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-geo-alt"></i> Ville</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.EntiteJuridique.VilleHuissier) ? "—" : model.EntiteJuridique.VilleHuissier)</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-folder-fill"></i> N° dossier</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.EntiteJuridique.NumeroDossier) ? "—" : model.EntiteJuridique.NumeroDossier)</span>
                                </div>
                                <div class="recap-row">
                                    <span class="recap-row-key"><i class="bi bi-person-fill"></i> Responsable</span>
                                    <span class="recap-row-val">@(string.IsNullOrEmpty(model.EntiteJuridique.Responsable) ? "—" : model.EntiteJuridique.Responsable)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ═══════════ DISCLAIMER FINAL ═══════════ *@
                    <div class="recap-disclaimer">
                        <div class="disclaimer-icon">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <div class="disclaimer-content">
                            <div class="disclaimer-title">
                                <i class="bi bi-exclamation-circle-fill"></i>
                                Étape importante : Validation finale
                            </div>
                            <div class="disclaimer-text">
                                En cliquant sur <strong>"Valider l'acte"</strong>, vous confirmez que toutes les informations sont correctes
                                et complètes.
                                <br /><br />
                                <i class="bi bi-info-circle-fill text-warning"></i>
                                <strong>Important :</strong> Ce n'est qu'après cette validation que vous pourrez
                                <strong>envoyer l'acte au responsable juridique</strong> depuis la liste des actes.
                                <br /><br />
                                <i class="bi bi-bookmark-check-fill text-success"></i>
                                Vous pourrez toujours retrouver cet acte dans <strong>la liste des actes</strong>, prêt à être envoyé.
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(successMessage))
                    {
                        <div class="alert-banner alert-success">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@successMessage</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert-banner alert-error">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@errorMessage</span>
                        </div>
                    }
                </div>
            }
        </EditForm>
    </div>

    <!-- ═══════════════ FOOTER STICKY ═══════════════ -->
    <footer class="saisie-footer">
        <div class="footer-info">
            @if (currentActeId.HasValue || ActeId.HasValue)
            {
                <div class="footer-tag">
                    <span class="footer-tag-emoji">📌</span>
                    <span>Acte #@(currentActeId ?? ActeId ?? 0)</span>
                </div>
            }
            <div class="footer-tag footer-tag-bank">
                <span class="footer-tag-emoji">🏦</span>
                <span>@(boaBank?.SigleBnq ?? "BOA-TOGO")</span>
            </div>
        </div>

        <div class="footer-actions">
            <button class="btn-action btn-secondary" @onclick="OnReset" disabled="@isBusy" title="Réinitialiser tout">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span class="btn-text-hide-mobile">Réinitialiser</span>
            </button>

            <button class="btn-action btn-ghost" @onclick="OnBack" disabled="@(step == WizardStep.Participants || isBusy)">
                <i class="bi bi-arrow-left"></i>
                <span>Précédent</span>
            </button>

            @if (step != WizardStep.Recap)
            {
