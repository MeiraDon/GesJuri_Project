private static string DisplayClientName(ClientModel c)
{
    // Personne morale : raison sociale + représentant (si dispo)
    if (!string.IsNullOrWhiteSpace(c.NomRaisonsociale))
    {
        var rep = string.IsNullOrWhiteSpace(c.NomRepresentant) ? "" : $" — Rep: {c.NomRepresentant}";
        return $"{c.NomRaisonsociale}{rep}";
    }

    // Personne physique
    return $"{c.Nom} {c.Prenoms}".Trim();
}


    private static string GetClientInitials(ClientModel? c)
    {
        if (c is null) return "?";

        // Personne morale : initiales de la raison sociale
        if (!string.IsNullOrWhiteSpace(c.NomRaisonsociale))
        {
            var parts = c.NomRaisonsociale.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2) return (parts[0][..1] + parts[1][..1]).ToUpper();
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
        }

        // Personne physique : N (Nom) + P (Prénom)
        var nom = (c.Nom ?? "").Trim();
        var pre = (c.Prenoms ?? "").Trim();

        var initials = "";
        if (nom.Length > 0) initials += nom[0];
        if (pre.Length > 0) initials += pre[0];

        return string.IsNullOrEmpty(initials) ? "?" : initials.ToUpper();
    }


    // ═════════ AUTO-SEARCH ET MENU CRÉER ═════════

private ParticipantRole? _openCreateMenu = null;
private System.Threading.CancellationTokenSource? _searchCts;

private void ToggleCreateMenu(ParticipantRole role)
{
    _openCreateMenu = _openCreateMenu == role ? null : role;
}

private async Task OnSearchInputAsync(ParticipantRole role, string value)
{
    participants[role].Search = value;
    _openCreateMenu = null; // Ferme le menu créer si ouvert

    // Annule la recherche précédente si l'utilisateur tape encore
    _searchCts?.Cancel();
    _searchCts = new System.Threading.CancellationTokenSource();
    var token = _searchCts.Token;

    try
    {
        // Debounce 300ms : attend que l'utilisateur arrête de taper
        await Task.Delay(300, token);

        if (token.IsCancellationRequested) return;

        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
        {
            participants[role].Results.Clear();
            participants[role].InfoMessage = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await SearchClientsAsync(role);
        await InvokeAsync(StateHasChanged);
    }
    catch (TaskCanceledException)
    {
        // Normal — l'utilisateur a continué de taper
    }
}

// =================== PARTICIPANTS ACTIONS ===================

    private void ClearParticipant(ParticipantRole role)
    {
        var clientLibere = participants[role].ClientId;

        participants[role].ClientId = null;
        participants[role].Selected = null;
        participants[role].Results.Clear();
        participants[role].InfoMessage = null;
        participants[role].Search = "";

        // 🆕 INFO : si l'utilisateur avait des recherches en cours sur d'autres rôles,
        // ils retrouveront automatiquement ce client dans leurs résultats lors de la prochaine recherche
        if (clientLibere.HasValue)
        {
            Snackbar.Add(
                "Participant désassigné. Ce client est à nouveau disponible pour les autres rôles.",
                Severity.Info);
        }
    }

    private async Task SearchClientsAsync(ParticipantRole role)
    {
        var ps = participants[role];
        ps.InfoMessage = null;
        ps.Results.Clear();

        var q = (ps.Search ?? "").Trim();
        if (string.IsNullOrWhiteSpace(q) || q.Length < 2)
        {
            ps.InfoMessage = "Saisissez au moins 2 caractères.";
            return;
        }

        try
        {
            ps.IsSearching = true;

            var all = await ClientService.GetAllAsync() ?? new List<ClientModel>();
            var qq = q.ToLowerInvariant();

            // 🆕 RÈGLE D'UNICITÉ : récupérer les IDs des clients déjà sélectionnés
            // dans LES AUTRES rôles (pas celui qu'on est en train de modifier)
            var clientsDejaUtilises = participants
                .Where(kvp => kvp.Key != role && kvp.Value.ClientId.HasValue)
                .Select(kvp => kvp.Value.ClientId!.Value)
                .ToHashSet();

            ps.Results = all
                .Where(c => !clientsDejaUtilises.Contains(c.IdClt))  // 🆕 Exclure les clients déjà utilisés
                .Where(c =>
                    (DisplayClientName(c).ToLowerInvariant().Contains(qq)) ||
                    (!string.IsNullOrWhiteSpace(c.TelCel) && c.TelCel.ToLowerInvariant().Contains(qq)) ||
                    (!string.IsNullOrWhiteSpace(c.TelBur) && c.TelBur.ToLowerInvariant().Contains(qq)) ||
                    (!string.IsNullOrWhiteSpace(c.TypePieceID) && c.TypePieceID.ToLowerInvariant().Contains(qq)) ||
                    (!string.IsNullOrWhiteSpace(c.NumPieceID) && c.NumPieceID.ToLowerInvariant().Contains(qq))
                )
                .OrderBy(c => DisplayClientName(c))
                .ToList();

            if (ps.Results.Count == 0)
            {
                // Message plus précis : on indique pourquoi rien n'apparaît
                var matchesAvantFiltre = all.Count(c =>
                    (DisplayClientName(c).ToLowerInvariant().Contains(qq)) ||
                    (!string.IsNullOrWhiteSpace(c.TelCel) && c.TelCel.ToLowerInvariant().Contains(qq)) ||
                    (!string.IsNullOrWhiteSpace(c.NumPieceID) && c.NumPieceID.ToLowerInvariant().Contains(qq))
                );

                if (matchesAvantFiltre > 0 && clientsDejaUtilises.Count > 0)
                {
                    ps.InfoMessage = "Aucun résultat disponible : les clients correspondants sont déjà assignés à d'autres rôles dans cet acte.";
                }
                else
                {
                    ps.InfoMessage = "Client introuvable.";
                }
            }
        }
        catch (Exception ex)
        {
            ps.InfoMessage = $"Erreur recherche: {ex.Message}";
        }
        finally
        {
            ps.IsSearching = false;
        }
    }

    private void SelectClient(ParticipantRole role, ClientModel client)
    {
        // SÉCURITÉ DOUBLE : vérifier que ce client n'est pas déjà assigné à un autre rôle
        var rolesDejaUtilises = participants
            .Where(kvp => kvp.Key != role
                       && kvp.Value.ClientId == client.IdClt)
            .Select(kvp => GetRoleLabel(kvp.Key))
            .ToList();

        if (rolesDejaUtilises.Any())
        {
            // Cas extrême : si le client apparaît malgré le filtre (concurrence, cache, etc.)
            Snackbar.Add(
                $"⚠️ {DisplayClientName(client)} est déjà assigné comme {string.Join(" et ", rolesDejaUtilises)} dans cet acte.",
                Severity.Warning);
            return;
        }

        participants[role].Selected = client;
        participants[role].ClientId = client.IdClt;
        participants[role].Results.Clear();
        participants[role].InfoMessage = null;

        // Vider aussi la recherche pour que ce soit propre
        participants[role].Search = "";

        // Forcer le rafraîchissement de TOUTES les autres recherches actives
        // (au cas où l'utilisateur avait déjà des résultats affichés dans d'autres cartes)
        foreach (var otherRole in participants.Keys.ToList())
        {
            if (otherRole != role && participants[otherRole].Selected is null
                && participants[otherRole].Results.Any())
            {
                // Retirer le client fraîchement sélectionné des résultats des autres cartes
                participants[otherRole].Results.RemoveAll(c => c.IdClt == client.IdClt);

                // Si après filtrage il ne reste plus de résultats, afficher un message
                if (!participants[otherRole].Results.Any()
                    && !string.IsNullOrWhiteSpace(participants[otherRole].Search))
                {
                    participants[otherRole].InfoMessage =
                        "Aucun résultat disponible : le ou les clients ont été assignés à d'autres rôles.";
                }
            }
        }
    }

private async Task OpenCreateClientDialogAsync(ParticipantRole role)
{
    // Tu peux garder ce code : il suppose un composant dialog réutilisable.
    // Exemple attendu: ClientCreateDialog.razor (un seul formulaire client) avec paramètres:
    // - Title
    // - RoleLabel (préselection)
    // - OnSaved: EventCallback<ClientModel>
    try
    {
        var roleLabel = GetRoleLabel(role);

        var parameters = new DialogParameters
        {
            ["RoleLabel"] = roleLabel
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<GesCPSI_Project.Components.Dialogs.ClientCreateDialog>($"Créer un client – {roleLabel}", parameters, options);
        var result = await dialog.Result;

        // sécurité null
        if (result is null || result.Canceled)
            return;

        if (!result.Canceled && result.Data is ClientModel created)
        {
            SelectClient(role, created);

            // Bonus: si on a déjà un acte brouillon, on peut sauvegarder l'association immédiatement
            if (currentActeId.HasValue || ActeId.HasValue)
            {
                await EnsureActeAsync();

                if (!currentActeId.HasValue)
                    throw new InvalidOperationException("Acte non initialisé après EnsureActeAsync().");

                await UpsertClientActeAsync(currentActeId.Value, role, created.IdClt);
                Snackbar.Add($"Client créé et assigné ({roleLabel}).", Severity.Success);
            }
        }
    }
    catch (Exception ex)
    {
        Snackbar.Add($"Erreur dialog création client: {ex.Message}", Severity.Error);
    }
}

